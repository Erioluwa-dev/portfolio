---
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import CommandPalette from '../components/CommandPalette.astro';

interface Props {
  title: string;
  description?: string;
  /** The home page is a full-bleed book: no page column, no footer. */
  book?: boolean;
}

const {
  title,
  book = false,
  description = 'Fawehinmi Erioluwa — product engineer in Lagos, Nigeria. Interfaces, backends, and applied machine learning, built to hold up under real constraints.',
} = Astro.props;

const path = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="google-site-verification" content="JoL1Mp3FLXTw0iYSRy2iOkyWAgvPPLRN5t0UW0kzQco" />
    <meta name="google-site-verification" content="S7Ug6gdObw3K4vs20UcGJlSy9GNNL9xwu-sbcgFXymY" />
    <link rel="icon" type="image/jpeg" href="/brand.jpg" />
    <link rel="apple-touch-icon" href="/brand.jpg" />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,100..900&family=Kalam&family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;1,6..72,400&display=swap"
    />

    <title>{title}</title>

    <script is:inline>
      // Set the theme before first paint so the page never flashes the wrong one.
      (function () {
        var saved = null;
        try { saved = localStorage.getItem('theme'); } catch (e) { saved = null; }
        var theme = saved || (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        document.documentElement.setAttribute('data-theme', theme);
      })();
    </script>
  </head>

  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <SiteHeader path={path} />
    <CommandPalette />

    <main class:list={[book ? 'book-main' : 'page']} id="main">
      <slot />
    </main>

    {!book && <SiteFooter />}
  </body>
</html>

<style is:global>
  .skip-link {
    position: absolute;
    top: -100px;
    left: var(--gutter);
    z-index: 2000;
    padding: 0.75rem 1rem;
    border-radius: var(--r-sm);
    background: var(--ink);
    color: var(--bg);
    font-weight: 600;
    text-decoration: none;
  }

  .skip-link:focus { top: 0.75rem; }
</style>
