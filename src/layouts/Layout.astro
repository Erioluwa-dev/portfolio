---
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import CommandPalette from '../components/CommandPalette.astro';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'Fawehinmi Erioluwa — product engineer in Lagos, Nigeria. Interfaces, backends, and applied machine learning, built to hold up under real constraints.',
} = Astro.props;

const path = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="google-site-verification" content="JoL1Mp3FLXTw0iYSRy2iOkyWAgvPPLRN5t0UW0kzQco" />
    <meta name="google-site-verification" content="S7Ug6gdObw3K4vs20UcGJlSy9GNNL9xwu-sbcgFXymY" />
    <link rel="icon" type="image/jpeg" href="/brand.jpg" />
    <link rel="apple-touch-icon" href="/brand.jpg" />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,100..900&family=Kalam&family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;1,6..72,400&display=swap"
    />

    <title>{title}</title>

    <script is:inline>
      // Set the theme before first paint so the page never flashes the wrong one.
      (function () {
        var saved = null;
        try { saved = localStorage.getItem('theme'); } catch (e) { saved = null; }
        var theme = saved || (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        document.documentElement.setAttribute('data-theme', theme);
      })();
    </script>
  </head>

  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <SiteHeader path={path} />
    <CommandPalette />

    <main class="page" id="main">
      <slot />
    </main>

    <SiteFooter />

    <script>
      // Widgets share two small behaviours: anything marked data-clock shows
      // the time in Lagos, and anything marked data-copy copies its value.
      const zone = 'Africa/Lagos';
      const timeFmt = new Intl.DateTimeFormat('en-GB', { timeZone: zone, hour: '2-digit', minute: '2-digit' });
      const dayFmt = new Intl.DateTimeFormat('en-GB', { timeZone: zone, weekday: 'long', day: 'numeric', month: 'long' });
      const partsFmt = new Intl.DateTimeFormat('en-GB', { timeZone: zone, hour: 'numeric', minute: 'numeric', second: 'numeric', hour12: false });

      const tick = () => {
        const now = new Date();
        const parts = Object.fromEntries(partsFmt.formatToParts(now).map((p) => [p.type, Number(p.value)]));
        const h = parts.hour % 24;
        const awake = h >= 8 && h < 24;
        document.querySelectorAll<HTMLElement>('[data-clock]').forEach((el) => {
          const kind = el.dataset.clock;
          if (kind === 'time') el.textContent = timeFmt.format(now);
          else if (kind === 'day') el.textContent = dayFmt.format(now);
          else if (kind === 'status') el.textContent = awake ? 'Probably awake' : 'Probably asleep';
          else if (kind === 'analog') {
            el.style.setProperty('--h', String((h % 12) * 30 + parts.minute * 0.5));
            el.style.setProperty('--m', String(parts.minute * 6 + parts.second * 0.1));
            el.style.setProperty('--s', String(parts.second * 6));
          }
        });
      };
      tick();
      setInterval(tick, 1000);

      document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((btn) => {
        const label = btn.querySelector('[data-copy-label]') ?? btn;
        const idle = label.textContent;
        btn.addEventListener('click', async () => {
          try {
            await navigator.clipboard.writeText(btn.dataset.copy ?? '');
            label.textContent = 'Copied';
          } catch {
            label.textContent = 'Copy failed';
          }
          setTimeout(() => { label.textContent = idle; }, 1800);
        });
      });
    </script>
  </body>
</html>

<style is:global>
  .skip-link {
    position: absolute;
    top: -100px;
    left: var(--gutter);
    z-index: 2000;
    padding: 0.75rem 1rem;
    border-radius: var(--r-sm);
    background: var(--ink);
    color: var(--bg);
    font-weight: 600;
    text-decoration: none;
  }

  .skip-link:focus { top: 0.75rem; }
</style>
