---
import '../styles/global.css';
import Island from '../components/Island.astro';
import SiteFooter from '../components/SiteFooter.astro';
import CommandPalette from '../components/CommandPalette.astro';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'Fawehinmi Erioluwa — frontend engineer in Lagos, Nigeria. Offline-first systems, computer vision, and interfaces that hold up under real constraints.',
} = Astro.props;

const path = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="google-site-verification" content="JoL1Mp3FLXTw0iYSRy2iOkyWAgvPPLRN5t0UW0kzQco" />
    <meta name="google-site-verification" content="S7Ug6gdObw3K4vs20UcGJlSy9GNNL9xwu-sbcgFXymY" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Grape+Nuts&family=Shantell+Sans:ital,wght,BNCE,INFM@0,300..800,-100..100,0..100&display=swap"
    />

    <title>{title}</title>

    <script is:inline>
      // Set the theme before first paint so the page never flashes the wrong one.
      (function () {
        var saved = localStorage.getItem('theme');
        var theme = saved || (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        document.documentElement.setAttribute('data-theme', theme);
      })();
    </script>
  </head>

  <body>
    <a class="skip-link" href="#rail">Skip to content</a>

    <Island path={path} />
    <CommandPalette />

    <div
      class="rail"
      id="rail"
      tabindex="0"
      role="region"
      aria-label="Page content — scroll sideways"
    >
      <slot />
    </div>

    <SiteFooter />
  </body>
</html>

<style is:global>
  html, body { height: 100%; }

  /* The rail owns the scrolling, so the document itself must not scroll. */
  @media (min-width: 900px) {
    body { overflow: hidden; }
  }

  .skip-link {
    position: absolute;
    top: -100px;
    left: var(--sp-3);
    z-index: 2000;
    padding: 12px 18px;
    border-radius: var(--r-pill);
    background: var(--chrome-bg);
    color: var(--chrome-fg);
    font-family: var(--body);
    font-weight: 600;
    text-decoration: none;
    transition: top 0.2s ease;
  }

  .skip-link:focus { top: var(--sp-3); }
</style>

<script>
  (function () {
    const rail = document.getElementById("rail");
    if (!rail) return;

    const wide = window.matchMedia("(min-width: 900px)");
    const panels = Array.from(rail.querySelectorAll<HTMLElement>(".panel"));

    // ── Report position so the footer can show where you are ──
    const bar = document.getElementById("rail-bar");
    const counter = document.getElementById("rail-counter");

    const report = () => {
      const travel = rail.scrollWidth - rail.clientWidth;
      const ratio = travel > 0 ? rail.scrollLeft / travel : 1;
      if (bar) bar.style.transform = `scaleX(${Math.min(1, Math.max(0.02, ratio || 0.02))})`;

      if (counter && panels.length) {
        const middle = rail.scrollLeft + rail.clientWidth / 2;
        let nearest = 0;
        let best = Infinity;
        panels.forEach((p, i) => {
          const distance = Math.abs(p.offsetLeft + p.offsetWidth / 2 - middle);
          if (distance < best) { best = distance; nearest = i; }
        });
        // At either end the rail runs out of travel before the edge panel can
        // reach the centre, so pin the count there.
        if (ratio >= 0.995) nearest = panels.length - 1;
        else if (ratio <= 0.005) nearest = 0;
        counter.textContent = `${String(nearest + 1).padStart(2, "0")} / ${String(panels.length).padStart(2, "0")}`;
      }
    };

    rail.addEventListener("scroll", report, { passive: true });
    window.addEventListener("resize", report);
    report();

    // ── Wheel: a vertical gesture drives the rail sideways ──
    rail.addEventListener(
      "wheel",
      (e) => {
        if (!wide.matches) return;
        // Leave real horizontal gestures and inner scrollers alone.
        if (Math.abs(e.deltaY) <= Math.abs(e.deltaX)) return;
        if ((e.target as HTMLElement).closest(".card-scroll")) return;
        e.preventDefault();
        rail.scrollLeft += e.deltaY;
      },
      { passive: false }
    );

    // ── Keyboard: step panel by panel ──
    const step = (dir: number) => {
      const middle = rail.scrollLeft + rail.clientWidth / 2;
      let index = 0;
      let best = Infinity;
      panels.forEach((p, i) => {
        const distance = Math.abs(p.offsetLeft + p.offsetWidth / 2 - middle);
        if (distance < best) { best = distance; index = i; }
      });
      const next = panels[Math.min(panels.length - 1, Math.max(0, index + dir))];
      next?.scrollIntoView({ inline: "center", block: "nearest" });
    };

    rail.addEventListener("keydown", (e) => {
      if (!wide.matches) return;
      if (e.key === "ArrowRight" || e.key === "PageDown") { e.preventDefault(); step(1); }
      else if (e.key === "ArrowLeft" || e.key === "PageUp") { e.preventDefault(); step(-1); }
      else if (e.key === "Home") { e.preventDefault(); rail.scrollTo({ left: 0 }); }
      else if (e.key === "End") { e.preventDefault(); rail.scrollTo({ left: rail.scrollWidth }); }
    });

    // Tabbing to a card off-screen should bring it into view.
    rail.addEventListener("focusin", (e) => {
      if (!wide.matches) return;
      (e.target as HTMLElement).closest(".panel")?.scrollIntoView({ inline: "center", block: "nearest" });
    });
  })();
</script>
