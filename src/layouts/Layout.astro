---
import '../styles/global.css';
import Island from '../components/Island.astro';
import SiteFooter from '../components/SiteFooter.astro';
import CommandPalette from '../components/CommandPalette.astro';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'Fawehinmi Erioluwa — frontend engineer in Lagos, Nigeria. Offline-first systems, computer vision, and interfaces that hold up under real constraints.',
} = Astro.props;

const path = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="google-site-verification" content="JoL1Mp3FLXTw0iYSRy2iOkyWAgvPPLRN5t0UW0kzQco" />
    <meta name="google-site-verification" content="S7Ug6gdObw3K4vs20UcGJlSy9GNNL9xwu-sbcgFXymY" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Grape+Nuts&family=Shantell+Sans:ital,wght,BNCE,INFM@0,300..800,-100..100,0..100&display=swap"
    />

    <title>{title}</title>

    <script is:inline>
      // Set the theme before first paint so the page never flashes the wrong one.
      (function () {
        var saved = localStorage.getItem('theme');
        var theme = saved || (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        document.documentElement.setAttribute('data-theme', theme);
      })();
    </script>
  </head>

  <body data-rail-pos="start">
    <a class="skip-link" href="#rail">Skip to content</a>

    <Island path={path} />
    <CommandPalette />

    <div
      class="rail"
      id="rail"
      tabindex="0"
      role="region"
      aria-label="Page content — scroll to move sideways, or use the arrow keys"
    >
      <slot />
    </div>

    <div class="rail-edge rail-edge-start" aria-hidden="true"></div>
    <div class="rail-edge rail-edge-end" aria-hidden="true"></div>

    <SiteFooter />
  </body>
</html>

<style is:global>
  html, body { height: 100%; }

  .skip-link {
    position: absolute;
    top: -100px;
    left: var(--sp-3);
    z-index: 2000;
    padding: 12px 18px;
    border-radius: var(--r-pill);
    background: var(--chrome-bg);
    color: var(--chrome-fg);
    font-family: var(--body);
    font-weight: 600;
    text-decoration: none;
    transition: top 0.2s ease;
  }

  .skip-link:focus { top: var(--sp-3); }
</style>

<script>
  (function () {
    const rail = document.getElementById("rail");
    if (!rail) return;

    const panels = Array.from(rail.querySelectorAll<HTMLElement>(".panel"));

    // The rail only exists where the CSS says it does: wide enough for it,
    // and only for people who have not asked to be left still.
    const railMode = window.matchMedia(
      "(min-width: 900px) and (prefers-reduced-motion: no-preference)"
    );

    // ── Where along the track are we ──
    // Drives the edge gradients, which are the only wayfinding on the rail.
    let posQueued = false;
    const markPosition = () => {
      posQueued = false;
      if (!railMode.matches) { document.body.dataset.railPos = "start"; return; }
      const max = rail.scrollWidth - rail.clientWidth;
      const x = rail.scrollLeft;
      document.body.dataset.railPos =
        max <= 1 ? "only" : x <= 2 ? "start" : x >= max - 2 ? "end" : "mid";
    };

    const queuePosition = () => {
      if (posQueued) return;
      posQueued = true;
      requestAnimationFrame(markPosition);
    };

    rail.addEventListener("scroll", queuePosition, { passive: true });
    railMode.addEventListener("change", queuePosition);
    markPosition();

    // ── Travel ──
    // Nothing snaps. The rail moves by exactly as much as the gesture asked
    // for and comes to rest wherever it is let go, at any offset — the
    // easing below only smooths the steps a mouse wheel arrives in, it never
    // picks a destination of its own.
    const limit = () => Math.max(0, rail.scrollWidth - rail.clientWidth);
    const clamp = (x: number) => Math.min(Math.max(x, 0), limit());

    let target = rail.scrollLeft;
    let gliding = false;

    const glide = () => {
      const gap = target - rail.scrollLeft;
      if (Math.abs(gap) < 0.5) {
        rail.scrollLeft = target;
        gliding = false;
        return;
      }
      rail.scrollLeft += gap * 0.3;
      requestAnimationFrame(glide);
    };

    const start = () => {
      if (gliding) return;
      gliding = true;
      requestAnimationFrame(glide);
    };

    const glideTo = (x: number) => { target = clamp(x); start(); };

    const nudge = (by: number) => {
      // Anything that moved the rail behind our back — a trackpad swipe, a
      // shift-wheel, a scrollbar drag — is the new starting point.
      if (!gliding) target = rail.scrollLeft;
      target = clamp(target + by);
      start();
    };

    window.addEventListener("resize", () => {
      if (!gliding) target = rail.scrollLeft;
      queuePosition();
    });

    // ── Wheel: a vertical gesture drives the rail sideways ──

    // Firefox and some mice report lines or pages rather than pixels. Without
    // this the rail moved about three pixels per notch there.
    const toPixels = (e: WheelEvent) => {
      if (e.deltaMode === 1) return e.deltaY * 26;                // lines
      if (e.deltaMode === 2) return e.deltaY * rail.clientHeight; // pages
      return e.deltaY;
    };

    // A card that can still scroll in the direction asked for keeps the
    // gesture. Only once it is exhausted does the rail take over — this is
    // what stopped long project cards from being unreadable.
    const innerScroller = (from: EventTarget | null, delta: number) => {
      let el = from instanceof HTMLElement ? from : null;
      while (el && el !== rail) {
        const style = getComputedStyle(el);
        if (/(auto|scroll)/.test(style.overflowY) && el.scrollHeight > el.clientHeight + 1) {
          const room = delta < 0
            ? el.scrollTop > 1
            : el.scrollTop + el.clientHeight < el.scrollHeight - 1;
          if (room) return el;
        }
        el = el.parentElement;
      }
      return null;
    };

    rail.addEventListener(
      "wheel",
      (e) => {
        if (!railMode.matches) return;
        // Leave real horizontal gestures alone; the browser handles those.
        if (Math.abs(e.deltaY) <= Math.abs(e.deltaX)) return;

        const delta = toPixels(e);
        if (innerScroller(e.target, delta)) return;

        e.preventDefault();
        nudge(delta);
      },
      { passive: false }
    );

    // ── Keyboard ──
    // Arrows step a panel at a time because a keyboard has no notion of
    // "a bit further"; the wheel keeps its free positioning.
    const step = (dir: number) => {
      const middle = rail.scrollLeft + rail.clientWidth / 2;
      let index = 0;
      let best = Infinity;
      panels.forEach((p, i) => {
        const distance = Math.abs(p.offsetLeft + p.offsetWidth / 2 - middle);
        if (distance < best) { best = distance; index = i; }
      });
      const next = panels[Math.min(panels.length - 1, Math.max(0, index + dir))];
      if (next) glideTo(next.offsetLeft + next.offsetWidth / 2 - rail.clientWidth / 2);
    };

    rail.addEventListener("keydown", (e) => {
      if (!railMode.matches) return;
      if (e.key === "ArrowRight" || e.key === "PageDown") { e.preventDefault(); step(1); }
      else if (e.key === "ArrowLeft" || e.key === "PageUp") { e.preventDefault(); step(-1); }
      else if (e.key === "Home") { e.preventDefault(); glideTo(0); }
      else if (e.key === "End") { e.preventDefault(); glideTo(limit()); }
    });

    // Tabbing to a card off-screen should bring it into view — and only
    // then. Recentring a panel that is already in front of you is motion
    // for nothing.
    rail.addEventListener("focusin", (e) => {
      if (!railMode.matches) return;
      const panel = (e.target as HTMLElement).closest<HTMLElement>(".panel");
      if (!panel) return;
      const left = panel.offsetLeft - rail.scrollLeft;
      if (left >= 0 && left + panel.offsetWidth <= rail.clientWidth) return;
      glideTo(panel.offsetLeft + panel.offsetWidth / 2 - rail.clientWidth / 2);
    });
  })();
</script>
