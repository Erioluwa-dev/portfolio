---
import Layout from './Layout.astro';

interface Props {
  title: string;
  date: string;
}

const { title, date } = Astro.props;

const formatted = new Date(date).toLocaleDateString('en-GB', {
  day: '2-digit',
  month: 'long',
  year: 'numeric',
});
---

<Layout title={`${title} — Letters`}>
  <div class="shell">
    <article class="bento">
      <div class="col-12">
        <div class="card card-teal post-head">
          <a class="back" href="/letters">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M19 12H6M11 18l-6-6 6-6" />
            </svg>
            <span class="tag">All letters</span>
          </a>
          <h1 class="h2 post-title">{title}</h1>
          <span class="tag post-date">{formatted}</span>
        </div>
      </div>

      <div class="col-8">
        <div class="card post-body prose">
          <slot />
        </div>
      </div>

      <div class="col-4 stretch">
        <div class="card card-bare post-aside">
          <p class="hand aside-note">Written by</p>
          <p class="h3 aside-name">Fawehinmi Erioluwa</p>
          <p class="muted aside-body">
            Frontend engineer in Lagos. Currently building CourtVision.
          </p>
          <a class="btn btn-ghost aside-btn" href="/contact">Get in touch</a>
        </div>
      </div>
    </article>
  </div>
</Layout>

<style>
  .stretch { display: flex; }
  .stretch > :global(*) { flex: 1; }

  .post-head { gap: 14px; }

  .back {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    align-self: flex-start;
    text-decoration: none;
    opacity: 0.75;
    transition: opacity 0.18s ease, transform 0.18s ease;
  }

  .back:hover { opacity: 1; transform: translateX(-3px); }

  .post-title { max-width: 22ch; }
  .post-date { opacity: 0.7; }

  .post-body { gap: 0; }

  .post-body :global(p) {
    margin: 0 0 1.15em;
    font-size: 1.02rem;
    line-height: 1.75;
    max-width: 68ch;
  }

  .post-body :global(p:last-child) { margin-bottom: 0; }

  .post-body :global(h2) {
    font-family: var(--display);
    font-size: var(--fs-h3);
    font-weight: 600;
    font-variation-settings: 'BNCE' 22, 'INFM' 24;
    line-height: 1.24;
    margin: 1.8em 0 0.55em;
  }

  .post-body :global(h2:first-child) { margin-top: 0; }

  .post-body :global(a) {
    color: var(--live);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .post-body :global(ul),
  .post-body :global(ol) {
    margin: 0 0 1.15em;
    padding-left: 1.2em;
    line-height: 1.75;
  }

  .post-body :global(li) { margin-bottom: 0.4em; }

  .post-body :global(blockquote) {
    margin: 1.4em 0;
    padding: 4px 0 4px 20px;
    border-left: 3px solid var(--amber);
    font-family: var(--hand);
    font-size: 1.3rem;
    line-height: 1.45;
    color: var(--ink-soft);
  }

  .post-body :global(code) {
    font-family: var(--mono);
    font-size: 0.88em;
    padding: 2px 6px;
    border-radius: 5px;
    background: var(--paper);
  }

  .post-aside { gap: 6px; justify-content: center; }
  .aside-note { margin: 0; font-size: 1.3rem; color: var(--ink-soft); }
  .aside-name { margin: 0; }
  .aside-body { margin: 8px 0 0; font-size: 0.9rem; }
  .aside-btn { margin-top: 18px; align-self: flex-start; }
</style>
