---
import Layout from './Layout.astro';
import Arrow from '../components/Arrow.astro';
import { letters } from '../data/site';

interface Props {
  title: string;
  date: string;
}

const { title, date } = Astro.props;

const formatted = new Date(date).toLocaleDateString('en-GB', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});

// Reading time from the rendered letter itself, at a steady 220 words a minute.
const html = await Astro.slots.render('default');
const words = html.replace(/<[^>]+>/g, ' ').split(/\s+/).filter(Boolean).length;
const minutes = Math.max(1, Math.round(words / 220));

const slug = Astro.url.pathname.replace(/\/$/, '').split('/').pop();
const others = letters.filter((l) => l.slug !== slug).slice(0, 2);
---

<Layout title={`${title} — Letters`}>
  <div class="board">
    <header class="w m-4 c-12 post-head" style="--d:0">
      <a class="link small back" href="/letters">← All letters</a>
      <h1 class="post-title">{title}</h1>
    </header>

    <section class="w m-2 c-4 meta" style="--d:1" aria-label="Published">
      <p class="w-label">Published</p>
      <time class="w-title" datetime={date}>{formatted}</time>
    </section>

    <section class="w m-2 c-4 w-yellow meta" style="--d:2" aria-label="Reading time">
      <p class="w-label">Reading time</p>
      <p class="w-title">{minutes} min · {words} words</p>
    </section>

    <section class="w m-4 c-4 w-dark meta" style="--d:3" aria-label="Author">
      <p class="w-label">From</p>
      <p class="w-title">Eri, in Lagos</p>
    </section>

    <article class="w m-4 c-12 post" style="--d:4">
      <div class="prose post-prose">
        <Fragment set:html={html} />
      </div>
    </article>

    {others.map((l, i) => (
      <a class="w m-4 c-6 more" href={`/letters/${l.slug}`} style={`--d:${5 + i}`}>
        <Arrow />
        <p class="w-label">Another letter</p>
        <p class="more-title">{l.title}</p>
        <p class="w-text small">{l.excerpt}</p>
      </a>
    ))}

    <a class:list={["w m-4 w-dark byline", others.length % 2 === 0 ? "c-12" : "c-6"]} href="/contact" style={`--d:${5 + others.length}`}>
      <Arrow />
      <p class="w-label">Written by Fawehinmi Erioluwa</p>
      <p class="w-title">A product engineer in Lagos. Get in touch.</p>
    </a>
  </div>
</Layout>

<style>
  .post-head { gap: 1rem; padding: clamp(1.5rem, 1rem + 2.5vw, 3rem); background: var(--paper); }

  .back { display: inline-flex; align-items: center; align-self: flex-start; min-height: 44px; color: var(--ink-2); }

  .post-title {
    margin: 0;
    max-width: 18ch;
    font-size: clamp(2.25rem, 1rem + 4vw, 4rem);
    font-weight: 800;
    font-stretch: 112%;
    line-height: 1;
    letter-spacing: -0.03em;
    text-wrap: balance;
  }

  .meta .w-title { font-size: clamp(1.05rem, 0.9rem + 0.6vw, 1.35rem); }

  /* The letter is a paper widget with a reading column inside it. */
  .post { background: var(--paper); padding: clamp(1.5rem, 1rem + 3vw, 4rem) clamp(1.25rem, 1rem + 4vw, 5rem); }

  .post-prose { max-width: 40rem; font-family: var(--serif); font-size: 1.1875rem; }

  .post-prose :global(p) {
    margin: 0 0 1.2em;
    line-height: 1.7;
  }

  .post-prose :global(p:last-child) { margin-bottom: 0; }

  .post-prose :global(h2) {
    font-family: var(--sans);
    font-size: var(--fs-h3);
    font-weight: 700;
    font-stretch: 105%;
    letter-spacing: -0.01em;
    line-height: 1.25;
    margin: 2em 0 0.6em;
  }

  .post-prose :global(a) {
    text-decoration: underline;
    text-decoration-color: var(--line-strong);
    text-underline-offset: 0.2em;
  }

  .post-prose :global(a:hover) { text-decoration-color: currentColor; }

  .post-prose :global(ul),
  .post-prose :global(ol) {
    margin: 0 0 1.2em;
    padding-left: 1.2em;
    line-height: 1.7;
  }

  .post-prose :global(li) { margin-bottom: 0.4em; }

  .post-prose :global(blockquote) {
    margin: 1.5em 0;
    padding-left: 1.25rem;
    border-left: 4px solid var(--yellow);
    font-size: var(--fs-lead);
    line-height: 1.45;
  }

  .post-prose :global(code) {
    font-family: ui-monospace, 'Cascadia Code', Menlo, monospace;
    font-size: 0.88em;
    padding: 0.1em 0.35em;
    border-radius: 4px;
    background: var(--line);
  }

  .more-title {
    margin: 0;
    padding-right: 2.5rem;
    font-family: var(--serif);
    font-size: clamp(1.25rem, 1rem + 0.8vw, 1.6rem);
    line-height: 1.2;
  }

  .byline .w-title { padding-right: 2.5rem; }
</style>
