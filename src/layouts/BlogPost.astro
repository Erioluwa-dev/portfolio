---
import Layout from './Layout.astro';

interface Props {
  title: string;
  date: string;
}

const { title, date } = Astro.props;

const formatted = new Date(date).toLocaleDateString('en-GB', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});
---

<Layout title={`${title} — Letters`}>
  <article class="post">
    <header class="post-head">
      <a class="link small back" href="/letters">All letters</a>
      <h1 class="display post-title">{title}</h1>
      <time class="small faint" datetime={date}>{formatted}</time>
    </header>

    <div class="prose post-prose">
      <slot />
    </div>

    <footer class="byline">
      <p class="muted">
        Written by Fawehinmi Erioluwa, a product engineer in Lagos, Nigeria.
      </p>
      <a class="btn btn-quiet" href="/contact">Get in touch</a>
    </footer>
  </article>
</Layout>

<style>
  .post {
    display: flex;
    flex-direction: column;
    gap: 3rem;
    max-width: 44rem;
  }

  .post-head { display: flex; flex-direction: column; align-items: flex-start; gap: 1rem; }

  .back { display: inline-flex; align-items: center; min-height: 44px; color: var(--ink-2); }

  .post-title { font-size: clamp(2.25rem, 1rem + 4vw, 3.75rem); }

  .post-prose { font-size: 1.125rem; }

  .post-prose :global(p) {
    margin: 0 0 1.2em;
    line-height: 1.7;
  }

  .post-prose :global(p:last-child) { margin-bottom: 0; }

  .post-prose :global(h2) {
    font-size: var(--fs-h3);
    font-weight: 700;
    font-stretch: 105%;
    letter-spacing: -0.01em;
    line-height: 1.25;
    margin: 2em 0 0.6em;
  }

  .post-prose :global(a) {
    text-decoration: underline;
    text-decoration-color: var(--line-strong);
    text-underline-offset: 0.2em;
  }

  .post-prose :global(a:hover) { text-decoration-color: currentColor; }

  .post-prose :global(ul),
  .post-prose :global(ol) {
    margin: 0 0 1.2em;
    padding-left: 1.2em;
    line-height: 1.7;
  }

  .post-prose :global(li) { margin-bottom: 0.4em; }

  .post-prose :global(blockquote) {
    margin: 1.5em 0;
    padding-left: 1.25rem;
    border-left: 4px solid var(--yellow);
    font-size: var(--fs-lead);
    line-height: 1.45;
  }

  .post-prose :global(code) {
    font-family: ui-monospace, 'Cascadia Code', Menlo, monospace;
    font-size: 0.88em;
    padding: 0.1em 0.35em;
    border-radius: 4px;
    background: var(--line);
  }

  .byline {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem 2rem;
    padding-top: 2rem;
    border-top: 1px solid var(--line);
  }

  .byline p { margin: 0; }
</style>
