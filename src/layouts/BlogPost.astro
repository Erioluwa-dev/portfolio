---
import Layout from './Layout.astro';

interface Props {
  title: string;
  date: string;
}

const { title, date } = Astro.props;

const formatted = new Date(date).toLocaleDateString('en-GB', {
  day: '2-digit',
  month: 'long',
  year: 'numeric',
});
---

<Layout title={`${title} — Letters`}>
  {/* Long prose is the one thing that should not run sideways, so the post
      sits in a single panel and scrolls the ordinary way inside its card. */}
  <section class="panel panel-lg">
    <article class="post">
      <div class="card card-scroll body-card">
        <a class="back" href="/letters">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M19 12H6M11 18l-6-6 6-6" />
          </svg>
          <span class="tag">All letters</span>
        </a>

        <span class="tag muted">{formatted}</span>
        <h1 class="h2 post-title">{title}</h1>

        <div class="prose post-prose">
          <slot />
        </div>
      </div>

      <aside class="card card-teal aside">
        <p class="hand aside-note">Written by</p>
        <p class="h3 aside-name">Fawehinmi Erioluwa</p>
        <p class="body aside-body">
          Product engineer in Lagos. Currently building CourtVision.
        </p>
        <a class="btn btn-amber aside-btn" href="/contact">Get in touch</a>
      </aside>
    </article>
  </section>
</Layout>

<style>
  /* Prose at φ², the byline at 1. Reading is the whole job of this page. */
  .post {
    display: grid;
    grid-template-columns: 2.618fr 1fr;
    gap: var(--sp-3);
    flex: var(--fill);
    min-height: 0;
  }

  .post > :global(*) { min-height: 0; }

  .body-card { gap: var(--sp-2); }

  .back {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    align-self: flex-start;
    min-height: 40px;
    text-decoration: none;
    color: var(--ink-soft);
    transition: color 0.18s ease, transform 0.18s ease;
  }

  .back:hover { color: var(--ink); transform: translateX(-3px); }

  .post-title { max-width: 24ch; }

  .post-prose { margin-top: var(--sp-1); }

  .post-prose :global(p) {
    margin: 0 0 1.1em;
    line-height: 1.72;
    max-width: 66ch;
  }

  .post-prose :global(p:last-child) { margin-bottom: 0; }

  .post-prose :global(h2) {
    font-family: var(--display);
    font-size: var(--fs-h3);
    font-weight: 600;
    font-variation-settings: 'BNCE' 20, 'INFM' 22;
    line-height: 1.24;
    margin: 1.7em 0 0.5em;
  }

  .post-prose :global(a) {
    color: var(--live-ink);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .post-prose :global(ul),
  .post-prose :global(ol) {
    margin: 0 0 1.1em;
    padding-left: 1.2em;
    line-height: 1.72;
  }

  .post-prose :global(li) { margin-bottom: 0.4em; }

  .post-prose :global(blockquote) {
    margin: 1.3em 0;
    padding: 4px 0 4px var(--sp-3);
    border-left: 3px solid var(--amber);
    font-family: var(--hand);
    font-size: var(--fs-h3);
    line-height: 1.4;
    color: var(--ink-soft);
  }

  .post-prose :global(code) {
    font-family: var(--mono);
    font-size: 0.88em;
    padding: 2px 6px;
    border-radius: 5px;
    background: var(--paper);
  }

  .aside { justify-content: safe center; }
  .aside-note { opacity: 0.8; }
  .aside-body { opacity: 0.84; margin-top: var(--sp-1); }
  .aside-btn { align-self: flex-start; margin-top: var(--sp-3); }

  @media (max-width: 899px) {
    .post { grid-template-columns: 1fr; }
  }
</style>
