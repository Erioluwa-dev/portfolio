---
import Layout from '../layouts/Layout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { projects, social } from '../data/site';

const arrow = "M5 12h13M13 6l6 6-6 6";
---

<Layout
  title="Projects — Fawehinmi Erioluwa"
  description="Computer vision, graph ML, offline-first systems, realtime interfaces, and the small builds that taught me the fundamentals."
>
  <section class="panel panel-md" aria-labelledby="projects-heading">
    <div class="split">
      <div class="card card-amber card-hero head">
        <span class="tag">Projects</span>
        <h1 class="display" id="projects-heading">Seven builds.</h1>
        <p class="lead head-lead">
          Vision pipelines, a platform that syncs when the network returns, a
          recommender built on a graph, some Rust I am still learning, and the
          small one that is here because it is where I started. None of them
          are tutorials.
        </p>
      </div>

      <div class="card card-bare repo">
        <p class="hand repo-note">Everything public lives here.</p>
        <a class="link-arrow" href={social.github} target="_blank" rel="noopener noreferrer">
          github.com/Erioluwa-dev
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d={arrow} />
          </svg>
        </a>
      </div>
    </div>
  </section>

  {projects.map((p) => (
    <section class:list={["panel", p.flagship ? "panel-md" : "panel-sm"]} aria-label={p.name}>
      <ProjectCard project={p} expanded />
    </section>
  ))}

  <section class="panel panel-sm" aria-labelledby="projects-end">
    <div class="card card-ink closing">
      <p class="hand closing-note">That's the shelf.</p>
      <h2 class="h2" id="projects-end">Want one built for you?</h2>
      <a class="btn btn-amber" href="/contact">
        Start a conversation
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d={arrow} />
        </svg>
      </a>
    </div>
  </section>
</Layout>

<style>
  .head { justify-content: safe center; }
  .head-lead { max-width: 42ch; opacity: 0.86; }

  .repo { justify-content: safe center; }
  .repo-note { color: var(--ink-soft); }

  .closing { flex: var(--fill); justify-content: safe center; align-items: flex-start; }
  .closing-note { color: var(--amber); }
</style>
