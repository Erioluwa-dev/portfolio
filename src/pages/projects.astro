---
import Layout from '../layouts/Layout.astro';
import Project from '../components/Project.astro';
import { projects, social } from '../data/site';
---

<Layout
  title="Projects — Fawehinmi Erioluwa"
  description="Offline-first systems, hand-built interfaces, and the small builds that taught me the fundamentals."
>
  <header class="page-head">
    <h1 class="display" id="projects-heading">Three builds.</h1>
    <p class="lead">
      A platform that syncs when the network returns, the site you are
      reading, and the small one that is here because it is where I
      started. None of them are tutorials.
    </p>
    <p class="muted">
      Everything public lives on
      <a class="link" href={social.github} target="_blank" rel="noopener noreferrer">GitHub</a>.
    </p>
  </header>

  <section aria-label="All projects">
    <ul class="rows">
      {projects.map((p) => <li><Project project={p} level={2} expanded /></li>)}
    </ul>
  </section>

  <section class="closing" aria-labelledby="projects-end">
    <h2 class="h2" id="projects-end">Want one built for you?</h2>
    <div class="actions">
      <a class="btn" href="/contact">Start a conversation</a>
    </div>
  </section>
</Layout>

<style>
  .page-head { display: flex; flex-direction: column; gap: 1.25rem; }
  .page-head .muted { margin: 0; }

  .closing { display: flex; flex-direction: column; align-items: flex-start; gap: 1.25rem; }
</style>
