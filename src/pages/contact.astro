---
import Layout from '../layouts/Layout.astro';
import { social } from '../data/site';

const channels = [
  { label: "Email", value: social.email, href: `mailto:${social.email}`, note: "Best for anything with detail." },
  { label: "GitHub", value: "Erioluwa-dev", href: social.github, note: "Code, issues, and what I am shipping." },
  { label: "Instagram", value: "stay.with.eri", href: social.instagram, note: "Less code, more life." },
];

const openTo = [
  "Product and full-stack engineering roles",
  "Frontend-heavy work where UI/UX carries weight",
  "Teams building AI into an actual product",
  "Collaborations on real products",
];
---

<Layout
  title="Contact — Fawehinmi Erioluwa"
  description="Get in touch with Fawehinmi Erioluwa — product and full-stack roles, frontend-heavy work, and collaborations."
>
  <header class="page-head">
    <h1 class="display" id="contact-heading">Say what you need built.</h1>
    <p class="lead">
      A role, contract work, or the project that has been sitting in your
      notes app for a month. Send it over — I read everything and reply
      within a day or two.
    </p>
    <div class="actions">
      <a class="btn btn-yellow email" href={`mailto:${social.email}`}>{social.email}</a>
    </div>
  </header>

  <div class="split">
    <section class="section" aria-labelledby="open-heading">
      <h2 class="h3" id="open-heading">I'm open to</h2>
      <ul class="rows open-list">
        {openTo.map((item) => <li>{item}</li>)}
      </ul>
      <p class="small muted">Lagos, Nigeria — remote-friendly and used to working across timezones.</p>
    </section>

    <section class="section" aria-labelledby="channels-heading">
      <h2 class="h3" id="channels-heading">Where to find me</h2>
      <ul class="rows">
        {channels.map((c) => (
          <li>
            <a
              class="channel"
              href={c.href}
              target={c.href.startsWith('http') ? '_blank' : undefined}
              rel={c.href.startsWith('http') ? 'noopener noreferrer' : undefined}
            >
              <span class="small faint">{c.label}</span>
              <span class="channel-value">{c.value}</span>
              <span class="small muted">{c.note}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  </div>
</Layout>

<style>
  .page-head { display: flex; flex-direction: column; gap: 1.25rem; }
  .email { overflow-wrap: anywhere; }

  .split {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem 4rem;
    align-items: start;
  }

  .split .section { gap: 1.25rem; }
  .split .small.muted { margin: 0; }

  .open-list li { padding: 0.9rem 0; font-size: 1.125rem; }

  .channel {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    padding: 1rem 0;
    text-decoration: none;
  }

  .channel-value {
    font-size: 1.25rem;
    font-weight: 600;
    overflow-wrap: anywhere;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-decoration-color: var(--line-strong);
    text-underline-offset: 0.2em;
    transition: text-decoration-color 0.15s ease;
  }

  .channel:hover .channel-value { text-decoration-color: currentColor; }

  @media (max-width: 859px) {
    .split { grid-template-columns: 1fr; }
  }
</style>
