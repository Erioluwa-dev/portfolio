---
import Layout from '../layouts/Layout.astro';
import { social } from '../data/site';

const channels = [
  { label: "Email", value: social.email, href: `mailto:${social.email}`, note: "Best for anything with detail." },
  { label: "GitHub", value: "Erioluwa-dev", href: social.github, note: "Code, issues, and what I am shipping." },
  { label: "Instagram", value: "stay.with.eri", href: social.instagram, note: "Less code, more life." },
];

const arrow = "M5 12h13M13 6l6 6-6 6";
---

<Layout
  title="Contact — Fawehinmi Erioluwa"
  description="Get in touch with Fawehinmi Erioluwa — frontend roles, QA testing, and collaborations."
>
  <section class="panel panel-md" aria-labelledby="contact-heading">
    <div class="card card-ink card-hero head">
      <span class="tag">Contact</span>
      <h1 class="display" id="contact-heading">Say what you need built.</h1>
      <p class="lead head-lead">
        A role, contract work, or the project that has been sitting in your
        notes app for a month. Send it over — I read everything and reply
        within a day or two.
      </p>
      <a class="btn btn-amber head-btn" href={`mailto:${social.email}`}>
        {social.email}
      </a>
    </div>
  </section>

  <section class="panel panel-sm" aria-labelledby="open-heading">
    <div class="card card-amber open">
      <p class="hand open-note">Right now</p>
      <h2 class="h2" id="open-heading">I'm open to</h2>
      <ul class="open-list">
        <li>Frontend engineering roles</li>
        <li>QA and testing work</li>
        <li>Collaborations on real products</li>
      </ul>
      <p class="body open-foot">
        Lagos, Nigeria — remote-friendly and used to working across timezones.
      </p>
    </div>
  </section>

  <section class="panel panel-lg" aria-label="Ways to reach me">
    <div class="channels">
      {channels.map((c) => (
        <a
          class="card channel"
          href={c.href}
          target={c.href.startsWith('http') ? '_blank' : undefined}
          rel={c.href.startsWith('http') ? 'noopener noreferrer' : undefined}
        >
          <span class="tag muted">{c.label}</span>
          <span class="h3 channel-value">{c.value}</span>
          <span class="body muted channel-note">{c.note}</span>
          <svg class="channel-arrow" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d={arrow} />
          </svg>
        </a>
      ))}
    </div>
  </section>
</Layout>

<style>
  .head { justify-content: safe center; }
  .head-lead { max-width: 46ch; opacity: 0.84; }
  .head-btn { align-self: flex-start; margin-top: var(--sp-1); word-break: break-word; }

  .open { justify-content: safe center; }
  .open-note { opacity: 0.75; }

  .open-list {
    margin: var(--sp-1) 0 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--sp-1);
    font-size: var(--fs-lead);
    font-weight: 600;
  }

  .open-list li { position: relative; padding-left: 22px; }

  .open-list li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.62em;
    width: 10px;
    height: 2px;
    background: currentColor;
  }

  .open-foot { margin-top: var(--sp-2); opacity: 0.74; }

  .channels {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--sp-2);
    flex: 1;
    min-height: 0;
  }

  .channel {
    justify-content: safe center;
    gap: 6px;
    text-decoration: none;
    transition: transform 0.18s ease, border-color 0.18s ease;
  }

  .channel:hover { transform: translateY(-3px); border-color: var(--live-ink); }
  .channel:hover .channel-arrow { transform: translateX(4px); color: var(--live-ink); }

  /* A 27-character address in a third-of-a-panel card is the one place
     the fixed h3 step broke down, so this one sizes to its card. */
  .channel-value {
    font-size: clamp(var(--fs-body), 6.2cqi, var(--fs-h3));
    overflow-wrap: anywhere;
  }

  .channel-arrow {
    margin-top: var(--sp-3);
    transition: transform 0.2s ease, color 0.2s ease;
  }

  @media (max-width: 899px) {
    .channels { grid-template-columns: 1fr; }
  }
</style>
