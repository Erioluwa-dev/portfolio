---
import Layout from '../layouts/Layout.astro';
import { social } from '../data/site';

const channels = [
  { label: "Email", value: social.email, href: `mailto:${social.email}`, note: "Best for anything with detail." },
  { label: "GitHub", value: "Erioluwa-dev", href: social.github, note: "Code, issues, and what I am shipping." },
  { label: "Instagram", value: "stay.with.eri", href: social.instagram, note: "Less code, more life." },
];
---

<Layout
  title="Contact — Fawehinmi Erioluwa"
  description="Get in touch with Fawehinmi Erioluwa — frontend roles, QA testing, and collaborations."
>
  <div class="shell">
    <section class="bento">
      <div class="col-7">
        <div class="card card-ink contact-head">
          <span class="tag">Contact</span>
          <h1 class="display">Say what you need built.</h1>
          <p class="lead contact-lead">
            A role, contract work, or the project that has been sitting in your
            notes app for a month. Send it over &mdash; I read everything and
            reply within a day or two.
          </p>
          <a class="btn head-btn" href={`mailto:${social.email}`}>
            {social.email}
          </a>
        </div>
      </div>

      <div class="col-5 stretch">
        <div class="card card-amber open-card">
          <p class="hand open-note">Right now I am open to</p>
          <ul class="open-list">
            <li>Frontend engineering roles</li>
            <li>QA and testing work</li>
            <li>Collaborations on real products</li>
          </ul>
          <p class="open-foot">
            Lagos, Nigeria &mdash; remote-friendly and used to working across
            timezones.
          </p>
        </div>
      </div>
    </section>

    <section class="bento" aria-label="Ways to reach me">
      {channels.map((c) => (
        <div class="col-4 stretch">
          <a
            class="card channel"
            href={c.href}
            target={c.href.startsWith('http') ? '_blank' : undefined}
            rel={c.href.startsWith('http') ? 'noopener noreferrer' : undefined}
          >
            <span class="tag muted">{c.label}</span>
            <span class="h3 channel-value">{c.value}</span>
            <span class="muted channel-note">{c.note}</span>
            <svg class="channel-arrow" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M5 12h13M13 6l6 6-6 6" />
            </svg>
          </a>
        </div>
      ))}
    </section>
  </div>
</Layout>

<style>
  .stretch { display: flex; }
  .stretch > :global(*) { flex: 1; }

  .contact-head { gap: 16px; }
  .contact-lead { max-width: 48ch; opacity: 0.82; }

  .head-btn {
    margin-top: 8px;
    align-self: flex-start;
    background: var(--amber);
    color: var(--on-amber);
    word-break: break-word;
  }

  .open-card { gap: 12px; justify-content: center; }
  .open-note { margin: 0; font-size: 1.35rem; opacity: 0.75; }

  .open-list {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 8px;
    font-size: 1.05rem;
    font-weight: 600;
  }

  .open-list li { position: relative; padding-left: 20px; }

  .open-list li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.62em;
    width: 9px;
    height: 2px;
    background: currentColor;
  }

  .open-foot { margin: 6px 0 0; font-size: 0.9rem; opacity: 0.72; }

  .channel {
    gap: 6px;
    text-decoration: none;
    transition: transform 0.18s ease, border-color 0.18s ease;
  }

  .channel:hover { transform: translateY(-3px); border-color: var(--live); }
  .channel:hover .channel-arrow { transform: translateX(4px); color: var(--live); }

  .channel-value { word-break: break-word; }
  .channel-note { font-size: 0.9rem; }

  .channel-arrow {
    margin-top: 16px;
    transition: transform 0.2s ease, color 0.2s ease;
  }
</style>
