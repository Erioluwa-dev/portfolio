---
import Layout from '../layouts/Layout.astro';
import PortraitCard from '../components/PortraitCard.astro';
import { stack } from '../data/site';

// A real chronology — and on a rail that runs left to right, the order is the
// point. The labels mark position in time, not decoration.
const beats = [
  {
    when: "Before",
    what: "A bad PC and a Roblox animation I could not make",
    body: "I wanted to build games without learning to script. Dragging and dropping seemed easier than writing code. It was not.",
  },
  {
    when: "The turn",
    what: "A bootcamp — HTML, CSS, JavaScript",
    body: "I went in with no expectations. What got me was not the syntax. It was realising the web was something I could make, not just something I opened.",
  },
  {
    when: "Then",
    what: "Building for constraints instead of tutorials",
    body: "YEMS had to keep working in a school where the connection drops mid-form. That is when I stopped writing code that only runs on my machine, on my wifi.",
  },
  {
    when: "Now",
    what: "CourtVision — 26 weeks, solo",
    body: "Computer vision sits further outside my comfort zone than anything I have shipped. That is most of why I am building it.",
  },
];

const facts = [
  { label: "Based in", value: "Lagos, Nigeria" },
  { label: "Learning", value: "Computer vision, and how to scope a build" },
  { label: "Open to", value: "Frontend roles, QA testing, collaborations" },
];
---

<Layout
  title="About — Fawehinmi Erioluwa"
  description="How a self-taught engineer in Lagos went from avoiding code to building offline-first systems and computer vision tools."
>
  <section class="panel panel-lg" aria-labelledby="about-heading">
    <div class="opener">
      <PortraitCard tag="eri · 2026" />

      <div class="card card-teal card-hero head">
        <span class="tag">About</span>
        <h1 class="display" id="about-heading">It started with laziness, honestly.</h1>
        <p class="lead head-lead">
          I am Fawehinmi Erioluwa — self-taught, based in Lagos, and far more
          interested in whether a thing holds up under real conditions than in
          whether it demos well.
        </p>
      </div>
    </div>
  </section>

  {beats.map((b) => (
    <section class="panel panel-sm" aria-label={b.when}>
      <div class="card beat">
        <span class="tag beat-when">{b.when}</span>
        <h2 class="h2 beat-what">{b.what}</h2>
        <p class="lead beat-body muted">{b.body}</p>
      </div>
    </section>
  ))}

  <section class="panel panel-sm" aria-labelledby="belief-heading">
    <div class="card card-amber belief">
      <p class="hand belief-note">What I actually believe</p>
      <h2 class="h2" id="belief-heading">Clean interfaces are the easy half.</h2>
      <p class="lead belief-body">
        The hard half is code that still makes sense to you a year later, on a
        project nobody funded, under constraints nobody chose.
      </p>
    </div>
  </section>

  <section class="panel panel-sm" aria-labelledby="tools-heading">
    <div class="split">
      <div class="card tools card-scroll">
        <span class="tag muted">The toolkit</span>
        <h2 class="h3" id="tools-heading">What I reach for</h2>

        <div class="tool-groups">
          {stack.map((g) => (
            <div>
              <p class="hand tool-group">{g.group}</p>
              <ul class="chip-list">
                {g.items.map((i) => <li class="tag chip chip-solid">{i}</li>)}
              </ul>
            </div>
          ))}
        </div>
      </div>

      <div class="card card-bare facts">
        <dl class="fact-list">
          {facts.map((f) => (
            <div class="fact">
              <dt class="tag muted">{f.label}</dt>
              <dd>{f.value}</dd>
            </div>
          ))}
        </dl>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* The mark at 1, the story at φ². A logo does not need a third of the
     widest panel on the site. */
  .opener {
    display: grid;
    grid-template-columns: 1fr 2.618fr;
    gap: var(--sp-3);
    flex: var(--fill);
    min-height: 0;
  }

  .opener > :global(*) { min-height: 0; }

  .head { justify-content: safe center; }
  .head-lead { max-width: 46ch; opacity: 0.88; }

  .beat { justify-content: safe center; }
  .beat-when { color: var(--live-ink); }
  .beat-what { max-width: 20ch; }
  .beat-body { max-width: 40ch; }

  .belief { justify-content: safe center; }
  .belief-note { opacity: 0.75; }
  .belief-body { max-width: 40ch; }

  .tools { justify-content: safe center; }

  .tool-groups {
    display: flex;
    flex-direction: column;
    gap: var(--sp-3);
    margin-top: var(--sp-1);
  }

  .tool-group { margin-bottom: var(--sp-1); color: var(--ink-soft); }

  .facts { justify-content: safe center; }

  .fact-list {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--sp-2);
  }

  .fact { display: flex; flex-direction: column; gap: 4px; }
  .fact dd { margin: 0; font-weight: 600; }

  @media (max-width: 899px) {
    .opener { grid-template-columns: 1fr; }
  }
</style>
