---
import Layout from '../layouts/Layout.astro';
import Arrow from '../components/Arrow.astro';
import { layers, principles } from '../data/site';

// A real chronology — the order is the point.
const beats = [
  {
    when: "Before",
    what: "A bad PC and a Roblox animation I could not make",
    body: "I wanted to build games without learning to script. Dragging and dropping seemed easier than writing code. It was not.",
  },
  {
    when: "The turn",
    what: "A bootcamp — HTML, CSS, JavaScript",
    body: "I went in with no expectations. What got me was not the syntax. It was realising the web was something I could make, not just something I opened.",
  },
  {
    when: "Then",
    what: "Building for constraints instead of tutorials",
    body: "YEMS had to keep working in a school where the connection drops mid-form. That is when I stopped writing code that only runs on my machine, on my wifi.",
  },
  {
    when: "After that",
    what: "Owning the layers under the interface",
    body: "Node, Bun, Hono, Postgres, Redis, queues, storage. Not because backend is fashionable — because I kept hitting product decisions I could not make from the interface alone.",
  },
];

const facts = [
  { label: "Based in", value: "Lagos, Nigeria" },
  { label: "Deepest in", value: "Frontend, UI/UX, TypeScript, product thinking" },
  { label: "Depth in", value: "Backend, infrastructure, applied ML" },
  { label: "Active in", value: "Graph ML, Rust" },
  { label: "Open to", value: "Product and full-stack roles, collaborations" },
];
---

<Layout
  title="About — Fawehinmi Erioluwa"
  description="How a self-taught engineer in Lagos went from avoiding code to building whole products — interfaces, backends, and the machine learning underneath."
>
  <div class="board">
    <header class="w m-4 c-8 intro" style="--d:0">
      <p class="w-label">About</p>
      <h1 class="display intro-title">It started with laziness, honestly.</h1>
      <p class="lead">
        I am Fawehinmi Erioluwa — a product engineer, self-taught, based in
        Lagos. I started at the interface and kept going down: the API, the
        data, the models. Far more interested in whether a thing holds up
        under real conditions than in whether it demos well.
      </p>
    </header>

    <section class="w m-2 c-4 w-square w-dark place" style="--d:1" aria-label="Where I am">
      <p class="w-label">Based in</p>
      <p class="w-big place-name">Lagos</p>
      <p class="w-text small w-foot"><span data-clock="time">--:--</span> · Nigeria</p>
    </section>

    <section class="w m-2 c-4 w-square w-yellow self" style="--d:2" aria-label="How I learned">
      <p class="w-label">Learned by</p>
      <p class="w-title">Self-taught, then a bootcamp.</p>
      <p class="w-text small w-foot">No CS degree. A lot of shipping.</p>
    </section>

    <section class="w m-4 c-8 r-2 story" style="--d:3" aria-labelledby="story-heading">
      <p class="w-label">Timeline</p>
      <h2 class="w-title" id="story-heading">How I got here</h2>
      <ol class="timeline">
        {beats.map((b) => (
          <li>
            <span class="t-when">{b.when}</span>
            <h3 class="t-what">{b.what}</h3>
            <p class="w-text">{b.body}</p>
          </li>
        ))}
      </ol>
    </section>

    <section class="w m-4 c-4 w-dark belief" style="--d:4" aria-labelledby="belief-heading">
      <p class="w-label">Belief</p>
      <h2 class="belief-title" id="belief-heading">Clean interfaces are the easy half.</h2>
      <p class="w-text">
        The hard half is code that still makes sense to you a year later, on a
        project nobody funded, under constraints nobody chose.
      </p>
    </section>

    <section class="w m-4 c-6 depth" style="--d:5" aria-labelledby="depth-heading">
      <p class="w-label">Toolbox</p>
      <h2 class="w-title" id="depth-heading">From the interface down.</h2>
      <ul class="toolbox">
        {layers.map((l) => (
          <li>
            <span class="tb-name small faint">{l.name}</span>
            <ul class="pills">{l.tools.map((t) => <li>{t}</li>)}</ul>
          </li>
        ))}
      </ul>
    </section>

    <section class="w m-4 c-6 short" style="--d:6" aria-labelledby="facts-heading">
      <p class="w-label">The short version</p>
      <h2 class="sr-only" id="facts-heading">The short version</h2>
      <dl class="facts">
        {facts.map((f) => (
          <div class="fact">
            <dt class="small faint">{f.label}</dt>
            <dd>{f.value}</dd>
          </div>
        ))}
      </dl>
    </section>

    {principles.map((p, i) => (
      <section class="w m-4 c-4 principle" style={`--d:${7 + i}`}>
        <p class="w-label">{['i', 'ii', 'iii'][i]}. How I work</p>
        <h2 class="w-title">{p.title}</h2>
        <p class="w-text small">{p.body}</p>
      </section>
    ))}

    <a class="w m-4 c-12 w-yellow next" href="/contact" style="--d:10">
      <Arrow />
      <p class="w-label">Next</p>
      <p class="w-title">Have something that needs to hold up? Tell me about it.</p>
    </a>
  </div>
</Layout>

<style>
  .intro { gap: 1.25rem; padding: clamp(1.5rem, 1rem + 2.5vw, 3rem); background: var(--paper); }
  .intro-title { font-size: clamp(2.25rem, 1.2rem + 4vw, 4.25rem); max-width: 13ch; }

  .place-name { margin-top: auto; }
  .place .w-foot { margin-top: 0; }

  /* Timeline: a rule down the side, a dot per beat, the last one yellow. */
  .timeline { position: relative; display: flex; flex-direction: column; gap: 1.75rem; margin: 0.5rem 0 0; padding: 0 0 0 1.75rem; list-style: none; }
  .timeline::before { content: ""; position: absolute; left: 5px; top: 0.5rem; bottom: 0.5rem; width: 2px; background: var(--line); }
  .timeline li { position: relative; display: flex; flex-direction: column; gap: 0.35rem; }
  .timeline li::before { content: ""; position: absolute; left: -1.75rem; top: 0.3rem; width: 12px; height: 12px; border-radius: 50%; background: var(--tile); border: 2px solid var(--ink-2); }
  .timeline li:last-child::before { background: var(--yellow); border-color: var(--yellow); }
  .t-when { font-size: 0.75rem; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-3); }
  .t-what { margin: 0; font-size: 1.125rem; font-weight: 700; line-height: 1.3; }
  .timeline .w-text { font-size: var(--fs-sm); max-width: 40em; }

  .belief-title { margin: 0; font-size: clamp(1.6rem, 1rem + 1.6vw, 2.25rem); font-weight: 800; font-stretch: 110%; line-height: 1; letter-spacing: -0.025em; }

  .toolbox { display: flex; flex-direction: column; gap: 0.75rem; margin: 0; padding: 0; list-style: none; }
  .toolbox > li { display: grid; grid-template-columns: 6.5rem 1fr; gap: 0.5rem 1rem; align-items: start; }
  .tb-name { padding-top: 0.3rem; }
  .toolbox > li:first-child .pills li { background: var(--yellow); color: var(--on-yellow); }

  .facts { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem 1.5rem; margin: 0; }
  .fact { display: flex; flex-direction: column; gap: 0.25rem; padding-top: 0.85rem; border-top: 1px solid var(--line); }
  .fact dd { margin: 0; font-weight: 600; line-height: 1.35; }

  .next .w-title { padding-right: 3rem; }

  @media (max-width: 719px) {
    .facts { grid-template-columns: 1fr; }
    .toolbox > li { grid-template-columns: 1fr; gap: 0.35rem; }
  }
</style>
