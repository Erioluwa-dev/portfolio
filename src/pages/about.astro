---
import Layout from '../layouts/Layout.astro';

// A real chronology — the order is the point.
const beats = [
  {
    when: "Before",
    what: "A bad PC and a Roblox animation I could not make",
    body: "I wanted to build games without learning to script. Dragging and dropping seemed easier than writing code. It was not.",
  },
  {
    when: "The turn",
    what: "A bootcamp — HTML, CSS, JavaScript",
    body: "I went in with no expectations. What got me was not the syntax. It was realising the web was something I could make, not just something I opened.",
  },
  {
    when: "Then",
    what: "Building for constraints instead of tutorials",
    body: "YEMS had to keep working in a school where the connection drops mid-form. That is when I stopped writing code that only runs on my machine, on my wifi.",
  },
  {
    when: "After that",
    what: "Owning the layers under the interface",
    body: "Node, Bun, Hono, Postgres, Redis, queues, storage. Not because backend is fashionable — because I kept hitting product decisions I could not make from the interface alone.",
  },
];

const facts = [
  { label: "Based in", value: "Lagos, Nigeria" },
  { label: "Deepest in", value: "Frontend, UI/UX, TypeScript, product thinking" },
  { label: "Depth in", value: "Backend, infrastructure, applied ML" },
  { label: "Active in", value: "Graph ML, Rust" },
  { label: "Open to", value: "Product and full-stack roles, collaborations" },
];
---

<Layout
  title="About — Fawehinmi Erioluwa"
  description="How a self-taught engineer in Lagos went from avoiding code to building whole products — interfaces, backends, and the machine learning underneath."
>
  <header class="page-head">
    <h1 class="display">It started with laziness, honestly.</h1>
    <p class="lead">
      I am Fawehinmi Erioluwa — a product engineer, self-taught, based in
      Lagos. I started at the interface and kept going down: the API, the
      data, the models. Far more interested in whether a thing holds up
      under real conditions than in whether it demos well.
    </p>
  </header>

  <section class="section" aria-labelledby="story-heading">
    <h2 class="h2" id="story-heading">How I got here</h2>
    <ol class="rows beats">
      {beats.map((b) => (
        <li class="beat">
          <p class="small faint beat-when">{b.when}</p>
          <div class="beat-text">
            <h3 class="h3">{b.what}</h3>
            <p class="muted">{b.body}</p>
          </div>
        </li>
      ))}
    </ol>
  </section>

  <section class="belief" aria-labelledby="belief-heading">
    <h2 class="display belief-title" id="belief-heading">Clean interfaces are the easy half.</h2>
    <p class="lead">
      The hard half is code that still makes sense to you a year later, on a
      project nobody funded, under constraints nobody chose.
    </p>
  </section>

  <section class="section" aria-labelledby="facts-heading">
    <h2 class="h2" id="facts-heading">The short version</h2>
    <dl class="facts">
      {facts.map((f) => (
        <div class="fact">
          <dt class="small faint">{f.label}</dt>
          <dd>{f.value}</dd>
        </div>
      ))}
    </dl>
  </section>
</Layout>

<style>
  .page-head { display: flex; flex-direction: column; gap: 1.25rem; }

  .beat {
    display: grid;
    grid-template-columns: 10rem 1fr;
    gap: 0.5rem 2rem;
    padding: 1.75rem 0;
  }

  .beat-when { margin: 0.35rem 0 0; }
  .beat-text { display: flex; flex-direction: column; gap: 0.5rem; }
  .beat-text p { margin: 0; max-width: 38em; }

  /* The one yellow moment on this page: a rule, not a box. */
  .belief {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    padding-left: clamp(1.25rem, 3vw, 2.5rem);
    border-left: 6px solid var(--yellow);
  }

  .belief-title { font-size: clamp(2rem, 1rem + 3.5vw, 3.5rem); max-width: 16ch; }

  .facts { margin: 0; border-top: 1px solid var(--line); }

  .fact {
    display: grid;
    grid-template-columns: 10rem 1fr;
    gap: 0.25rem 2rem;
    padding: 1rem 0;
    border-bottom: 1px solid var(--line);
  }

  .fact dt { margin-top: 0.15rem; }
  .fact dd { margin: 0; font-size: 1.125rem; }

  @media (max-width: 719px) {
    .beat, .fact { grid-template-columns: 1fr; }
    .beat-when { margin: 0; }
  }
</style>
