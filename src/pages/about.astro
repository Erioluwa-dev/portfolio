---
import Layout from '../layouts/Layout.astro';
import PortraitCard from '../components/PortraitCard.astro';
import { stack } from '../data/site';

// A real chronology, so the labels carry order rather than decorate it.
const beats = [
  {
    when: "Before",
    what: "A bad PC and a Roblox animation I could not make",
    body: "I wanted to build games without learning to script. Dragging and dropping seemed easier than writing code. It was not.",
  },
  {
    when: "The turn",
    what: "A bootcamp — HTML, CSS, JavaScript",
    body: "I went in with no expectations. What got me was not the syntax. It was realising the web was something I could make, not just something I opened.",
  },
  {
    when: "Then",
    what: "Building for constraints instead of tutorials",
    body: "YEMS had to keep working in a school where the connection drops mid-form. That is when I stopped writing code that only runs on my machine, on my wifi.",
  },
  {
    when: "Now",
    what: "CourtVision — 26 weeks, solo",
    body: "Computer vision sits further outside my comfort zone than anything I have shipped. That is most of why I am building it.",
  },
];

const facts = [
  { label: "Based in", value: "Lagos, Nigeria" },
  { label: "Learning", value: "Computer vision, and how to scope a build" },
  { label: "Open to", value: "Frontend roles, QA testing, collaborations" },
];
---

<Layout
  title="About — Fawehinmi Erioluwa"
  description="How a self-taught engineer in Lagos went from avoiding code to building offline-first systems and computer vision tools."
>
  <div class="shell">
    <section class="bento">
      <div class="col-7">
        <div class="card card-teal about-head">
          <span class="tag">About</span>
          <h1 class="display">It started with laziness, honestly.</h1>
          <p class="lead about-lead">
            I am Fawehinmi Erioluwa &mdash; self-taught, based in Lagos, and far
            more interested in whether a thing holds up under real conditions
            than in whether it demos well.
          </p>
        </div>
      </div>

      <div class="col-5 stretch">
        <PortraitCard tag="eri · 2026" />
      </div>
    </section>

    <section class="bento" aria-labelledby="story-heading">
      <div class="col-7">
        <div class="card story">
          <h2 class="h2" id="story-heading">How it went</h2>

          <ol class="beats">
            {beats.map((b) => (
              <li class="beat">
                <span class="tag beat-when">{b.when}</span>
                <p class="beat-what">{b.what}</p>
                <p class="beat-body muted">{b.body}</p>
              </li>
            ))}
          </ol>
        </div>
      </div>

      <div class="col-5 side">
        <div class="card card-amber belief">
          <p class="hand belief-note">What I actually believe</p>
          <p class="belief-body">
            Clean interfaces are the easy half. The hard half is code that still
            makes sense to you a year later, on a project nobody funded, under
            constraints nobody chose.
          </p>
        </div>

        <div class="card tools">
          <span class="tag muted">The toolkit</span>
          <div class="tool-groups">
            {stack.map((g) => (
              <div>
                <p class="tool-group hand">{g.group}</p>
                <ul class="tool-list">
                  {g.items.map((i) => <li class="tag tool">{i}</li>)}
                </ul>
              </div>
            ))}
          </div>
        </div>

        <div class="card card-bare facts">
          <dl class="fact-list">
            {facts.map((f) => (
              <div class="fact">
                <dt class="tag muted">{f.label}</dt>
                <dd>{f.value}</dd>
              </div>
            ))}
          </dl>
        </div>
      </div>
    </section>
  </div>
</Layout>

<style>
  .stretch { display: flex; }
  .stretch > :global(*) { flex: 1; }

  .about-head { gap: 14px; }
  .about-lead { max-width: 48ch; opacity: 0.88; }

  .story { gap: 24px; }

  .beats {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .beat {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 22px 0;
  }

  .beat:last-child { padding-bottom: 0; }
  .beat + .beat { border-top: 1px solid var(--hairline); }

  .beat-when { color: var(--live); }

  .beat-what {
    margin: 0;
    font-size: 1.1rem;
    font-weight: 600;
  }

  .beat-body { margin: 0; max-width: 56ch; }

  .side {
    display: flex;
    flex-direction: column;
    gap: var(--gap);
  }

  .belief { gap: 10px; }
  .belief-note { margin: 0; font-size: 1.35rem; opacity: 0.75; }
  .belief-body { margin: 0; font-size: 1.02rem; line-height: 1.55; }

  .tools { gap: 20px; }

  .tool-groups {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .tool-group {
    margin: 0 0 8px;
    font-size: 1.15rem;
    color: var(--ink-soft);
  }

  .tool-list {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .tool {
    padding: 7px 11px;
    border-radius: var(--r-pill);
    background: var(--paper);
    text-transform: none;
    letter-spacing: 0.04em;
  }

  .facts { padding: 22px; }

  .fact-list {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .fact { display: flex; flex-direction: column; gap: 4px; }
  .fact dd { margin: 0; font-weight: 600; }
</style>
