---
import Layout from '../layouts/Layout.astro';
import PortraitCard from '../components/PortraitCard.astro';
import { stack } from '../data/site';

// A real chronology — the order is the point. The labels mark position in
// time, not decoration.
const beats = [
  {
    when: "Before",
    what: "A bad PC and a Roblox animation I could not make",
    body: "I wanted to build games without learning to script. Dragging and dropping seemed easier than writing code. It was not.",
  },
  {
    when: "The turn",
    what: "A bootcamp — HTML, CSS, JavaScript",
    body: "I went in with no expectations. What got me was not the syntax. It was realising the web was something I could make, not just something I opened.",
  },
  {
    when: "Then",
    what: "Building for constraints instead of tutorials",
    body: "YEMS had to keep working in a school where the connection drops mid-form. That is when I stopped writing code that only runs on my machine, on my wifi.",
  },
  {
    when: "After that",
    what: "Owning the layers under the interface",
    body: "Node, Bun, Hono, Postgres, Redis, queues, storage. Not because backend is fashionable — because I kept hitting product decisions I could not make from the interface alone.",
  },
];

const facts = [
  { label: "Based in", value: "Lagos, Nigeria" },
  { label: "Deepest in", value: "Frontend, UI/UX, TypeScript, product thinking" },
  { label: "Depth in", value: "Backend, infrastructure, applied ML" },
  { label: "Active in", value: "Graph ML, Rust" },
  { label: "Open to", value: "Product and full-stack roles, collaborations" },
];
---

<Layout
  title="About — Fawehinmi Erioluwa"
  description="How a self-taught engineer in Lagos went from avoiding code to building whole products — interfaces, backends, and the machine learning underneath."
>
  <section class="section" aria-labelledby="about-heading">
    <div class="opener">
      <PortraitCard tag="eri · 2026" />

      <div class="card card-teal card-hero head">
        <span class="tag">About</span>
        <h1 class="display" id="about-heading">It started with laziness, honestly.</h1>
        <p class="lead head-lead">
          I am Fawehinmi Erioluwa — a product engineer, self-taught, based in
          Lagos. I started at the interface and kept going down: the API, the
          data, the models. Far more interested in whether a thing holds up
          under real conditions than in whether it demos well.
        </p>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="story-heading">
    <div class="section-head">
      <h2 class="h2" id="story-heading">How I got here</h2>
    </div>
    <ol class="grid grid-2 beats">
      {beats.map((b) => (
        <li class="card beat">
          <span class="tag beat-when">{b.when}</span>
          <h3 class="h3 beat-what">{b.what}</h3>
          <p class="body beat-body muted">{b.body}</p>
        </li>
      ))}
    </ol>
  </section>

  <section class="section" aria-labelledby="belief-heading">
    <div class="card card-amber card-hero belief">
      <p class="hand belief-note">What I actually believe</p>
      <h2 class="h2" id="belief-heading">Clean interfaces are the easy half.</h2>
      <p class="lead belief-body">
        The hard half is code that still makes sense to you a year later, on a
        project nobody funded, under constraints nobody chose.
      </p>
    </div>
  </section>

  <section class="section" aria-labelledby="tools-heading">
    <div class="row row-phi">
      <div class="card tools">
        <span class="tag muted">The toolkit</span>
        <h2 class="h3" id="tools-heading">What I reach for</h2>
        <p class="body muted tools-note">
          Grouped by depth, not by preference.
        </p>

        <div class="tool-groups">
          {stack.map((g) => (
            <div>
              <p class="hand tool-group">{g.group}</p>
              <ul class="chip-list">
                {g.items.map((i) => <li class="tag chip chip-solid">{i}</li>)}
              </ul>
            </div>
          ))}
        </div>
      </div>

      <div class="card card-bare facts">
        <dl class="fact-list">
          {facts.map((f) => (
            <div class="fact">
              <dt class="tag muted">{f.label}</dt>
              <dd>{f.value}</dd>
            </div>
          ))}
        </dl>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* The mark at 1, the story at φ². */
  .opener {
    display: grid;
    grid-template-columns: 1fr 2.618fr;
    gap: var(--grid-gap);
  }

  .head { justify-content: center; }
  .head-lead { max-width: 62ch; opacity: 0.88; }

  .beats { margin: 0; padding: 0; list-style: none; }
  .beat-when { color: var(--live-ink); }
  .beat-body { max-width: 52ch; }

  .belief-note { opacity: 0.75; }
  .belief-body { max-width: 48ch; }

  .tools-note { max-width: 52ch; }

  .tool-groups {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr));
    gap: var(--sp-3) var(--sp-4);
    margin-top: var(--sp-2);
  }

  .tool-group { margin-bottom: var(--sp-1); color: var(--ink-soft); }

  .fact-list {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--sp-3);
  }

  .fact { display: flex; flex-direction: column; gap: 4px; }
  .fact dd { margin: 0; }

  @media (max-width: 899px) {
    .opener { grid-template-columns: 1fr; }
  }
</style>
