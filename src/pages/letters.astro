---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import CommandPalette from '../components/CommandPalette.astro';

const posts = [
  {
    title: "Building CourtVision: A 26-Week Solo Journey",
    date: "2026-07-01",
    excerpt: "Reflections on building a basketball analytics platform from scratch — the wins, the setbacks, and everything in between.",
    slug: "building-courtvision",
  },
  {
    title: "Why I Chose Astro for My Portfolio",
    date: "2026-06-15",
    excerpt: "After trying Next.js, Vite, and plain HTML, here's why Astro became the foundation for my personal site.",
    slug: "why-astro",
  },
  {
    title: "The Art of Shipping Solo Projects",
    date: "2026-06-01",
    excerpt: "Perfectionism is the enemy of shipping. Here's how I learned to ship early and iterate often.",
    slug: "shipping-solo-projects",
  },
];
---

<Layout title="Letters — Erioluwa">
  <Navbar />
  <CommandPalette />

  <main class="letters-page">
    <header class="letters-header">
      <h1 class="letters-title">Letters</h1>
      <p class="letters-subtitle">Thoughts on building, learning, and shipping.</p>
    </header>

    <div class="letters-list">
      {posts.map((post) => (
        <article class="letter-card">
          <time class="letter-date">{new Date(post.date).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</time>
          <h2 class="letter-title">
            <a href={`/letters/${post.slug}`}>{post.title}</a>
          </h2>
          <p class="letter-excerpt">{post.excerpt}</p>
          <a href={`/letters/${post.slug}`} class="letter-link">Read more &rarr;</a>
        </article>
      ))}
    </div>

    <Footer />
  </main>
</Layout>

<style>
  .letters-page {
    padding-top: 72px;
    padding-left: 200px;
    padding-right: 4rem;
    position: relative;
    z-index: 1;
    min-height: 100vh;
  }

  .letters-header {
    margin-bottom: 4rem;
  }

  .letters-title {
    font-size: 2.5rem;
    color: #f0ebe3;
    font-weight: 700;
    margin-bottom: 0.5rem;
    letter-spacing: -0.5px;
  }

  .letters-subtitle {
    font-size: 1.1rem;
    color: #666;
    font-style: italic;
  }

  .letters-list {
    display: flex;
    flex-direction: column;
    gap: 3rem;
    max-width: 640px;
  }

  .letter-card {
    border-bottom: 1px solid #1a1a1a;
    padding-bottom: 2.5rem;
  }

  .letter-card:last-child {
    border-bottom: none;
  }

  .letter-date {
    font-size: 0.8rem;
    color: #555;
    letter-spacing: 1px;
    text-transform: uppercase;
    display: block;
    margin-bottom: 0.75rem;
  }

  .letter-title {
    font-size: 1.5rem;
    color: #f0ebe3;
    font-weight: 600;
    margin-bottom: 0.75rem;
    line-height: 1.3;
  }

  .letter-title a {
    color: inherit;
    text-decoration: none;
    transition: color 0.15s;
  }

  .letter-title a:hover {
    color: #00DC82;
  }

  .letter-excerpt {
    font-size: 1rem;
    color: #888;
    line-height: 1.6;
    margin-bottom: 1rem;
  }

  .letter-link {
    font-size: 0.85rem;
    color: #555;
    text-decoration: none;
    letter-spacing: 0.5px;
    transition: color 0.15s;
  }

  .letter-link:hover {
    color: #00DC82;
  }
</style>
