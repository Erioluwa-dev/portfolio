---
import Layout from '../layouts/Layout.astro';
import { letters } from '../data/site';

const fmt = (d: string) =>
  new Date(d).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
---

<Layout
  title="Letters — Fawehinmi Erioluwa"
  description="Notes on building solo, shipping under constraints, and the tools that earn their place."
>
  <header class="page-head">
    <h1 class="display" id="letters-heading">Notes from inside the build.</h1>
    <p class="lead">
      Written while the work was still messy, not cleaned up afterwards.
      Mostly about scope, constraints, and what actually shipped.
    </p>
  </header>

  <section aria-label="All letters">
    <ul class="rows">
      {letters.map((l) => (
        <li>
          <a class="letter" href={`/letters/${l.slug}`}>
            <time class="small faint" datetime={l.date}>{fmt(l.date)}</time>
            <h2 class="h2 letter-title">{l.title}</h2>
            <p class="muted excerpt">{l.excerpt}</p>
          </a>
        </li>
      ))}
    </ul>
  </section>
</Layout>

<style>
  .page-head { display: flex; flex-direction: column; gap: 1.25rem; }

  .letter {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 2.25rem 0;
    text-decoration: none;
  }

  .letter-title {
    max-width: 24ch;
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-decoration-color: transparent;
    text-underline-offset: 0.18em;
    transition: text-decoration-color 0.15s ease;
  }

  .letter:hover .letter-title { text-decoration-color: var(--yellow); }

  .excerpt { margin: 0; max-width: 38em; }
</style>
