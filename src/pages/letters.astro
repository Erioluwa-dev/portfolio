---
import Layout from '../layouts/Layout.astro';
import { letters } from '../data/site';

const fmt = (d: string) =>
  new Date(d).toLocaleDateString('en-GB', { day: '2-digit', month: 'long', year: 'numeric' });

const arrow = "M5 12h13M13 6l6 6-6 6";
---

<Layout
  title="Letters — Fawehinmi Erioluwa"
  description="Notes on building solo, shipping under constraints, and the tools that earn their place."
>
  <section class="panel panel-md" aria-labelledby="letters-heading">
    <div class="card card-amber head">
      <span class="tag">Letters</span>
      <h1 class="display" id="letters-heading">Notes from inside the build.</h1>
      <p class="lead head-lead">
        Written while the work was still messy, not cleaned up afterwards.
        Mostly about scope, constraints, and what actually shipped.
      </p>
    </div>
  </section>

  {letters.map((l) => (
    <section class="panel panel-sm" aria-label={l.title}>
      <a class="card letter" href={`/letters/${l.slug}`}>
        <span class="tag muted">{fmt(l.date)}</span>
        <h2 class="h2 letter-title">{l.title}</h2>
        <p class="lead letter-excerpt muted">{l.excerpt}</p>
        <span class="link-arrow letter-cta">
          Read it
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d={arrow} />
          </svg>
        </span>
      </a>
    </section>
  ))}
</Layout>

<style>
  .head { justify-content: safe center; }
  .head-lead { max-width: 42ch; opacity: 0.86; }

  .letter {
    justify-content: safe center;
    text-decoration: none;
    transition: transform 0.18s ease, border-color 0.18s ease;
  }

  .letter:hover { transform: translateY(-3px); border-color: var(--live-ink); }
  .letter:hover .letter-title { color: var(--live-ink); }

  .letter-title { max-width: 18ch; transition: color 0.18s ease; }
  .letter-excerpt { max-width: 40ch; }
  .letter-cta { margin-top: var(--sp-1); }
</style>
