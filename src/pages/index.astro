---
import Layout from '../layouts/Layout.astro';
import Project from '../components/Project.astro';
import { projects, layers, kit, machine, letters, social, preface, principles } from '../data/site';

const featured = projects.filter((p) => p.featured !== undefined);

const roman = ['I', 'II', 'III', 'IV', 'V', 'VI', 'VII', 'VIII', 'IX', 'X'];
const numeral = (n: number) => roman[n - 1] ?? String(n);

const fmt = (d: string) =>
  new Date(d).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
---

<Layout title="Fawehinmi Erioluwa — Product Engineer">
  <header class="hero">
    <div class="hero-top">
      <p class="hand hello">Hi, I'm Eri.</p>
      <p class="kicker">Fawehinmi Erioluwa · Product engineer · Lagos</p>
    </div>
    <h1 class="hero-title">I build whole products, not just <mark>the part you can see</mark>.</h1>
    <div class="hero-foot">
      <p class="lead">Interfaces first, which is where I am deepest. Then the API, the data, and the machine learning underneath.</p>
      <div class="actions">
        <a class="btn" href="#work">See the work</a>
        <a class="btn btn-quiet" href="/about">About</a>
      </div>
    </div>
  </header>

  <section class="section" id="work" aria-labelledby="work-heading">
    <div class="chapter-mark">
      <span class="numeral">Chapter {numeral(1)}</span>
    </div>
    <h2 class="h2" id="work-heading">Selected work</h2>
    <ol class="project-list" aria-label="Selected projects">
      {featured.map((p, i) => <li><Project project={p} variant="feature" level={3} index={i} /></li>)}
    </ol>
    <a class="link more" href="/projects">Every project, in full →</a>
  </section>

  <section class="band band-dark section" aria-labelledby="layers-heading">
    <div class="chapter-mark">
      <span class="numeral">Chapter {numeral(2)}</span>
    </div>
    <div class="layers">
      <div class="layers-text">
        <h2 class="h2" id="layers-heading">The layers</h2>
        <p class="lead muted">Top to bottom, the way a request travels: what someone touches first, then everything underneath that has to hold for it to work.</p>
      </div>
      <ol class="strata">
        {layers.map((l, i) => (
          <li>
            <span><b>{l.name}</b><span class="role">{l.role}</span></span>
            <span>{l.tools.join(', ')}</span>
            {i === 0 && <span class="tag" aria-hidden="true">the part you can see</span>}
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section" id="kit" aria-labelledby="kit-heading">
    <div class="chapter-mark">
      <span class="numeral">Chapter {numeral(3)}</span>
    </div>
    <h2 class="h2" id="kit-heading">The kit</h2>
    <div class="kit">
      <dl class="kit-list">
        {kit.map((k) => (
          <div class="kit-row">
            <dt class="kicker">{k.label}</dt>
            <dd><ul class="chips">{k.items.map((item) => <li>{item}</li>)}</ul></dd>
          </div>
        ))}
      </dl>
      <aside class="machine" aria-labelledby="machine-heading">
        <p class="kicker">The machine</p>
        <h3 class="machine-name" id="machine-heading">{machine.name}</h3>
        <dl class="specs">
          {machine.specs.map((s) => (
            <div class="spec"><dt>{s.label}</dt><dd>{s.value}</dd></div>
          ))}
        </dl>
        <p class="hand machine-note">This site was built on it.</p>
      </aside>
    </div>
  </section>

  <section class="section" aria-labelledby="preface-heading">
    <div class="chapter-mark">
      <span class="numeral">Preface</span>
    </div>
    <div class="preface">
      <div class="preface-text">
        <h2 class="sr-only" id="preface-heading">Preface</h2>
        <p class="pull">{preface.hook} <mark>{preface.hookMark}</mark>.</p>
        <p class="muted prose-body">{preface.body}</p>
        <div class="sign"><span class="sign-name">Eri</span><span>Product engineer</span></div>
      </div>
      <div class="principles">
        <h3 class="kicker">How I work</h3>
        <ol class="rows">
          {principles.map((p, i) => (
            <li class="principle">
              <span class="numeral" aria-hidden="true">{numeral(i + 1).toLowerCase()}.</span>
              <div>
                <h4 class="h3">{p.title}</h4>
                <p class="muted">{p.body}</p>
              </div>
            </li>
          ))}
        </ol>
        <a class="link more" href="/about">Learn more →</a>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="letters-heading">
    <div class="chapter-mark">
      <span class="numeral">Chapter {numeral(4)}</span>
    </div>
    <h2 class="h2" id="letters-heading">Letters</h2>
    <ul class="rows">
      {letters.slice(0, 3).map((l) => (
        <li>
          <a class="letter" href={`/letters/${l.slug}`}>
            <time class="small faint" datetime={l.date}>{fmt(l.date)}</time>
            <h3 class="h3 letter-title">{l.title}</h3>
            <p class="muted">{l.excerpt}</p>
          </a>
        </li>
      ))}
    </ul>
    <a class="link more" href="/letters">All letters →</a>
  </section>

  <section class="band band-yellow back" aria-labelledby="back-heading">
    <p class="kicker">Back cover</p>
    <h2 class="display back-title" id="back-heading">Tell me what it needs to do.</h2>
    <p class="lead muted">Open to product and full-stack roles, frontend-heavy work, and collaborations where the constraints are real.</p>
    <div class="actions">
      <a class="btn mail" href={`mailto:${social.email}`}>{social.email}</a>
    </div>
    <p class="contacts">
      <a class="link" href={social.github} target="_blank" rel="noopener noreferrer">GitHub</a>
      <a class="link" href={social.instagram} target="_blank" rel="noopener noreferrer">Instagram</a>
      <a class="link" href="/contact">Other ways to reach me</a>
    </p>
    <p class="small muted colophon">Set in Archivo, Newsreader and Kalam, proportioned by φ. Hand-built in Astro, with no framework runtime and no analytics.</p>
  </section>
</Layout>

<style>
  /* The yellow band closes the page, so it meets the footer instead of
     leaving the column's bottom padding as a gap above it. */
  :global(.page:has(> .back:last-child)) { padding-bottom: 0; }

  /* The hero runs the full width of the column: the headline reads across
     in a few long lines instead of stacking down the left. */
  .hero { display: flex; flex-direction: column; gap: clamp(1.5rem, 3vw, 2.5rem); }

  .hero-top {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.5rem 2rem;
  }

  .hello { font-size: clamp(1.5rem, 1rem + 2vw, 2.25rem); line-height: 1; color: var(--ink); }

  .hero-title {
    margin: 0;
    font-size: clamp(2.5rem, 0.5rem + 6.2vw, 6.25rem);
    font-weight: 800;
    font-stretch: 118%;
    line-height: 1;
    letter-spacing: -0.03em;
    text-wrap: pretty;
  }

  .hero-foot {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1.5rem 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
  }

  .hero-foot .lead { flex: 1 1 28rem; }

  /* ── The kit ── */
  .kit {
    display: grid;
    grid-template-columns: minmax(0, 1.618fr) minmax(0, 1fr);
    gap: 2rem 4rem;
    align-items: start;
  }

  .kit-list { margin: 0; border-top: 1px solid var(--line); }

  .kit-row {
    display: grid;
    grid-template-columns: 10rem minmax(0, 1fr);
    gap: 0.5rem 1.5rem;
    align-items: baseline;
    padding: 1rem 0;
    border-bottom: 1px solid var(--line);
  }

  .kit-row dd { margin: 0; }

  .chips { display: flex; flex-wrap: wrap; gap: 0.4rem; margin: 0; padding: 0; list-style: none; }

  .chips li {
    padding: 0.1rem 0.65rem;
    border: 1px solid var(--line-strong);
    border-radius: 99px;
    font-size: var(--fs-sm);
  }

  .machine {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 1.5rem;
    border-radius: var(--r-lg);
    background: var(--yellow);
    color: var(--on-yellow);
  }

  .machine .kicker { color: inherit; opacity: 0.75; }

  .machine-name {
    margin: 0;
    font-size: clamp(1.75rem, 1rem + 2vw, 2.5rem);
    font-weight: 800;
    font-stretch: 112%;
    line-height: 1;
    letter-spacing: -0.02em;
  }

  .specs { margin: 0.25rem 0 0; }

  .spec {
    display: grid;
    grid-template-columns: 6.5rem 1fr;
    gap: 1rem;
    padding: 0.55rem 0;
    border-top: 1px solid color-mix(in oklab, var(--on-yellow), transparent 75%);
    font-size: var(--fs-sm);
  }

  .spec dt { font-weight: 700; }
  .spec dd { margin: 0; }
  .machine-note { color: inherit; }

  .project-list { position: relative; margin: 0; padding: 0; list-style: none; border-bottom: 1px solid var(--line); }
  .more { align-self: flex-start; font-weight: 600; }

  /* ── The layers ── */
  .layers {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.618fr);
    gap: 2rem 4rem;
    align-items: start;
  }

  .layers-text { display: flex; flex-direction: column; gap: 1rem; }

  /* The strata sit on paper so their steps keep the contrast they were
     tuned for, whichever way the band is inverted. */
  .strata {
    margin: 0;
    padding: 0;
    overflow: hidden;
    border-radius: var(--r-sm);
    background: var(--paper);
    color: var(--ink);
    list-style: none;
  }

  .strata li {
    position: relative;
    display: grid;
    grid-template-columns: 38.2% 1fr;
    gap: 0.5rem 1rem;
    padding: 0.9rem 1.25rem;
    font-size: var(--fs-sm);
  }

  .strata b { display: block; font-size: 1rem; }
  .strata .role { font-size: 0.75rem; color: var(--ink-3); }
  .strata li:nth-child(1) { background: var(--yellow); color: var(--on-yellow); }
  .strata li:nth-child(1) .role { color: var(--on-yellow); opacity: 0.75; }
  .strata li:nth-child(2) { background: var(--stratum-2); }
  .strata li:nth-child(3) { background: var(--stratum-3); }
  .strata li:nth-child(4) { background: var(--stratum-4); }
  .strata li:nth-child(5) { background: var(--stratum-5); }

  .tag {
    position: absolute;
    right: 1.25rem;
    top: 50%;
    transform: translateY(-50%) rotate(-3deg);
    font-family: var(--hand);
    font-size: 0.875rem;
  }

  /* ── Preface ── */
  .preface {
    display: grid;
    grid-template-columns: minmax(0, 1.618fr) minmax(0, 1fr);
    gap: 3rem 4rem;
    align-items: start;
  }

  .preface-text { display: flex; flex-direction: column; gap: 1.5rem; }
  .preface-text p { margin: 0; }

  .pull {
    font-size: clamp(1.375rem, 1rem + 1.4vw, 2rem);
    font-weight: 750;
    font-stretch: 108%;
    line-height: 1.3;
    letter-spacing: -0.01em;
    text-wrap: balance;
  }

  .prose-body { font-family: var(--serif); font-size: var(--fs-lead); line-height: 1.618; max-width: 34em; }

  .sign { display: flex; align-items: center; gap: 1rem; padding-top: 1rem; border-top: 1px solid var(--line); }
  .sign span { font-size: 0.75rem; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: var(--ink-3); }
  .sign .sign-name { font-family: var(--hand); font-size: 1.75rem; font-weight: 400; letter-spacing: 0; text-transform: none; color: var(--ink); }

  .principles { display: flex; flex-direction: column; gap: 1rem; }
  .principle { display: grid; grid-template-columns: 2rem 1fr; gap: 0.5rem; padding: 1.25rem 0; }
  .principle .numeral { font-size: 1.125rem; color: var(--ink-3); }
  .principle .h3 { font-size: 1.25rem; }
  .principle p { margin: 0.35rem 0 0; font-size: var(--fs-sm); }

  /* ── Letters ── */
  .letter { display: flex; flex-direction: column; gap: 0.35rem; padding: 1.5rem 0; text-decoration: none; }
  .letter p { margin: 0; max-width: 38em; }

  .letter-title {
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-decoration-color: transparent;
    text-underline-offset: 0.18em;
    transition: text-decoration-color 0.15s ease;
  }

  .letter:hover .letter-title { text-decoration-color: var(--yellow); }

  /* ── Back cover ── */
  .back { display: flex; flex-direction: column; align-items: flex-start; gap: 1.25rem; }
  .back-title { max-width: 14ch; }
  .back .lead, .back p { margin: 0; }
  .mail { overflow-wrap: anywhere; }
  .contacts { display: flex; flex-wrap: wrap; gap: 0.5rem 1.5rem; }
  .colophon { max-width: 38em; padding-top: 1.25rem; border-top: 1px solid color-mix(in oklab, var(--on-yellow), transparent 75%); }

  @media (max-width: 859px) {
    .layers, .preface, .kit { grid-template-columns: 1fr; }
    .kit-row { grid-template-columns: 1fr; }
    .strata li { grid-template-columns: 1fr; gap: 2px; }
    .tag { position: static; justify-self: start; transform: rotate(-3deg); }
  }
</style>
