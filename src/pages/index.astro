---
import Layout from '../layouts/Layout.astro';
import Project from '../components/Project.astro';
import { projects, layers, learning, letters, social } from '../data/site';

const recent = letters.slice(0, 2);

const fmt = (d: string) =>
  new Date(d).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
---

<Layout title="Fawehinmi Erioluwa — Product Engineer">
  <section class="hero" aria-labelledby="thesis">
    <p class="hand">Hi — I'm Eri.</p>
    <h1 class="display" id="thesis">I build whole products, not just the part you can see.</h1>

    <div class="intro">
      <p class="lead">
        Product engineer in Lagos, Nigeria. Interfaces first — that is where
        I am deepest — then the API, the data, and the machine learning
        underneath.
      </p>
      <div class="actions">
        <a class="btn" href={`mailto:${social.email}`}>Email me</a>
        <a class="btn btn-quiet" href="/projects">See the work</a>
      </div>
    </div>

    <figure class="strata" aria-labelledby="strata-caption">
      <ol class="layers">
        {layers.map((l, i) => (
          <li class="layer" style={`--i:${i}`}>
            <span class="layer-name">{l.name}</span>
            <span class="layer-role">{l.role}</span>
            <span class="layer-tools">{l.tools.join(", ")}</span>
            {i === 0 && <span class="hand layer-note" aria-hidden="true">the part you can see</span>}
          </li>
        ))}
      </ol>
      <figcaption id="strata-caption" class="small muted">
        The layers of a product and what I build each one with. Learning now: {learning.join(" and ")}.
      </figcaption>
    </figure>
  </section>

  <section class="section" aria-labelledby="work-heading">
    <div class="section-head">
      <h2 class="h2" id="work-heading">Things I've built</h2>
      <a class="link" href="/projects">All projects</a>
    </div>

    <ul class="rows">
      {projects.map((p) => <li><Project project={p} /></li>)}
    </ul>
  </section>

  <section class="section" aria-labelledby="letters-heading">
    <div class="section-head">
      <h2 class="h2" id="letters-heading">Letters</h2>
      <a class="link" href="/letters">Read all</a>
    </div>

    <ul class="rows">
      {recent.map((l) => (
        <li>
          <a class="letter" href={`/letters/${l.slug}`}>
            <span class="h3 letter-title">{l.title}</span>
            <span class="small faint">{fmt(l.date)}</span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section class="closing" aria-labelledby="contact-heading">
    <h2 class="display closing-title" id="contact-heading">Tell me what it needs to do.</h2>
    <p class="lead">
      Open to product and full-stack roles, frontend-heavy work, and
      collaborations where the constraints are real.
    </p>
    <div class="actions">
      <a class="btn btn-yellow" href={`mailto:${social.email}`}>{social.email}</a>
      <a class="btn btn-quiet" href="/contact">Other ways to reach me</a>
    </div>
  </section>
</Layout>

<style>
  .hero { display: flex; flex-direction: column; gap: 1.5rem; }

  .hero .display { max-width: 15ch; }

  .intro {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.5rem 3rem;
    margin-top: 0.5rem;
  }

  .intro .lead { max-width: 30em; }

  /* ═══ The cross-section ════════════════════════════════════
     The one loud thing on the site. The headline claims the work goes
     below the surface; this draws the surface and what sits under it. */

  .strata { margin: clamp(2rem, 1rem + 3vw, 4rem) 0 0; }

  .layers {
    margin: 0 0 1rem;
    padding: 0;
    list-style: none;
    border-radius: var(--r-lg);
    overflow: hidden;
  }

  .layer {
    display: grid;
    grid-template-columns: 11rem 11rem 1fr auto;
    align-items: baseline;
    gap: 0.25rem 1.5rem;
    padding: 1.1rem 1.5rem;
    background: var(--stratum-5);
    animation: wipe 0.7s cubic-bezier(0.2, 0.7, 0.2, 1) both;
    animation-delay: calc(0.15s + var(--i) * 0.08s);
  }

  .layer:nth-child(1) { background: var(--yellow); color: var(--on-yellow); padding-block: 1.6rem; }
  .layer:nth-child(2) { background: var(--stratum-2); }
  .layer:nth-child(3) { background: var(--stratum-3); }
  .layer:nth-child(4) { background: var(--stratum-4); }

  .layer-name {
    font-weight: 700;
    font-stretch: 108%;
    font-size: 1.0625rem;
  }

  .layer-role { color: var(--ink-2); font-size: var(--fs-sm); }
  .layer:nth-child(1) .layer-role { color: inherit; opacity: 0.8; }

  .layer-tools { font-size: 1rem; }

  .layer-note {
    color: inherit;
    font-size: 1.1rem;
    opacity: 0.8;
    transform: rotate(-3deg);
  }

  @keyframes wipe {
    from { clip-path: inset(0 100% 0 0); }
    to   { clip-path: inset(0 0 0 0); }
  }

  /* ═══ Letters ═══ */

  .letter {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem 2rem;
    flex-wrap: wrap;
    padding: 1.5rem 0;
    text-decoration: none;
  }

  .letter-title {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-decoration-color: transparent;
    text-underline-offset: 0.2em;
    transition: text-decoration-color 0.15s ease;
  }

  .letter:hover .letter-title { text-decoration-color: currentColor; }

  /* ═══ Closing ═══ */

  .closing { display: flex; flex-direction: column; gap: 1.5rem; }
  .closing-title { font-size: clamp(2.25rem, 1rem + 4.5vw, 4.25rem); max-width: 14ch; }
  .closing .btn-yellow { overflow-wrap: anywhere; }

  @media (max-width: 859px) {
    .layer { grid-template-columns: 1fr; padding: 1rem 1.25rem; }
    .layer:nth-child(1) { padding-block: 1.25rem; }
    .layer-note { justify-self: end; margin-top: 0.25rem; }
  }
</style>
