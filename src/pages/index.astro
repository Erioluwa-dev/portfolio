---
import Layout from '../layouts/Layout.astro';
import Arrow from '../components/Arrow.astro';
import Clock from '../components/Clock.astro';
import {
  projects,
  layers,
  letters,
  social,
  preface,
  principles,
  statusLabel,
  type Project,
  type Featured,
} from '../data/site';

type FeaturedProject = Project & { featured: Featured };

const featured = projects.filter((p): p is FeaturedProject => p.featured !== undefined);
const [lead, ...rest] = featured;
const latest = letters[0];

const fmt = (d: string) =>
  new Date(d).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });

const host = (url: string) => new URL(url).host.replace(/^www\./, '');
---

<Layout title="Fawehinmi Erioluwa — Product Engineer">
  <h1 class="sr-only">Fawehinmi Erioluwa, product engineer in Lagos</h1>

  <div class="board">
    <!-- Intro -->
    <section class="w m-4 c-8 r-2 hero" style="--d:0" aria-label="Introduction">
      <p class="w-label">Fawehinmi Erioluwa · Product engineer · Lagos</p>
      <p class="hero-title">I build whole products, not just the part you can see.</p>
      <p class="w-text hero-body">
        Interfaces first, which is where I am deepest. Then the API, the data,
        and the machine learning underneath.
      </p>
      <div class="actions w-foot">
        <a class="btn" href="/projects">See the work</a>
        <a class="btn btn-quiet" href="/contact">Get in touch</a>
      </div>
    </section>

    <a class="w m-2 c-4 w-square hello" href="/about" style="--d:1">
      <Arrow />
      <img class="hello-mark" src="/brand.jpg" alt="" width="538" height="570" />
      <p class="w-hand w-foot">Hi, I'm Eri.</p>
    </a>

    <section class="w m-2 c-4 w-square w-dark time" style="--d:2" aria-label="Time in Lagos">
      <p class="w-label">Lagos · WAT</p>
      <p class="w-big" data-clock="time">--:--</p>
      <p class="w-text small w-foot" data-clock="day">&nbsp;</p>
    </section>

    <!-- Work -->
    <a class="w m-4 c-7 r-2 work work-lead" href={lead.live ?? '/projects'} target={lead.live ? '_blank' : undefined} rel={lead.live ? 'noopener noreferrer' : undefined} style="--d:3">
      <Arrow />
      <p class="w-label"><span class="dot" aria-hidden="true"></span> {lead.featured.statusShort} · {lead.kind}</p>
      <h2 class="w-title">{lead.name}</h2>
      <p class="w-text">{lead.summary}</p>
      {lead.image && (
        <figure class="shot">
          <span class="chrome" aria-hidden="true"><i></i><i></i><i></i>{lead.live && <b>{host(lead.live)}</b>}</span>
          <img src={lead.image.src} alt={lead.image.alt} width="3840" height="2160" loading="lazy" decoding="async" />
        </figure>
      )}
    </a>

    {rest.map((p, i) => (
      <a class="w m-4 c-5 work" href={p.live ?? '/projects'} target={p.live ? '_blank' : undefined} rel={p.live ? 'noopener noreferrer' : undefined} style={`--d:${4 + i}`}>
        <Arrow />
        {p.image && (
          <figure class="shot">
            <img src={p.image.src} alt={p.image.alt} width="3840" height="2160" loading="lazy" decoding="async" />
          </figure>
        )}
        <p class="w-label" title={statusLabel[p.status]}>
          {(p.status === 'live' || p.status === 'shipped') && <span class="dot" aria-hidden="true"></span>}
          {p.featured.statusShort} · {p.kind}
        </p>
        <h2 class="w-title">{p.name}</h2>
      </a>
    ))}

    <!-- How I work -->
    <section class="w m-4 c-7 layers" style="--d:6" aria-labelledby="layers-h">
      <p class="w-label">The layers</p>
      <h2 class="w-title" id="layers-h">Top to bottom, the way a request travels.</h2>
      <ol class="strata">
        {layers.map((l, i) => (
          <li style={`--i:${i}`}>
            <span class="s-name">{l.name}</span>
            <span class="s-role">{l.role}</span>
            <span class="s-tools">{l.tools.join(' · ')}</span>
          </li>
        ))}
      </ol>
    </section>

    <section class="w m-4 c-5 w-dark principle" style="--d:7" aria-labelledby="principle-h">
      <p class="w-label">How I work · i.</p>
      <h2 class="w-title" id="principle-h">{principles[0].title}</h2>
      <p class="w-text">{principles[0].body}</p>
      <ul class="others w-foot">
        {principles.slice(1).map((p) => <li><b>{p.title}.</b> {p.body}</li>)}
      </ul>
    </section>

    <a class="w m-4 c-6 preface" href="/about" style="--d:8">
      <Arrow />
      <p class="w-label">Preface</p>
      <p class="pull">{preface.hook} <mark>{preface.hookMark}</mark>.</p>
      <p class="w-text">{preface.body}</p>
    </a>

    <a class="w m-2 c-3 letter" href={`/letters/${latest.slug}`} style="--d:9">
      <Arrow />
      <p class="w-label">Latest letter</p>
      <h2 class="w-title letter-title">{latest.title}</h2>
      <time class="small faint w-foot" datetime={latest.date}>{fmt(latest.date)}</time>
    </a>

    <section class="w m-2 c-3 w-yellow open" style="--d:10" aria-label="Availability">
      <p class="w-label"><span class="dot" aria-hidden="true"></span> Available</p>
      <p class="w-title">Open to product and full-stack roles.</p>
      <a class="link w-foot small" href="/contact">How to reach me</a>
    </section>

    <!-- Contact -->
    <section class="w m-4 c-8 w-dark cta" style="--d:11" aria-labelledby="cta-h">
      <p class="w-label">Back cover</p>
      <h2 class="cta-title" id="cta-h">Tell me what it needs to do.</h2>
      <p class="w-text">Open to product and full-stack roles, frontend-heavy work, and collaborations where the constraints are real.</p>
      <div class="actions w-foot">
        <a class="btn btn-yellow mail" href={`mailto:${social.email}`}>{social.email}</a>
        <button class="btn btn-ghost" type="button" data-copy={social.email}><span data-copy-label>Copy email</span></button>
      </div>
    </section>

    <section class="w m-4 c-4 clock-w" style="--d:12" aria-label="Elsewhere">
      <div class="clock-row">
        <Clock />
        <div>
          <p class="w-label">Right now in Lagos</p>
          <p class="w-title" data-clock="status">&nbsp;</p>
        </div>
      </div>
      <ul class="elsewhere w-foot">
        <li><a href={social.github} target="_blank" rel="noopener noreferrer">GitHub <span aria-hidden="true">↗</span></a></li>
        <li><a href={social.instagram} target="_blank" rel="noopener noreferrer">Instagram <span aria-hidden="true">↗</span></a></li>
        <li><a href="/letters">Letters <span aria-hidden="true">→</span></a></li>
      </ul>
    </section>
  </div>
</Layout>

<style>
  /* Intro */
  .hero { justify-content: flex-start; gap: 1.25rem; padding: clamp(1.5rem, 1rem + 2.5vw, 3rem); background: var(--paper); }

  .hero-title {
    margin: 0;
    font-size: clamp(2.25rem, 1.2rem + 4vw, 4.5rem);
    font-weight: 800;
    font-stretch: 112%;
    line-height: 0.98;
    letter-spacing: -0.03em;
    text-wrap: balance;
    max-width: 14ch;
  }

  .hero-body { font-size: var(--fs-lead); max-width: 30em; }

  .hello { background: var(--paper); }

  .hello-mark {
    width: clamp(3rem, 2rem + 4vw, 5rem);
    height: auto;
    filter: grayscale(1) brightness(1.1) contrast(1.5);
    mix-blend-mode: multiply;
  }

  :global(html[data-theme="dark"]) .hello-mark {
    filter: grayscale(1) brightness(1.1) contrast(1.5) invert(1);
    mix-blend-mode: screen;
  }

  .time .w-big { margin-top: auto; }
  .time .w-foot { margin-top: 0; }

  /* Work */
  .work { padding-bottom: 0; }
  .work .w-title { padding-right: 2.5rem; }

  .shot {
    margin: auto calc(var(--w-pad) * -0.4) 0;
    border: 1px solid var(--line);
    border-bottom: 0;
    border-radius: 12px 12px 0 0;
    overflow: hidden;
    background: var(--tile-2);
  }

  .shot img { width: 100%; height: auto; aspect-ratio: 16 / 9; object-fit: cover; object-position: top; transition: transform 0.5s ease; }
  .work:hover .shot img { transform: scale(1.025); }

  /* Smaller project widgets put the picture first, framed at the top. */
  .work:not(.work-lead) { padding-top: 0; padding-bottom: var(--w-pad); }
  .work:not(.work-lead) .shot { margin: 0 calc(var(--w-pad) * -1) 0.25rem; border: 0; border-radius: 0; border-bottom: 1px solid var(--line); }
  .work:not(.work-lead) .w-arrow { background: var(--tile); color: var(--ink); }

  .chrome {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 0.55rem 0.75rem;
    border-bottom: 1px solid var(--line);
    background: var(--tile);
  }

  .chrome i { width: 9px; height: 9px; border-radius: 50%; background: var(--line-strong); }
  .chrome b { margin-left: 0.6rem; font-size: 0.75rem; font-weight: 500; color: var(--ink-3); }

  /* Layers: each stratum a step darker, the way they are on the page. */
  .strata { display: flex; flex-direction: column; gap: 4px; margin: 0.25rem 0 0; padding: 0; list-style: none; }

  .strata li {
    display: grid;
    grid-template-columns: 7.5rem 1fr;
    gap: 0 1rem;
    padding: 0.6rem 0.85rem;
    border-radius: 10px;
    background: var(--stratum-2);
  }

  .strata li:nth-child(1) { background: var(--yellow); color: var(--on-yellow); }
  .strata li:nth-child(1) .s-role, .strata li:nth-child(1) .s-tools { color: var(--on-yellow); }
  .strata li:nth-child(3) { background: var(--stratum-3); }
  .strata li:nth-child(4) { background: var(--stratum-4); }
  .strata li:nth-child(5) { background: var(--stratum-5); }

  .s-name { font-weight: 700; }
  .s-role { font-size: var(--fs-sm); color: var(--ink-3); grid-row: 2; }
  .s-tools { grid-row: span 2; align-self: center; font-size: var(--fs-sm); color: var(--ink-2); }

  .principle .w-title { font-size: clamp(1.5rem, 1.1rem + 1.4vw, 2.1rem); }

  .others { display: flex; flex-direction: column; gap: 0.75rem; margin-top: 1rem; padding: 1rem 0 0; list-style: none; border-top: 1px solid color-mix(in srgb, var(--on-dark) 18%, transparent); font-size: var(--fs-sm); color: color-mix(in srgb, var(--on-dark) 78%, transparent); }
  .others b { color: var(--on-dark); font-weight: 600; }

  .pull {
    margin: 0;
    padding-right: 2.5rem;
    font-family: var(--serif);
    font-size: clamp(1.35rem, 1.1rem + 1vw, 1.75rem);
    line-height: 1.3;
    text-wrap: pretty;
  }

  .pull mark { background: var(--yellow); color: var(--on-yellow); padding: 0 0.15em; border-radius: 3px; }

  .letter-title { font-family: var(--serif); font-weight: 500; font-stretch: 100%; padding-right: 2rem; }

  .cta { padding: clamp(1.5rem, 1rem + 2vw, 2.5rem); }

  .cta-title {
    margin: 0;
    font-size: clamp(2rem, 1.2rem + 3vw, 3.5rem);
    font-weight: 800;
    font-stretch: 112%;
    line-height: 1;
    letter-spacing: -0.03em;
    max-width: 14ch;
  }

  .mail { overflow-wrap: anywhere; }

  .btn-ghost { background: transparent; color: var(--on-dark); border-color: color-mix(in srgb, var(--on-dark) 30%, transparent); }
  .btn-ghost:hover { background: transparent; border-color: var(--on-dark); }

  .clock-row { display: grid; grid-template-columns: 6.5rem 1fr; align-items: center; gap: 1.25rem; }

  .elsewhere { display: flex; flex-direction: column; margin: 0; padding: 0; list-style: none; border-top: 1px solid var(--line); }
  .elsewhere li { border-bottom: 1px solid var(--line); }
  .elsewhere li:last-child { border-bottom: 0; }

  .elsewhere a {
    display: flex;
    justify-content: space-between;
    align-items: center;
    min-height: 44px;
    font-weight: 500;
    text-decoration: none;
  }

  .elsewhere a:hover { text-decoration: underline; text-decoration-color: var(--yellow); text-decoration-thickness: 2px; text-underline-offset: 0.3em; }

  /* On wide screens the lead project spans two rows: let its screenshot
     take all the height that leaves instead of floating at the bottom. */
  @media (min-width: 980px) {
    .work-lead .shot { flex: 1 1 0; display: flex; flex-direction: column; min-height: 14rem; }
    .work-lead .shot img { flex: 1 1 0; min-height: 0; height: 100%; aspect-ratio: auto; }
  }

  @media (max-width: 719px) {
    .strata li { grid-template-columns: 1fr; }
    .s-tools { grid-row: auto; margin-top: 0.15rem; }
    .letter-title { font-size: 1.125rem; }
    .open .w-title { font-size: 1.125rem; }
  }
</style>
