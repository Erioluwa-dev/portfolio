---
import Layout from '../layouts/Layout.astro';
import PortraitCard from '../components/PortraitCard.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { projects, stack, letters, social } from '../data/site';

const recent = letters.slice(0, 2);

const arrow = "M5 12h13M13 6l6 6-6 6";
---

<Layout title="Fawehinmi Erioluwa — Product Engineer">
  <section class="section" aria-labelledby="thesis">
    <div class="opener">
      <PortraitCard />

      <div class="opener-stack">
        <div class="card card-amber card-hero intro">
          <p class="hand greeting">Hi — I'm Eri.</p>
          <h1 class="display" id="thesis">
            I build whole products, not just the part you can see.
          </h1>
          <p class="lead intro-lead">
            Product engineer in Lagos, Nigeria. Interfaces first — that is where
            I am deepest — then the API, the data, and the machine
            learning underneath.
          </p>
        </div>

        <div class="card open">
          <div class="open-text">
            <span class="tag muted">Open to</span>
            <p class="body open-body">
              Product and full-stack roles, frontend-heavy work, and
              collaborations where the constraints are real.
            </p>
          </div>
          <a class="btn open-btn" href="/contact">
            Start a conversation
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d={arrow} />
            </svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="work-heading">
    <div class="section-head">
      <h2 class="h2" id="work-heading">Things I've built</h2>
      <a class="link-arrow" href="/projects">
        All projects
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d={arrow} />
        </svg>
      </a>
    </div>

    <div class="grid">
      {projects.map((p) => <ProjectCard project={p} level={3} />)}
    </div>
  </section>

  <section class="section" aria-labelledby="toolkit-heading">
    <div class="card toolkit">
      <span class="tag muted">The toolkit</span>
      <h2 class="h2" id="toolkit-heading">What I reach for</h2>
      <p class="body muted toolkit-note">
        Ordered by depth, not by preference. The distance between the first
        group and the last one is the honest part.
      </p>

      <div class="tool-groups">
        {stack.map((g) => (
          <div>
            <p class="hand tool-group">{g.group}</p>
            <ul class="chip-list">
              {g.items.map((item) => <li class="tag chip chip-solid">{item}</li>)}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <div class="section">
    <div class="row">
      <section class="card letters" aria-labelledby="letters-heading">
        <span class="tag muted">Letters</span>
        <h2 class="h2" id="letters-heading">Notes from inside the build</h2>

        <ul class="letter-list">
          {recent.map((l) => (
            <li>
              <a class="letter" href={`/letters/${l.slug}`}>
                <span class="tag muted">
                  {new Date(l.date).toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' })}
                </span>
                <span class="letter-title">{l.title}</span>
              </a>
            </li>
          ))}
        </ul>

        <a class="link-arrow letters-all" href="/letters">
          Read all
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d={arrow} />
          </svg>
        </a>
      </section>

      <section class="card card-ink card-hero closing" aria-labelledby="contact-heading">
        <p class="hand closing-note">You made it to the end.</p>
        <h2 class="h2" id="contact-heading">Tell me what it needs to do.</h2>
        <a class="btn btn-amber closing-btn" href={`mailto:${social.email}`}>
          {social.email}
        </a>
        <a class="link-arrow closing-link" href="/contact">
          Other ways to reach me
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d={arrow} />
          </svg>
        </a>
      </section>
    </div>
  </div>
</Layout>

<style>
  /* The mark sits at 1, the claim at φ². */
  .opener {
    display: grid;
    grid-template-columns: 1fr 2.618fr;
    gap: var(--grid-gap);
    align-items: stretch;
  }

  .opener-stack {
    display: flex;
    flex-direction: column;
    gap: var(--grid-gap);
  }

  .intro { flex: 1; justify-content: center; }
  .greeting { opacity: 0.78; }
  .intro-lead { max-width: 56ch; }

  .open {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-3);
    flex-wrap: wrap;
  }

  .open-text { display: flex; flex-direction: column; gap: 6px; min-width: 18ch; }
  .open-body { color: var(--ink-soft); max-width: 42ch; }
  .open-btn { flex-shrink: 0; }

  .toolkit { padding: var(--pad-lg); }
  .toolkit-note { max-width: 52ch; }

  .tool-groups {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
    gap: var(--sp-4);
    margin-top: var(--sp-3);
  }

  .tool-group { margin-bottom: var(--sp-2); color: var(--ink-soft); }

  .letter-list {
    margin: var(--sp-1) 0 0;
    padding: 0;
    list-style: none;
  }

  .letter-list li + li { border-top: 1px solid var(--hairline); }

  .letter {
    display: flex;
    flex-direction: column;
    gap: 5px;
    padding: var(--sp-2) 0;
    text-decoration: none;
    transition: transform 0.18s ease;
  }

  .letter:hover { transform: translateX(5px); }
  .letter:hover .letter-title { color: var(--live-ink); }

  .letter-title {
    font-size: var(--fs-lead);
    font-weight: 400;
    line-height: 1.3;
    transition: color 0.18s ease;
  }

  .letters-all { margin-top: auto; }

  .closing { justify-content: center; }
  .closing-note { color: var(--amber); }
  .closing-btn { align-self: flex-start; margin-top: var(--sp-1); word-break: break-word; }
  .closing-link { opacity: 0.82; }

  @media (max-width: 899px) {
    .opener { grid-template-columns: 1fr; }
    .open { flex-direction: column; align-items: flex-start; }
  }
</style>
