}

/* --- Palette Sections --- */
.di-palette-section {
  padding: 8px 0;
}
.di-palette-section + .di-palette-section {
  border-top: 1px solid rgba(255, 255, 255, 0.04);
}
.di-palette-section-label {
  font-size: 0.6rem;
  color: var(--di-text-muted);
