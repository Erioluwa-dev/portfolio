---
const logoText = "Erioluwa";
const resumeUrl = "#";

const defaultLinks = [
  { label: "About", href: "/#about" },
  { label: "Projects", href: "/#projects" },
  { label: "Skills", href: "/#technologies" },
  { label: "Contact", href: "/#contact" },
];

const rawLinks = Astro.props.navLinks;
const links = rawLinks ?? defaultLinks;

// Command palette items
const paletteNavItems = [
  { icon: "\u25CF", label: "Projects", href: "/#projects", shortcut: "P" },
  { icon: "\u25CF", label: "About", href: "/#about", shortcut: "A" },
  { icon: "\u25CF", label: "Letters", href: "/letters", shortcut: "L" },
  { icon: "\u25CF", label: "Skills", href: "/#technologies", shortcut: "T" },
];

const paletteActionItems = [
  { icon: "\u2709", label: "Email", href: "mailto:erioluwafawehinmi@gmail.com", shortcut: "E", external: false },
  { icon: "\u260D", label: "GitHub", href: "https://github.com/erioluwafawehinmi", shortcut: "G", external: true },
  { icon: "\u2609", label: "Instagram", href: "https://instagram.com/stay.with.eri", shortcut: "I", external: true },
];
---

<header
  id="di-header"
  class="di-header"
  data-state="expanded"
  data-menu-open="false"
  role="navigation"
  aria-label="Main navigation"
>
  <!-- ====== INNER CONTAINER (animates dimensions) ====== -->
  <div class="di-container" id="di-container">
    <!-- Main row — always present, shows compact pill or full nav -->
    <div class="di-main-row">
      <!-- Logo -->
      <a href="/" class="di-logo" aria-label="Go to homepage">
        <span class="di-logo-text">{logoText}</span>
      </a>

      <!-- Navigation links (desktop) -->
      <nav class="di-nav" id="di-nav">
        <div class="di-indicator" id="di-indicator" aria-hidden="true"></div>
        {links.map((link, i) => (
          <a
            href={link.href}
            class="di-nav-link"
            data-section={link.href.replace("/#", "")}
            style={`--i: ${i}`}
          >
            {link.label}
          </a>
        ))}
      </nav>

      <!-- Right-side actions -->
      <div class="di-actions">
        <a href={resumeUrl} class="di-resume-btn" target="_blank" rel="noopener noreferrer">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
            <polyline points="14 2 14 8 20 8" />
            <line x1="16" y1="13" x2="8" y2="13" />
            <line x1="16" y1="17" x2="8" y2="17" />
            <polyline points="10 9 9 9 8 9" />
          </svg>
          Resume
        </a>
      </div>

      <!-- Hamburger (visible in compact state + mobile) -->
      <button
        class="di-menu-toggle"
        id="di-menu-toggle"
        aria-label="Open navigation menu"
        aria-expanded="false"
        type="button"
      >
        <span class="di-hamburger-line"></span>
        <span class="di-hamburger-line"></span>
        <span class="di-hamburger-line"></span>
      </button>
    </div>

    <!-- ====== COMMAND PALETTE (inside container — desktop click expands island) ====== -->
    <div class="di-palette" id="di-palette" role="dialog" aria-label="Command palette" aria-hidden="true">
      <!-- Header -->
      <div class="di-palette-header">
        <span class="di-palette-title">// COMMAND PALETTE</span>
        <span class="di-palette-cursor">&#9608;</span>
      </div>

      <!-- Search -->
      <div class="di-palette-search">
        <input
          id="di-palette-input"
          type="text"
          placeholder="Type to search..."
          class="di-palette-input"
          autocomplete="off"
          spellcheck="false"
        />
      </div>

      <!-- Navigation section -->
      <div class="di-palette-section">
        <div class="di-palette-section-label">// NAVIGATION</div>
        <div class="di-palette-items">
          {paletteNavItems.map((item, i) => (
            <a
              href={item.href}
              class="di-palette-item"
              data-index={i}
              data-section="nav"
            >
              <span class="di-palette-item-icon" set:html={item.icon} />
              <span class="di-palette-item-label">{item.label}</span>
              <span class="di-palette-item-shortcut">{item.shortcut}</span>
            </a>
          ))}
        </div>
      </div>

      <!-- Actions section -->
      <div class="di-palette-section">
        <div class="di-palette-section-label">// ACTIONS</div>
        <div class="di-palette-items">
          {paletteActionItems.map((item, i) => (
            <a
              href={item.href}
              class="di-palette-item"
              data-index={paletteNavItems.length + i}
              data-section="action"
              target={item.external ? "_blank" : undefined}
              rel={item.external ? "noopener noreferrer" : undefined}
            >
              <span class="di-palette-item-icon" set:html={item.icon} />
              <span class="di-palette-item-label">{item.label}</span>
              <span class="di-palette-item-shortcut">{item.shortcut}</span>
            </a>
          ))}
        </div>
      </div>

      <!-- Footer -->
      <div class="di-palette-footer">
        <span class="di-palette-hint">&uarr;&darr; navigate</span>
        <span class="di-palette-hint">&#9166; select</span>
        <span class="di-palette-hint">esc close</span>
      </div>
    </div>
  </div>

  <!-- ====== MOBILE DROPDOWN ====== -->
  <nav class="di-mobile-menu" id="di-mobile-menu" aria-label="Mobile navigation" aria-hidden="true">
    {links.map((link, i) => (
      <a
        href={link.href}
        class="di-mobile-link"
        style={`transition-delay: ${i * 0.04}s`}
        data-section={link.href.replace("/#", "")}
      >
        {link.label}
      </a>
    ))}
  </nav>
</header>

<style>
/* ============================================================
   DYNAMIC ISLAND HEADER — Complete Styles
   ============================================================
   Palette: site blue (#54C5F8) on black
   ============================================================ */

/* --- Custom Properties --- */
.di-header {
  --di-accent: #54C5F8;
  --di-accent-light: #7BD5FA;
  --di-accent-glow: rgba(84, 197, 248, 0.3);
  --di-accent-bg: rgba(84, 197, 248, 0.08);
  --di-glass-bg: rgba(0, 0, 0, 0.85);
  --di-glass-border: rgba(255, 255, 255, 0.06);
  --di-text: #ffffff;
  --di-text-secondary: rgba(255, 255, 255, 0.65);
  --di-text-muted: rgba(255, 255, 255, 0.4);

  /* Sizing */
  --di-width-expanded: min(720px, calc(100vw - 32px));
  --di-width-compact: 210px;
  --di-height-expanded: 60px;
  --di-height-compact: 42px;
  --di-radius-expanded: 18px;
  --di-radius-compact: 999px;

  /* Spring-like cubic-bezier — slight overshoot for bounce */
  --di-spring: cubic-bezier(0.34, 1.56, 0.64, 1);
  --di-smooth: cubic-bezier(0.22, 1, 0.36, 1);
  --di-ease: cubic-bezier(0.4, 0, 0.2, 1);

  /* Positioning */
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 1000;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 18px;
  pointer-events: none;
}

/* ============================================================
   CONTAINER — Glass capsule, animates dimensions
   ============================================================ */
.di-container {
  position: relative;
  pointer-events: auto;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 0;

  /* Start expanded */
  width: var(--di-width-expanded);
  /* height auto — content determines height, main-row controls min-height */
  min-height: var(--di-height-expanded);
  border-radius: var(--di-radius-expanded);

  /* Glassmorphism */
  background: var(--di-glass-bg);
  backdrop-filter: blur(28px);
  -webkit-backdrop-filter: blur(28px);
  border: 1px solid var(--di-glass-border);

  /* Shadow */
  box-shadow:
    0 8px 32px rgba(0, 0, 0, 0.4),
    0 2px 8px rgba(0, 0, 0, 0.3),
    inset 0 1px 0 rgba(255, 255, 255, 0.04);

  /* GPU hint */
  will-change: width, min-height, border-radius, padding;
  transform: translateZ(0);

  /* Prevent content overflow rounding */
  overflow: hidden;

  /* Spring animation on dimension changes */
  transition:
    width 0.55s var(--di-spring),
    min-height 0.55s var(--di-spring),
    transform 0.5s var(--di-spring),
    border-radius 0.5s var(--di-smooth),
    padding 0.4s var(--di-smooth),
    box-shadow 0.4s var(--di-smooth),
    gap 0.4s var(--di-smooth);
}

/* Main row — always the top bar inside container */
.di-main-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 0;
  width: 100%;
  padding: 0 10px 0 18px;
  /* Match container default height */
  min-height: var(--di-height-expanded);
  flex-shrink: 0;
  transition:
    min-height 0.4s var(--di-smooth),
    padding 0.4s var(--di-smooth),
    gap 0.4s var(--di-smooth);
}

/* --- Green-white glowing indicator dot (left side) --- */
@keyframes di-dot-pulse {
  0%, 100% {
    opacity: 1;
    box-shadow:
      0 0 6px 2px rgba(100, 220, 140, 0.35),
      0 0 14px 4px rgba(100, 220, 140, 0.12);
  }
  50% {
    opacity: 0.5;
    box-shadow:
      0 0 10px 4px rgba(100, 220, 140, 0.5),
      0 0 20px 8px rgba(100, 220, 140, 0.18);
  }
}

.di-container::before {
  content: '';
  position: absolute;
  left: 7px;
  top: 50%;
  transform: translateY(-50%);
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: radial-gradient(circle at 35% 35%, #e0ffe8, #60d080);
  box-shadow:
    0 0 6px 2px rgba(100, 220, 140, 0.35),
    0 0 14px 4px rgba(100, 220, 140, 0.12);
  pointer-events: none;
  animation: di-dot-pulse 2.4s ease-in-out infinite;
}

/* ============================================================
   COMPACT STATE (scrolled down) — centered logo, hidden nav
   ============================================================ */
.di-header[data-state="compact"] .di-container {
  width: var(--di-width-compact);
  min-height: var(--di-height-compact);
  border-radius: var(--di-radius-compact);
  box-shadow:
    0 8px 32px rgba(0, 0, 0, 0.5),
    0 2px 12px rgba(0, 0, 0, 0.4),
    inset 0 1px 0 rgba(255, 255, 255, 0.04);
}

.di-header[data-state="compact"] .di-main-row {
  min-height: var(--di-height-compact);
  justify-content: center;
  padding: 0 18px;
}

/* --- Compact: remove nav/actions from flow entirely --- */
.di-header[data-state="compact"] .di-nav,
.di-header[data-state="compact"] .di-actions {
  display: none;
}

/* ============================================================
   LOGO
   ============================================================ */
.di-logo {
  display: flex;
  align-items: center;
  gap: 4px;
  text-decoration: none;
  flex-shrink: 0;
  color: var(--di-text);
  z-index: 1;
}

.di-logo-text {
  font-family: 'Lora', Georgia, serif;
  font-weight: 700;
  font-size: 1.05rem;
  color: var(--di-text);
  letter-spacing: 0.5px;
}

/* ============================================================
   NAVIGATION LINKS — Desktop
   ============================================================ */
.di-nav {
  position: relative;
  display: flex;
  align-items: center;
  gap: 2px;
  flex-shrink: 0;
  transition:
    opacity 0.35s var(--di-smooth),
    visibility 0.35s var(--di-smooth);
}

.di-nav-link {
  position: relative;
  padding: 6px 14px;
  font-family: 'Lora', Georgia, serif;
  font-size: 0.85rem;
  font-weight: 600;
  color: var(--di-text-secondary);
  text-decoration: none;
  letter-spacing: 0.5px;
  border-radius: 8px;
  transition:
    color 0.2s var(--di-ease),
    background 0.2s var(--di-ease);
  white-space: nowrap;
  z-index: 1;
}

.di-nav-link:hover,
.di-nav-link:focus-visible {
  color: var(--di-text);
  background: rgba(255, 255, 255, 0.06);
  outline: none;
}

.di-nav-link:focus-visible {
  box-shadow: 0 0 0 2px var(--di-accent);
}

/* Active link — site blue accent */
.di-nav-link.active {
  color: var(--di-text);
}

/* ============================================================
   INDICATOR - Sliding underline (site blue)
   ============================================================ */
.di-indicator {
  position: absolute;
  bottom: 2px;
  left: 0;
  height: 2px;
  background: var(--di-accent);
  border-radius: 2px;
  pointer-events: none;
  will-change: transform, width;
  transition:
    width 0.4s var(--di-spring),
    transform 0.4s var(--di-spring);
}

/* ============================================================
   ACTIONS (resume button)
   ============================================================ */
.di-actions {
  display: flex;
  align-items: center;
  gap: 8px;
  flex-shrink: 0;
  transition:
    opacity 0.35s var(--di-smooth),
    visibility 0.35s var(--di-smooth);
}

.di-resume-btn {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 6px 16px;
  border-radius: 10px;
  background: linear-gradient(135deg, var(--di-accent), var(--di-accent-light));
  color: #fff;
  font-family: 'Lora', Georgia, serif;
  font-size: 0.8rem;
  font-weight: 700;
  text-decoration: none;
  letter-spacing: 0.5px;
  border: none;
  cursor: pointer;
  white-space: nowrap;
  transition:
    transform 0.2s var(--di-ease),
    box-shadow 0.2s var(--di-ease),
    opacity 0.2s var(--di-ease);
}

.di-resume-btn:hover {
  transform: scale(1.04);
  box-shadow: 0 4px 20px rgba(121, 34, 54, 0.4);
}

.di-resume-btn:focus-visible {
  outline: 2px solid var(--di-text);
  outline-offset: 2px;
}

.di-resume-btn:active {
  transform: scale(0.97);
}

/* ============================================================
   HAMBURGER MENU BUTTON (visible in compact + mobile)
   ============================================================ */
.di-menu-toggle {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4px;
  width: 34px;
  height: 34px;
  border-radius: 10px;
  border: none;
  background: transparent;
  cursor: pointer;
  opacity: 0;
  visibility: hidden;
  pointer-events: none;
  transition:
    opacity 0.25s var(--di-smooth),
    visibility 0.25s var(--di-smooth);
  z-index: 5;
}

.di-menu-toggle:hover {
  background: rgba(255, 255, 255, 0.06);
}

.di-menu-toggle:focus-visible {
  outline: 2px solid var(--di-accent);
  outline-offset: 2px;
}

.di-hamburger-line {
  display: block;
  width: 16px;
  height: 2px;
  background: var(--di-text);
  border-radius: 2px;
  transition: transform 0.3s var(--di-ease);
  transform-origin: center;
}

/* Animate to X when menu is open */
.di-header[data-menu-open="true"] .di-hamburger-line:nth-child(1) {
  transform: translateY(6px) rotate(45deg);
}

.di-header[data-menu-open="true"] .di-hamburger-line:nth-child(2) {
  opacity: 0;
  transform: scaleX(0);
}

.di-header[data-menu-open="true"] .di-hamburger-line:nth-child(3) {
  transform: translateY(-6px) rotate(-45deg);
}

/* ============================================================
   MOBILE MENU — Dropdown below the compact island
   ============================================================ */
.di-mobile-menu {
  pointer-events: auto;
  display: flex;
  flex-direction: column;
  gap: 4px;
  width: var(--di-width-compact);
  margin-top: 6px;
  padding: 8px;
  border-radius: 16px;
  background: var(--di-glass-bg);
  backdrop-filter: blur(28px);
  -webkit-backdrop-filter: blur(28px);
  border: 1px solid var(--di-glass-border);
  box-shadow: 0 12px 40px rgba(0, 0, 0, 0.5);
  transform-origin: top center;
  transition:
    opacity 0.3s var(--di-smooth),
    transform 0.3s var(--di-smooth),
    visibility 0.3s var(--di-smooth);
  overflow: hidden;
}

.di-mobile-menu[aria-hidden="true"] {
  opacity: 0;
  visibility: hidden;
  transform: translateY(-8px) scaleY(0.95);
  pointer-events: none;
}

.di-mobile-menu[aria-hidden="false"] {
  opacity: 1;
  visibility: visible;
  transform: translateY(0) scaleY(1);
}

.di-mobile-link {
  display: block;
  padding: 10px 14px;
  font-family: 'Lora', Georgia, serif;
  font-size: 0.9rem;
  font-weight: 600;
  color: var(--di-text-secondary);
  text-decoration: none;
  border-radius: 10px;
  transition:
    background 0.2s var(--di-ease),
    color 0.2s var(--di-ease),
    opacity 0.35s var(--di-smooth),
    transform 0.35s var(--di-smooth);
  opacity: 0;
  transform: translateY(-6px);
}

.di-mobile-menu[aria-hidden="false"] .di-mobile-link {
  opacity: 1;
  transform: translateY(0);
}

.di-mobile-link:hover,
.di-mobile-link:focus-visible {
  background: var(--di-accent-bg);
  color: var(--di-text);
  outline: none;
}

.di-mobile-link.active {
  color: var(--di-text);
  background: var(--di-accent-bg);
  border-left: 2px solid var(--di-accent);
}

/* ============================================================
   PALETTE — Inside the container when compact island is clicked
   ============================================================ */
.di-palette {
  width: 100%;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  opacity: 0;
  visibility: hidden;
  max-height: 0;
  transition:
    opacity 0.25s var(--di-smooth),
    visibility 0s 0.35s,
    max-height 0s 0.35s;
  font-family: 'Lora', Georgia, serif;
}

.di-header[data-palette-open="true"] .di-palette {
  opacity: 1;
  visibility: visible;
  max-height: 600px;
  transition:
    opacity 0.25s var(--di-smooth) 0.1s,
    visibility 0s 0s,
    max-height 0s 0s;
}

/* Compact + palette open: container expands to show palette inside */
.di-header[data-state="compact"][data-palette-open="true"] .di-container {
  width: min(420px, calc(100vw - 32px));
  min-height: auto;
  border-radius: 18px;
  box-shadow:
    0 16px 48px rgba(0, 0, 0, 0.5),
    0 4px 16px rgba(0, 0, 0, 0.3);
}

.di-header[data-state="compact"][data-palette-open="true"] .di-main-row {
  justify-content: flex-start;
  padding: 0 10px 0 18px;
  min-height: 48px;
}

/* --- Palette Header --- */
.di-palette-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 14px 18px;
  border-bottom: 1px solid rgba(255, 255, 255, 0.06);
}

.di-palette-title {
  font-size: 0.7rem;
  color: var(--di-text-muted);
  letter-spacing: 2px;
  text-transform: uppercase;
  font-weight: 600;
}

.di-palette-cursor {
  color: var(--di-accent);
  font-size: 0.85rem;
  animation: di-cursor-blink 1s step-end infinite;
}

@keyframes di-cursor-blink {
  50% { opacity: 0; }
}

/* --- Palette Search --- */
.di-palette-search {
  padding: 10px 18px;
  border-bottom: 1px solid rgba(255, 255, 255, 0.06);
}

.di-palette-input {
  width: 100%;
  background: transparent;
  border: none;
  outline: none;
  color: var(--di-text);
  font-size: 0.9rem;
  font-family: 'Lora', Georgia, serif;
  caret-color: var(--di-accent);
}

.di-palette-input::placeholder {
  color: var(--di-text-muted);
}

/* --- Palette Section --- */
.di-palette-section {
  padding: 8px 0;
}

.di-palette-section + .di-palette-section {
  border-top: 1px solid rgba(255, 255, 255, 0.04);
}

.di-palette-section-label {
  font-size: 0.65rem;
  color: var(--di-text-muted);
  letter-spacing: 2px;
  text-transform: uppercase;
  padding: 4px 18px 6px;
  font-weight: 600;
}

.di-palette-items {
  display: flex;
  flex-direction: column;
  gap: 1px;
}

/* --- Palette Item --- */
.di-palette-item {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 8px 18px;
  text-decoration: none;
  color: var(--di-text-secondary);
  transition:
    background 0.12s var(--di-ease),
    color 0.12s var(--di-ease);
  border-left: 2px solid transparent;
  cursor: pointer;
}

.di-palette-item:hover,
.di-palette-item.focused {
  background: var(--di-accent-bg);
  color: var(--di-text);
  border-left-color: var(--di-accent);
}

.di-palette-item:focus-visible {
  outline: 2px solid var(--di-accent);
  outline-offset: -2px;
}

.di-palette-item-icon {
  font-size: 0.7rem;
  color: var(--di-text-muted);
  width: 16px;
  text-align: center;
  flex-shrink: 0;
  transition: color 0.12s var(--di-ease);
}

.di-palette-item:hover .di-palette-item-icon,
.di-palette-item.focused .di-palette-item-icon {
  color: var(--di-accent);
}

.di-palette-item-label {
  font-size: 0.85rem;
  flex: 1;
  letter-spacing: 0.5px;
}

.di-palette-item-shortcut {
  font-size: 0.65rem;
  color: var(--di-text-muted);
  border: 1px solid rgba(255, 255, 255, 0.08);
  padding: 1px 7px;
  border-radius: 4px;
  letter-spacing: 1px;
  font-family: inherit;
  transition: color 0.12s var(--di-ease), border-color 0.12s var(--di-ease);
}

.di-palette-item:hover .di-palette-item-shortcut,
.di-palette-item.focused .di-palette-item-shortcut {
  color: var(--di-accent);
  border-color: rgba(84, 197, 248, 0.3);
}

/* --- Palette Footer --- */
.di-palette-footer {
  display: flex;
  gap: 14px;
  padding: 10px 18px;
  border-top: 1px solid rgba(255, 255, 255, 0.06);
  margin-top: auto;
}

.di-palette-hint {
  font-size: 0.6rem;
  color: var(--di-text-muted);
  letter-spacing: 1px;
}

/* ============================================================
   SCROLL-LOCK OVERLAY (mobile menu open)
   ============================================================ */
.di-overlay {
  display: none;
  position: fixed;
  inset: 0;
  background: transparent;
  z-index: -1;
}

.di-header[data-menu-open="true"] .di-overlay {
  display: block;
}

/* ============================================================
   RESPONSIVE
   ============================================================ */

/* Tablet: hide desktop nav actions, show hamburger always */
@media (max-width: 820px) {
  .di-container {
    --di-width-expanded: min(680px, calc(100vw - 24px));
  }

  .di-nav {
    gap: 0;
  }

  .di-nav-link {
    padding: 6px 10px;
    font-size: 0.8rem;
  }

  .di-actions {
    gap: 4px;
  }

  .di-resume-btn {
    padding: 6px 12px;
    font-size: 0.75rem;
  }
}

/* Mobile: island drops down + expands to show menu inside */
@media (max-width: 640px) {
  .di-header {
    padding-top: 12px;
  }

  /* --- Base mobile: always compact pill --- */
  .di-container {
    --di-width-compact: 190px;
    --di-height-compact: 40px;
    width: var(--di-width-compact);
    height: var(--di-height-compact);
    border-radius: var(--di-radius-compact);
    padding: 0 6px 0 8px;
    justify-content: space-between;
    transform: translateZ(0) translateY(0);
  }

  .di-header[data-state="expanded"] .di-container,
  .di-header[data-state="compact"] .di-container {
    width: var(--di-width-compact);
    height: var(--di-height-compact);
    border-radius: var(--di-radius-compact);
    padding: 0 6px 0 8px;
    justify-content: space-between;
  }

  /* Hide desktop nav + actions on mobile */
  .di-nav,
  .di-actions {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition:
      opacity 0.2s var(--di-ease),
      visibility 0s 0.2s;
  }

  /* Always show hamburger on mobile */
  .di-menu-toggle {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }

  /* Hide indicator on mobile */
  .di-indicator {
    display: none;
  }

  /* Hide green dot on mobile (too tight) */
  .di-container::before {
    display: none;
  }

  /* Hide the external mobile dropdown — we use container expansion instead */
  .di-mobile-menu {
    display: none !important;
  }

  /* Hide palette on mobile (desktop-only feature) */
  .di-palette {
    display: none;
  }

  /* --- Menu open: island drops down + expands --- */
  .di-header[data-menu-open="true"] .di-container {
    transform: translateZ(0) translateY(14px);
    width: min(360px, calc(100vw - 24px));
    height: auto;
    border-radius: 20px;
    padding: 14px 18px 18px;
    flex-direction: column;
    align-items: stretch;
    gap: 4px;
    transition:
      width 0.5s var(--di-spring),
      height 0.5s var(--di-smooth),
      transform 0.5s var(--di-spring),
      border-radius 0.4s var(--di-smooth),
      padding 0.4s var(--di-smooth);
  }

  /* Top row: logo left, close button right */
  .di-header[data-menu-open="true"] .di-logo {
    align-self: flex-start;
    margin-bottom: 2px;
  }

  .di-header[data-menu-open="true"] .di-menu-toggle {
    position: absolute;
    right: 18px;
    top: 14px;
  }

  /* Nav links appear centered inside the expanded island */
  .di-header[data-menu-open="true"] .di-nav {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2px;
    width: 100%;
    padding: 10px 0 6px;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
    margin-top: 6px;
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }

  .di-header[data-menu-open="true"] .di-nav-link {
    width: 100%;
    text-align: center;
    padding: 12px 16px;
    font-size: 0.95rem;
    border-radius: 12px;
    opacity: 0;
    transform: translateY(-8px);
    transition:
      opacity 0.35s var(--di-smooth),
      transform 0.35s var(--di-smooth),
      color 0.2s var(--di-ease),
      background 0.2s var(--di-ease);
    transition-delay: calc(var(--i, 0) * 0.06s);
  }

  .di-header[data-menu-open="true"] .di-nav-link:nth-child(2) {
    transition-delay: calc(var(--i, 0) * 0.06s + 0.04s);
  }

  /* Animate nav links in with stagger */
  .di-header[data-menu-open="true"] .di-nav-link {
    opacity: 1;
    transform: translateY(0);
  }

  /* Show resume button centered */
  .di-header[data-menu-open="true"] .di-actions {
    display: flex;
    justify-content: center;
    padding-top: 8px;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
    margin-top: 2px;
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }
}

/* Small mobile */
@media (max-width: 400px) {
  .di-container {
    --di-width-compact: 170px;
  }

  .di-logo-text {
    font-size: 0.95rem;
  }
}

/* ============================================================
   REDUCED MOTION
   ============================================================ */
@media (prefers-reduced-motion: reduce) {
  .di-container {
    transition: none;
  }

  .di-container::before {
    animation: none;
  }

  .di-nav,
  .di-actions,
  .di-menu-toggle,
  .di-logo-text,
  .di-indicator,
  .di-mobile-menu,
  .di-mobile-link,
  .di-palette,
  .di-palette-item,
  .di-nav-link,
  .di-resume-btn,
  .di-hamburger-line {
    transition: none;
  }
}
</style>

<script>
// ============================================================
// Dynamic Island — Scroll Detection & Interaction Logic
// ============================================================
(function () {
  "use strict";

  // --- DOM refs ---
  const header = document.getElementById("di-header");
  const container = document.getElementById("di-container");
  const nav = document.getElementById("di-nav");
  const indicator = document.getElementById("di-indicator");
  const menuToggle = document.getElementById("di-menu-toggle");
  const mobileMenu = document.getElementById("di-mobile-menu");
  const navLinks = document.querySelectorAll(".di-nav-link");
  const mobileLinks = document.querySelectorAll(".di-mobile-link");

  // --- State ---
  let isCompact = false;
  let isMenuOpen = false;
  let activeSection = "";
  let ticking = false;
  let prefersReducedMotion = false;

  // Check reduced motion preference
  const motionQuery = window.matchMedia("(prefers-reduced-motion: reduce)");
  prefersReducedMotion = motionQuery.matches;
  motionQuery.addEventListener("change", () => {
    prefersReducedMotion = motionQuery.matches;
  });

  // --- Constants ---
  const SCROLL_THRESHOLD = 180; // px from top before compacting
  const SECTION_IDS = [
    ...new Set(
      Array.from(navLinks).map((link) => link.dataset.section)
    ),
  ];

  // ==========================================================
  // SCROLL HANDLER — Compact/expand based on scroll position
  // ==========================================================
  function handleScroll() {
    const scrollY = window.scrollY;
    const shouldBeCompact = scrollY > SCROLL_THRESHOLD;

    if (shouldBeCompact !== isCompact) {
      isCompact = shouldBeCompact;

      // Don't auto-compact if mobile menu is open
      if (!isMenuOpen) {
        header.dataset.state = isCompact ? "compact" : "expanded";
      }
    }

    ticking = false;
  }

  function onScroll() {
    if (!ticking) {
      requestAnimationFrame(handleScroll);
      ticking = true;
    }
  }

  // ==========================================================
  // ACTIVE SECTION — IntersectionObserver + indicator
  // ==========================================================
  function updateIndicator(activeLink) {
    if (!indicator || !activeLink || prefersReducedMotion) return;

    // Only update indicator on desktop (nav is visible)
    if (nav.offsetParent === null || nav.style.visibility === "hidden") return;

    const navRect = nav.getBoundingClientRect();
    const linkRect = activeLink.getBoundingClientRect();

    const offsetX = linkRect.left - navRect.left;
    indicator.style.width = linkRect.width + "px";
    indicator.style.transform = "translateX(" + offsetX + "px)";
  }

  function setActiveSection(id) {
    if (id === activeSection) return;
    activeSection = id;

    // Update desktop nav links
    navLinks.forEach((link) => {
      const isActive = link.dataset.section === id;
      link.classList.toggle("active", isActive);
      if (isActive) updateIndicator(link);
    });

    // Update mobile links
    mobileLinks.forEach((link) => {
      link.classList.toggle("active", link.dataset.section === id);
    });
  }

  // Observe sections for active tracking
  const sectionObserver = new IntersectionObserver(
    (entries) => {
      // Find the most visible section
      let bestEntry = null;
      let bestRatio = 0;

      entries.forEach((entry) => {
        if (entry.intersectionRatio > bestRatio) {
          bestRatio = entry.intersectionRatio;
          bestEntry = entry;
        }
      });

      if (bestEntry && bestRatio > 0.15) {
        setActiveSection(bestEntry.target.id);
      }
    },
    {
      threshold: [0.15, 0.3, 0.5, 0.7],
      rootMargin: "-80px 0px -20% 0px",
    }
  );

  // Register sections
  SECTION_IDS.forEach((id) => {
    const el = document.getElementById(id);
    if (el) {
      sectionObserver.observe(el);
    } else {
      // Fallback: try matching by hash or common pattern
      const fallback = document.querySelector("[id='" + id + "'], [data-section='" + id + "']");
      if (fallback) sectionObserver.observe(fallback);
    }
  });

  // ==========================================================
  // MOBILE MENU — Toggle open/close
  // ==========================================================
  function openMenu() {
    isMenuOpen = true;
    header.dataset.menuOpen = "true";
    mobileMenu.setAttribute("aria-hidden", "false");
    menuToggle.setAttribute("aria-expanded", "true");
    menuToggle.setAttribute("aria-label", "Close navigation menu");
    // Keep in compact state visually while menu is open
    header.dataset.state = "compact";
  }

  function closeMenu() {
    isMenuOpen = false;
    header.dataset.menuOpen = "false";
    mobileMenu.setAttribute("aria-hidden", "true");
    menuToggle.setAttribute("aria-expanded", "false");
    menuToggle.setAttribute("aria-label", "Open navigation menu");
    // Restore scroll-based state
    header.dataset.state = isCompact ? "compact" : "expanded";
  }

  menuToggle.addEventListener("click", () => {
    if (isMenuOpen) {
      closeMenu();
    } else {
      openMenu();
    }
  });

  // Close menu when clicking a mobile link
  mobileLinks.forEach((link) => {
    link.addEventListener("click", () => {
      closeMenu();
    });
  });

  // Close menu when clicking nav links inside expanded island (mobile)
  navLinks.forEach((link) => {
    link.addEventListener("click", () => {
      if (window.innerWidth <= 640) {
        closeMenu();
      }
    });
  });

  // Close menu when pressing Escape
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && isMenuOpen) {
      closeMenu();
      menuToggle.focus();
    }
  });

  // ==========================================================
  // COMMAND PALETTE — Desktop compact click → island expands
  // ==========================================================
  const palette = document.getElementById("di-palette");
  const paletteInput = document.getElementById("di-palette-input");
  const paletteItems = document.querySelectorAll(".di-palette-item");
  let isPaletteOpen = false;
  let paletteFocusIndex = -1;

  function openPalette() {
    if (isPaletteOpen) return;
    isPaletteOpen = true;
    header.dataset.paletteOpen = "true";
    palette.setAttribute("aria-hidden", "false");
    paletteFocusIndex = -1;
    updatePaletteFocus();
    // Focus search input after animation
    setTimeout(function () {
      if (paletteInput) paletteInput.focus();
    }, 200);
  }

  function closePalette() {
    if (!isPaletteOpen) return;
    isPaletteOpen = false;
    header.dataset.paletteOpen = "false";
    palette.setAttribute("aria-hidden", "true");
    paletteFocusIndex = -1;
    updatePaletteFocus();
    if (paletteInput) paletteInput.value = "";
    // Reset search filter
    paletteItems.forEach(function (item) {
      item.style.display = "";
    });
  }

  function updatePaletteFocus() {
    paletteItems.forEach(function (item, i) {
      item.classList.toggle("focused", i === paletteFocusIndex);
    });
  }

  function movePaletteFocus(direction) {
    var visible = Array.from(paletteItems).filter(function (item) {
      return item.style.display !== "none";
    });
    if (visible.length === 0) return;
    var currentIndex = visible.indexOf(paletteItems[paletteFocusIndex]);
    if (currentIndex === -1) currentIndex = direction > 0 ? -1 : 0;
    var nextIndex = (currentIndex + direction + visible.length) % visible.length;
    var globalIndex = Array.from(paletteItems).indexOf(visible[nextIndex]);
    paletteFocusIndex = globalIndex;
    updatePaletteFocus();
    visible[nextIndex].scrollIntoView({ block: "nearest" });
  }

  // Click container (compact island on desktop) to open palette
  container.addEventListener("click", function (e) {
    if (window.innerWidth > 640 && !isPaletteOpen) {
      if (isCompact) {
        // Clicking the compact pill (logo area) opens the palette
        // Prevent navigation if a link was clicked
        var link = e.target.closest("a");
        if (link) e.preventDefault();
        if (e.target.closest("button")) return;
        openPalette();
      }
    }
  });

  // Palette keyboard navigation
  document.addEventListener("keydown", function (e) {
    if (!isPaletteOpen) return;

    if (e.key === "Escape") {
      e.preventDefault();
      closePalette();
      return;
    }

    if (e.key === "ArrowDown") {
      e.preventDefault();
      movePaletteFocus(1);
    } else if (e.key === "ArrowUp") {
      e.preventDefault();
      movePaletteFocus(-1);
    } else if (e.key === "Enter" && paletteFocusIndex >= 0) {
      e.preventDefault();
      var item = paletteItems[paletteFocusIndex];
      if (item && item.style.display !== "none") {
        item.click();
      }
    }
  });

  // Close palette when clicking outside
  document.addEventListener("click", function (e) {
    if (!isPaletteOpen) return;
    if (!e.target.closest("#di-palette") && !e.target.closest(".di-container")) {
      closePalette();
    }
  });

  // Palette item clicks close palette
  paletteItems.forEach(function (item) {
    item.addEventListener("click", function () {
      closePalette();
    });
  });

  // Palette search filter
  if (paletteInput) {
    paletteInput.addEventListener("input", function () {
      var query = paletteInput.value.toLowerCase();
      paletteItems.forEach(function (item) {
        var label = (item.querySelector(".di-palette-item-label") || {}).textContent || "";
        item.style.display = label.toLowerCase().includes(query) ? "" : "none";
      });
      paletteFocusIndex = -1;
      updatePaletteFocus();
    });
  }

  // Close palette on resize to mobile width
  window.addEventListener("resize", function () {
    if (isPaletteOpen && window.innerWidth <= 640) {
      closePalette();
    }
  });

  // ==========================================================
  // KEYBOARD NAVIGATION — Trap focus in mobile menu
  // ==========================================================
  mobileMenu.addEventListener("keydown", (e) => {
    if (e.key === "Escape") {
      closeMenu();
      menuToggle.focus();
    }
  });

  // ==========================================================
  // WINDOW EVENTS — Register scroll + resize
  // ==========================================================
  window.addEventListener("scroll", onScroll, { passive: true });

  // Recalculate indicator on resize
  let resizeTimer;
  window.addEventListener("resize", () => {
    clearTimeout(resizeTimer);
    resizeTimer = setTimeout(() => {
      if (activeSection) {
        const active = document.querySelector(
          ".di-nav-link.active"
        );
        if (active) updateIndicator(active);
      }
    }, 100);
  });

  // ==========================================================
  // INIT — Set initial state
  // ==========================================================
  // Check initial scroll position
  handleScroll();

  // Set initial indicator position (first link active by default or home)
  const firstLink = navLinks[0];
  if (firstLink) {
    setTimeout(() => {
      // Check if any section is already visible
      if (!activeSection && firstLink) {
        firstLink.classList.add("active");
        updateIndicator(firstLink);
      }
    }, 50);
  }

  // Expose state for debugging
  console.log("✦ Dynamic Island Header initialized");
})();
</script>
