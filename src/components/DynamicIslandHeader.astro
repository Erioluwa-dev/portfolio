---
// Monochrome Dynamic Island — a compact pill that expands to reveal nav links.
// The deep near-black capsule against the light content card is the signature contrast.
const links = [
  { label: "Home", href: "#top" },
  { label: "Repos", href: "#repos" },
  { label: "About", href: "#about" },
  { label: "Contact", href: "#contact" },
];
---

<header id="di" class="di" data-open="false" aria-label="Main navigation">
  <div
    class="di-pill"
    id="di-pill"
    role="navigation"
    tabindex="0"
    aria-label="Navigation menu"
    aria-expanded="false"
  >
    <!-- Compact state: status dot + slider bar hint -->
    <div class="di-compact" aria-hidden="true">
      <span class="di-dot"></span>
      <span class="di-bar"></span>
    </div>

    <!-- Expanded state: nav links -->
    <nav class="di-nav" aria-label="Sections">
      {links.map((link, i) => (
        <a href={link.href} class="di-link" style={`--i:${i}`}>{link.label}</a>
      ))}
      <button
        id="theme-toggle"
        class="di-theme-toggle"
        style={`--i:${links.length}`}
        title="Toggle light/dark mode"
        aria-label="Toggle theme"
      >
        <svg class="icon-sun" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="5"></circle>
          <line x1="12" y1="1" x2="12" y2="3"></line>
          <line x1="12" y1="21" x2="12" y2="23"></line>
          <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
          <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
          <line x1="1" y1="12" x2="3" y2="12"></line>
          <line x1="21" y1="12" x2="23" y2="12"></line>
          <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
          <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
        </svg>
        <svg class="icon-moon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
        </svg>
      </button>
    </nav>
  </div>
</header>

<style>
  .di {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 1000;
    display: flex;
    justify-content: center;
    padding-top: 20px;
    pointer-events: none;
  }

  /* ---- The capsule ---- */
  .di-pill {
    pointer-events: auto;
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    height: 46px;
    width: 104px;
    padding: 0 16px;
    background: #0a0a0a;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.06);
    box-shadow:
      0 12px 34px rgba(0, 0, 0, 0.5),
      0 3px 10px rgba(0, 0, 0, 0.4),
      inset 0 1px 0 rgba(255, 255, 255, 0.05);
    cursor: pointer;
    overflow: hidden;
    outline: none;
    transition:
      width 0.44s cubic-bezier(0.34, 1.4, 0.5, 1),
      box-shadow 0.3s ease;
    will-change: width;
  }

  .di-pill:focus-visible {
    box-shadow:
      0 0 0 2px rgba(255, 255, 255, 0.55),
      0 12px 34px rgba(0, 0, 0, 0.5);
  }

  /* ---- Compact contents: dot + slider bar ---- */
  .di-compact {
    display: flex;
    align-items: center;
    gap: 10px;
    transition: opacity 0.16s ease;
  }

  .di-dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: radial-gradient(circle at 35% 30%, #ffffff, #cfcfcf);
    box-shadow:
      0 0 6px rgba(255, 255, 255, 0.4),
      0 0 1px rgba(255, 255, 255, 0.9);
    animation: di-pulse 2.6s ease-in-out infinite;
    flex-shrink: 0;
  }

  @keyframes di-pulse {
    0%, 100% { opacity: 1; box-shadow: 0 0 6px rgba(255, 255, 255, 0.4); }
    50% { opacity: 0.65; box-shadow: 0 0 10px rgba(255, 255, 255, 0.55); }
  }

  .di-bar {
    width: 34px;
    height: 5px;
    border-radius: 999px;
    background: #3a3a3d;
    flex-shrink: 0;
  }

  /* ---- Expanded nav links ---- */
  .di-nav {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 4px;
    padding: 0 12px;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 0.18s ease, visibility 0s 0.2s;
  }

  .di-link {
    font-family: 'Lora', Georgia, serif;
    font-size: 0.9rem;
    font-weight: 500;
    letter-spacing: 0.3px;
    color: rgba(255, 255, 255, 0.68);
    text-decoration: none;
    padding: 7px 14px;
    border-radius: 999px;
    white-space: nowrap;
    opacity: 0;
    transform: translateY(6px);
    transition:
      color 0.2s ease,
      background 0.2s ease,
      opacity 0.2s ease,
      transform 0.2s ease;
  }

  .di-link:hover,
  .di-link:focus-visible {
    color: #fff;
    background: rgba(255, 255, 255, 0.08);
    outline: none;
  }

  /* ---- Theme toggle button ---- */
  .di-theme-toggle {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    padding: 0;
    margin-left: 4px;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 50%;
    color: rgba(255, 255, 255, 0.68);
    cursor: pointer;
    opacity: 0;
    transform: translateY(6px);
    transition:
      color 0.2s ease,
      background 0.2s ease,
      border-color 0.2s ease,
      opacity 0.2s ease,
      transform 0.2s ease;
    flex-shrink: 0;
  }

  .di-theme-toggle:hover {
    color: #fff;
    background: rgba(255, 255, 255, 0.12);
    border-color: rgba(255, 255, 255, 0.2);
  }

  .di-theme-toggle .icon-moon {
    display: none;
  }

  [data-theme="dark"] .di-theme-toggle .icon-sun {
    display: none;
  }

  [data-theme="dark"] .di-theme-toggle .icon-moon {
    display: block;
  }

  /* ---- OPEN STATE (hover on desktop, click anywhere) ---- */
  .di[data-open="true"] .di-pill {
    width: min(480px, calc(100vw - 32px));
  }

  .di[data-open="true"] .di-compact {
    opacity: 0;
  }

  .di[data-open="true"] .di-nav {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transition: opacity 0.2s ease 0.12s, visibility 0s 0.12s;
  }

  .di[data-open="true"] .di-link,
  .di[data-open="true"] .di-theme-toggle {
    opacity: 1;
    transform: translateY(0);
    transition-delay: calc(0.16s + var(--i, 0) * 0.04s);
  }

  /* Desktop: expand on hover */
  @media (hover: hover) and (pointer: fine) {
    .di-pill:hover {
      width: min(480px, calc(100vw - 32px));
    }
    .di-pill:hover .di-compact { opacity: 0; }
    .di-pill:hover .di-nav {
      opacity: 1;
      visibility: visible;
      pointer-events: auto;
      transition: opacity 0.2s ease 0.12s, visibility 0s 0.12s;
    }
    .di-pill:hover .di-link,
    .di-pill:hover .di-theme-toggle {
      opacity: 1;
      transform: translateY(0);
      transition-delay: calc(0.16s + var(--i, 0) * 0.04s);
    }
  }

  @media (max-width: 480px) {
    .di { padding-top: 14px; }
    .di-link { font-size: 0.85rem; padding: 6px 11px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .di-pill, .di-nav, .di-link, .di-dot, .di-theme-toggle { transition: none; animation: none; }
  }
</style>

<script>
  (function () {
    const di = document.getElementById("di");
    const pill = document.getElementById("di-pill");
    const themeToggle = document.getElementById("theme-toggle");
    if (!di || !pill) return;

    // ---- Theme ----
    const savedTheme = localStorage.getItem("theme");
    if (savedTheme) {
      document.documentElement.setAttribute("data-theme", savedTheme);
    } else {
      // Default: light on homepage, dark on /letters
      const isLetters = window.location.pathname.startsWith("/letters");
      document.documentElement.setAttribute("data-theme", isLetters ? "dark" : "light");
    }

    themeToggle?.addEventListener("click", (e) => {
      e.stopPropagation();
      const current = document.documentElement.getAttribute("data-theme");
      const next = current === "dark" ? "light" : "dark";
      document.documentElement.setAttribute("data-theme", next);
      localStorage.setItem("theme", next);
    });

    // ---- Island expand/collapse ----
    function open() {
      di.dataset.open = "true";
      pill.setAttribute("aria-expanded", "true");
    }
    function close() {
      di.dataset.open = "false";
      pill.setAttribute("aria-expanded", "false");
    }
    function toggle() {
      di.dataset.open === "true" ? close() : open();
    }

    // Click / tap toggles (primary interaction on touch, secondary on desktop)
    pill.addEventListener("click", (e) => {
      // let link clicks navigate + close
      if (e.target.closest(".di-link")) {
        close();
        return;
      }
      // let theme toggle work without collapsing
      if (e.target.closest("#theme-toggle")) {
        return;
      }
      toggle();
    });

    // Keyboard: Enter/Space toggles, Escape closes
    pill.addEventListener("keydown", (e) => {
      if (e.key === "Enter" || e.key === " ") {
        e.preventDefault();
        toggle();
      } else if (e.key === "Escape") {
        close();
        pill.blur();
      }
    });

    // Close when clicking/tapping outside
    document.addEventListener("click", (e) => {
      if (di.dataset.open === "true" && !e.target.closest("#di-pill")) close();
    });

    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape") close();
    });
  })();
</script>
