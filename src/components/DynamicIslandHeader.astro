}

/* --- Palette Items --- */
.di-palette-item {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 8px 18px;
  text-decoration: none;
  color: var(--di-text-secondary);
  border-left: 2px solid transparent;
