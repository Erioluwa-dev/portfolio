  border-radius: 4px;
  letter-spacing: 1px;
}
.di-palette-item:hover .di-palette-item-shortcut,
.di-palette-item.focused .di-palette-item-shortcut {
  color: var(--di-accent);
  border-color: rgba(84, 197, 248, 0.3);
}

/* --- Palette Footer --- */
.di-palette-footer {
  display: flex;
  gap: 14px;
  padding: 10px 18px;
  border-top: 1px solid rgba(255, 255, 255, 0.06);
  margin-top: auto;
}
.di-palette-hint {
  font-size: 0.55rem;
  color: var(--di-text-muted);
  letter-spacing: 1px;
}

/* ============================================================
   MOBILE (< 640px)
   ============================================================ */
@media (max-width: 640px) {
  .di-header {
    padding-top: 12px;
  }

  /* Always compact pill on mobile */
  .di-container {
    width: var(--di-width-compact);
    min-height: var(--di-height-compact);
    border-radius: var(--di-radius-compact);
  }
  .di-header[data-state="compact"] .di-container {
    width: var(--di-width-compact);
    min-height: var(--di-height-compact);
    border-radius: var(--di-radius-compact);
    padding: 0;
  }
  .di-header[data-state="compact"] .di-main-row {
    justify-content: center;
    padding: 0 14px;
    min-height: var(--di-height-compact);
    gap: 0;
  }

  /* Hide dot on mobile */
  .di-container::before {
    display: none;
  }

  /* Hide desktop nav/actions */
  .di-nav,
  .di-actions {
    display: none;
  }

  /* Show ⌘K */
  .di-compact-search {
    display: flex;
  }

  /* Nav open on mobile: island expands */
  .di-header[data-nav-open="true"] .di-container {
    width: min(360px, calc(100vw - 24px));
    min-height: auto;
    border-radius: 20px;
    padding: 0;
    box-shadow: 0 12px 48px rgba(0, 0, 0, 0.5);
  }

  .di-header[data-nav-open="true"] .di-main-row {
    justify-content: flex-start;
    padding: 0 14px;
    min-height: 48px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  }

  /* Close button replaces ⌘K */
  .di-header[data-nav-open="true"] .di-compact-search {
    position: absolute;
    right: 10px;
    opacity: 1;
    pointer-events: auto;
    display: flex;
  }

  /* Show nav links vertically inside island */
  .di-header[data-nav-open="true"] .di-nav {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 2px;
    width: 100%;
    padding: 10px 14px 14px;
    opacity: 1;
    visibility: visible;
  }

  .di-header[data-nav-open="true"] .di-nav-link {
    width: 100%;
    text-align: center;
    padding: 12px 16px;
    font-size: 0.95rem;
    border-radius: 12px;
    opacity: 1;
    transform: translateY(0);
    transition-delay: calc(0.2s + var(--i, 0) * 0.06s);
  }

  .di-header[data-nav-open="true"] .di-nav-link:hover,
  .di-header[data-nav-open="true"] .di-nav-link:focus-visible {
    background: var(--di-accent-bg);
    color: var(--di-text);
  }

  /* Hide indicator on mobile */
  .di-indicator {
    display: none;
  }

  /* Hide palette on mobile */
  .di-palette {
    display: none;
  }
}

/* ============================================================
   TABLET
   ============================================================ */
@media (min-width: 641px) and (max-width: 820px) {
  .di-container {
    --di-width-expanded: min(680px, calc(100vw - 24px));
  }
  .di-nav {
    gap: 0;
  }
  .di-nav-link {
    padding: 6px 10px;
    font-size: 0.8rem;
  }
  .di-actions {
    gap: 4px;
  }
}

/* ============================================================
   SMALL MOBILE
   ============================================================ */
@media (max-width: 400px) {
  .di-container {
    --di-width-compact: 190px;
  }
  .di-logo-text {
    font-size: 0.95rem;
  }
}

/* ============================================================
   REDUCED MOTION
   ============================================================ */
@media (prefers-reduced-motion: reduce) {
  .di-container,
  .di-main-row,
  .di-nav,
  .di-nav-link,
  .di-actions,
  .di-social-btn,
  .di-search-btn,
  .di-compact-search,
  .di-palette,
  .di-palette-header,
  .di-palette-search,
  .di-palette-item,
  .di-palette-footer {
    transition: none !important;
    animation: none !important;
  }
}
</style>

<script>
// ============================================================
// Dynamic Island — State Orchestration
// ============================================================
(function () {
  "use strict";

  // --- DOM refs ---
  const header = document.getElementById("di-header");
  const container = document.getElementById("di-container");
  const nav = document.getElementById("di-nav");
  const indicator = document.getElementById("di-indicator");
  const navLinks = document.querySelectorAll(".di-nav-link");
  const searchBtn = document.getElementById("di-search-btn");
  const compactSearch = document.getElementById("di-compact-search");
  const palette = document.getElementById("di-palette");
  const paletteInput = document.getElementById("di-palette-input");
  const paletteItems = document.querySelectorAll(".di-palette-item");

  // --- State ---
  let isNavOpen = false;
  let isPaletteOpenState = false;
  let paletteFocusIndex = -1;
  let activeSection = "";
  let prefersReducedMotion = false;

  const motionQuery = window.matchMedia("(prefers-reduced-motion: reduce)");
  prefersReducedMotion = motionQuery.matches;
  motionQuery.addEventListener("change", () => {
    prefersReducedMotion = motionQuery.matches;
  });

  const SECTION_IDS = [
    ...new Set(Array.from(navLinks).map(function (l) { return l.dataset.section; })),
  ];

  // ==========================================================
  // ACTIVE SECTION
  // ==========================================================
  function updateIndicator(activeLink) {
    if (!indicator || !activeLink || prefersReducedMotion) return;
    if (nav.offsetParent === null) return;
    var navRect = nav.getBoundingClientRect();
    var linkRect = activeLink.getBoundingClientRect();
    indicator.style.width = linkRect.width + "px";
    indicator.style.transform = "translateX(" + (linkRect.left - navRect.left) + "px)";
  }

  function setActiveSection(id) {
    if (id === activeSection) return;
    activeSection = id;
    navLinks.forEach(function (link) {
      var isActive = link.dataset.section === id;
      link.classList.toggle("active", isActive);
      if (isActive) updateIndicator(link);
    });
  }

  var sectionObserver = new IntersectionObserver(
    function (entries) {
      var bestEntry = null;
      var bestRatio = 0;
      entries.forEach(function (entry) {
        if (entry.intersectionRatio > bestRatio) {
          bestRatio = entry.intersectionRatio;
          bestEntry = entry;
        }
      });
      if (bestEntry && bestRatio > 0.15) {
        setActiveSection(bestEntry.target.id);
      }
    },
    { threshold: [0.15, 0.3, 0.5, 0.7], rootMargin: "-80px 0px -20% 0px" }
  );

  SECTION_IDS.forEach(function (id) {
    var el = document.getElementById(id);
    if (el) {
      sectionObserver.observe(el);
    } else {
      var fallback = document.querySelector("[id='" + id + "'], [data-section='" + id + "']");
      if (fallback) sectionObserver.observe(fallback);
    }
  });

  // ==========================================================
  // NAV TOGGLE (mobile tap / desktop click)
  // ==========================================================
  function openNav() {
    isNavOpen = true;
    header.dataset.navOpen = "true";
    header.dataset.state = "compact";
  }

  function closeNav() {
    isNavOpen = false;
    header.dataset.navOpen = "false";
    header.dataset.state = "compact";
  }

  function toggleNav() {
    if (isPaletteOpenState) return;
    if (isNavOpen) {
      closeNav();
    } else {
      openNav();
    }
  }

  // ==========================================================
  // COMMAND PALETTE — Unfold / fold with sequencing
  // ==========================================================
  function openPalette() {
    if (isPaletteOpenState) return;
    isPaletteOpenState = true;
    if (isNavOpen) closeNav();

    // Ensure we're in compact state
    header.dataset.state = "compact";

    // Trigger phase 1: Nav fades out (CSS handles immediately),
    // palette max-height expands (CSS handles with 0.12s delay)
    header.dataset.paletteOpen = "true";

    paletteFocusIndex = -1;
    updatePaletteFocus();

    // Focus input after animations settle
    setTimeout(function () {
      if (paletteInput) paletteInput.focus();
    }, 450);
  }

  function closePalette() {
    if (!isPaletteOpenState) return;
    // Trigger closing animation (reverse order)
    header.dataset.paletteOpen = "closing";

    if (paletteInput) {
      paletteInput.value = "";
      paletteInput.blur();
    }

    // Reset search filter
    paletteItems.forEach(function (item) {
      item.style.display = "";
    });

    // After closing animation completes, reset state
    setTimeout(function () {
      isPaletteOpenState = false;
      paletteFocusIndex = -1;
      updatePaletteFocus();
      header.dataset.paletteOpen = "false";
      header.dataset.state = "compact";
    }, 750); // match closing animation total duration
  }

  function updatePaletteFocus() {
    paletteItems.forEach(function (item, i) {
      item.classList.toggle("focused", i === paletteFocusIndex);
    });
  }

  function movePaletteFocus(direction) {
    var visible = Array.from(paletteItems).filter(function (item) {
      return item.style.display !== "none";
    });
    if (visible.length === 0) return;
    var currentIndex = visible.indexOf(paletteItems[paletteFocusIndex]);
    if (currentIndex === -1) currentIndex = direction > 0 ? -1 : 0;
    var nextIndex = (currentIndex + direction + visible.length) % visible.length;
    var globalIndex = Array.from(paletteItems).indexOf(visible[nextIndex]);
    paletteFocusIndex = globalIndex;
    updatePaletteFocus();
    visible[nextIndex].scrollIntoView({ block: "nearest" });
  }

  // ==========================================================
  // EVENT BINDING
  // ==========================================================

  // --- Container click: compact → nav (mobile) or palette (⌘K) ---
  container.addEventListener("click", function (e) {
    if (isPaletteOpenState) return;

    // ⌘K button opens palette (desktop only)
    if (e.target.closest("#di-compact-search")) {
      e.preventDefault();
      if (window.innerWidth > 640) {
        openPalette();
      } else {
        toggleNav();
      }
      return;
    }

    // Search button opens palette (desktop only)
    if (e.target.closest("#di-search-btn")) {
      e.preventDefault();
      openPalette();
      return;
    }

    // On mobile, tapping the compact pill toggles nav
    if (window.innerWidth <= 640) {
      var link = e.target.closest("a");
      // Clicking a nav link when already open → let it navigate
      if (link && isNavOpen && !link.classList.contains("di-logo")) return;
      // Logo in nav-open state → don't navigate, close nav instead
      if (link && link.classList.contains("di-logo")) {
        e.preventDefault();
        if (isNavOpen) { closeNav(); return; }
      }
      if (isNavOpen && !e.target.closest(".di-main-row")) return;
      e.preventDefault();
      toggleNav();
    }
  });

  // --- Keyboard: ⌘K / Ctrl+K to toggle palette ---
  document.addEventListener("keydown", function (e) {
    if ((e.metaKey || e.ctrlKey) && e.key === "k") {
      e.preventDefault();
      if (isPaletteOpenState) {
        closePalette();
      } else {
        openPalette();
      }
    }

    // Escape
    if (e.key === "Escape") {
      if (isPaletteOpenState) {
        closePalette();
      } else if (isNavOpen && window.innerWidth <= 640) {
        closeNav();
      }
    }
  });

  // --- Palette keyboard navigation ---
  document.addEventListener("keydown", function (e) {
    if (!isPaletteOpenState) return;

    if (e.key === "ArrowDown") {
      e.preventDefault();
      movePaletteFocus(1);
    } else if (e.key === "ArrowUp") {
      e.preventDefault();
      movePaletteFocus(-1);
    } else if (e.key === "Enter" && paletteFocusIndex >= 0) {
      e.preventDefault();
      var item = paletteItems[paletteFocusIndex];
      if (item && item.style.display !== "none") {
        // Blur input to allow navigation
        if (paletteInput) paletteInput.blur();
        closePalette();
        // Navigate after palette closes
        setTimeout(function () {
          item.click();
        }, 300);
      }
    }
  });

  // --- Close palette when clicking outside ---
  document.addEventListener("click", function (e) {
    if (!isPaletteOpenState) return;
    if (!e.target.closest("#di-palette") && !e.target.closest(".di-container")) {
      closePalette();
    }
  });

  // --- Palette item click closes palette ---
  paletteItems.forEach(function (item) {
    item.addEventListener("click", function () {
      closePalette();
    });
  });

  // --- Palette search filter ---
  if (paletteInput) {
    paletteInput.addEventListener("input", function () {
      var query = paletteInput.value.toLowerCase();
      paletteItems.forEach(function (item) {
        var label = (item.querySelector(".di-palette-item-label") || {}).textContent || "";
        item.style.display = label.toLowerCase().includes(query) ? "" : "none";
      });
      paletteFocusIndex = -1;
      updatePaletteFocus();
    });
  }

  // --- Close palette on resize to mobile ---
  window.addEventListener("resize", function () {
    if (isPaletteOpenState && window.innerWidth <= 640) {
      closePalette();
    }
  });

  // --- Mobile: close nav when clicking a link ---
  navLinks.forEach(function (link) {
    link.addEventListener("click", function () {
      if (window.innerWidth <= 640 && isNavOpen) {
        closeNav();
      }
    });
  });

  // ==========================================================
  // WINDOW EVENTS
  // ==========================================================

  var resizeTimer;
  window.addEventListener("resize", function () {
    clearTimeout(resizeTimer);
    resizeTimer = setTimeout(function () {
      if (activeSection) {
        var active = document.querySelector(".di-nav-link.active");
        if (active) updateIndicator(active);
      }
    }, 100);
  });

  // ==========================================================
  // INIT
  // ==========================================================

  var firstLink = navLinks[0];
  if (firstLink) {
    setTimeout(function () {
      if (!activeSection && firstLink) {
        firstLink.classList.add("active");
        updateIndicator(firstLink);
      }
    }, 50);
  }

  console.log("✦ Dynamic Island — 3-state morphing header initialized");
})();
</script>
