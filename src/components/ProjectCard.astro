---
import type { Project } from '../data/site';
import { statusLabel } from '../data/site';

interface Props {
  project: Project;
  expanded?: boolean;
}

const { project, expanded = false } = Astro.props;
const p = project;
---

<article class:list={["project", "card", p.flagship ? "card-teal" : "", expanded ? "is-expanded" : ""]}>
  <header class="project-head">
    <span class:list={["tag", "tag-pill", p.status === "building" ? "tag-live" : ""]}>
      {p.status === "building" && <span class="dot dot-pulse"></span>}
      {statusLabel[p.status]}
    </span>
    <span class="tag project-kind">{p.kind}</span>
  </header>

  <h3 class="h2 project-name">{p.name}</h3>

  <p class="lead project-summary">{p.summary}</p>

  {expanded && <p class="project-detail">{p.detail}</p>}

  <ul class="project-stack">
    {p.stack.map((s) => <li class="tag stack-chip">{s}</li>)}
  </ul>

  {(p.repo || p.live) && (
    <div class="project-links">
      {p.repo && (
        <a class="link-arrow" href={p.repo} target="_blank" rel="noopener noreferrer">
          Read the code
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M5 12h13M13 6l6 6-6 6" />
          </svg>
        </a>
      )}
      {p.live && (
        <a class="link-arrow" href={p.live} target="_blank" rel="noopener noreferrer">
          Open it
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M5 12h13M13 6l6 6-6 6" />
          </svg>
        </a>
      )}
    </div>
  )}
</article>

<style>
  .project { gap: 16px; height: 100%; }

  .project-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
  }

  .project-kind { opacity: 0.6; }

  .project-name { margin: 4px 0 0; }

  .project-summary { max-width: 46ch; }

  .project-detail {
    margin: 0;
    font-size: var(--fs-body);
    line-height: 1.68;
    opacity: 0.78;
    max-width: 62ch;
  }

  .project-stack {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: auto 0 0;
    padding: 0;
    list-style: none;
  }

  .stack-chip {
    padding: 6px 10px;
    border-radius: var(--r-pill);
    border: 1px solid currentColor;
    opacity: 0.5;
    text-transform: none;
    letter-spacing: 0.04em;
  }

  .project-links {
    display: flex;
    flex-wrap: wrap;
    gap: 20px;
    padding-top: 4px;
  }

  .is-expanded .project-summary { font-size: 1.2rem; }
</style>
