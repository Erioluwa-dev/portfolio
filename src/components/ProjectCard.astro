---
import type { Project } from '../data/site';
import { statusLabel } from '../data/site';

interface Props {
  project: Project;
  expanded?: boolean;
  /** Kept in step with the surrounding page so the outline never skips a level. */
  level?: 2 | 3;
}

const { project, expanded = false, level = 2 } = Astro.props;
const p = project;
const Heading = `h${level}` as 'h2' | 'h3';
---

<article
  class:list={[
    "project", "card", "card-scroll",
    p.flagship ? "card-teal" : "",
    expanded ? "is-expanded" : "",
  ]}
>
  <header class="project-head">
    <span class:list={["tag", "tag-pill", p.status === "building" ? "tag-live" : ""]}>
      {p.status === "building" && <span class="dot dot-pulse"></span>}
      {statusLabel[p.status]}
    </span>
    <span class="tag muted">{p.kind}</span>
  </header>

  <Heading class="h2 project-name">{p.name}</Heading>

  <p class="lead project-summary">{p.summary}</p>

  {expanded && <p class="body muted project-detail">{p.detail}</p>}

  <ul class="chip-list project-stack" aria-label={`${p.name} — built with`}>
    {p.stack.map((s) => <li class="tag chip">{s}</li>)}
  </ul>

  {(p.repo || p.live) && (
    <div class="project-links">
      {p.repo && (
        <a class="link-arrow" href={p.repo} target="_blank" rel="noopener noreferrer">
          Read the code
          <span class="sr-only"> for {p.name}</span>
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M5 12h13M13 6l6 6-6 6" />
          </svg>
        </a>
      )}
      {p.live && (
        <a class="link-arrow" href={p.live} target="_blank" rel="noopener noreferrer">
          Open it
          <span class="sr-only"> — {p.name}</span>
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M5 12h13M13 6l6 6-6 6" />
          </svg>
        </a>
      )}
    </div>
  )}
</article>

<style>
  .project { gap: var(--sp-2); height: 100%; }

  .project-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
  }

  .project-name { margin: 4px 0 0; }

  .project-summary { max-width: 46ch; }

  .project-detail { line-height: 1.62; max-width: 62ch; }

  /* Pinned to the foot of the card so a row of cards lines its chips up,
     but only when there is slack to give. */
  .project-stack { margin-top: auto; padding-top: var(--sp-1); }

  .project-links {
    display: flex;
    flex-wrap: wrap;
    gap: 20px;
    padding-top: 4px;
  }

  .is-expanded .project-summary { font-size: var(--fs-lead); }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
</style>
