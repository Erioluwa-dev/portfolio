<style>
  .site-footer {
    padding: 1.2rem 2.5rem;
    border-top: 1px solid #1a1a1a;
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.8rem;
  }

  .footer-text {
    font-size: 0.95rem;
    color: #fff;
    letter-spacing: 2px;
  }

  .footer-icons {
    display: flex;
    gap: 0.6rem;
  }

  .footer-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: #fff;
    background: #111;
    border: 1px solid #2a2a2a;
    padding: 0.45rem;
    border-radius: 2px;
    text-decoration: none;
    transition: all 0.2s;
  }
