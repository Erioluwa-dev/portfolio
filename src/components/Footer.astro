<footer class="site-footer">
  <div class="footer-text">Fawehinmi Erioluwa &middot; 2026</div>
  <div class="footer-icons">
    <a
      href="mailto:erioluwafawehinmi@gmail.com"
      class="icon-btn icon-email footer-icon"
    >
      <img src="https://cdn.simpleicons.org/gmail/fff" alt="Email" width="18" height="18" onerror="this.style.display='none'" />
    </a>
    <a
      href="https://github.com/erioluwafawehinmi"
      target="_blank"
      rel="noopener noreferrer"
