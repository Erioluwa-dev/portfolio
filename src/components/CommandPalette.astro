---
const pageItems = [
  { label: "Overview / Home", description: "LinkedIn x GitHub hybrid profile dashboard", href: "/" },
  { label: "About", description: "Learn about Erioluwa's background & path", href: "/#about" },
  { label: "Projects & Repositories", description: "Inspect open-source software and projects", href: "/#repos" },
  { label: "Blog", description: "Technical articles and engineering posts", href: "/letters" },
  { label: "Contact", description: "Get in touch / Hire Erioluwa", href: "/#contact" },
];

const projectItems = [
  { label: "CourtVision", description: "Conversational AI basketball analyst tracks players with YOLOv8 + DeepSORT", href: "https://github.com/Erioluwa-dev/CourtVision" },
  { label: "YEMS", description: "Offline-first school management system for low-connectivity environments", href: "https://github.com/Erioluwa-dev" },
  { label: "todo-app", description: "React + TypeScript task manager showcasing CRUD fundamentals", href: "https://github.com/Erioluwa-dev/todo-app" },
  { label: "portfolio", description: "This site's source: Astro & monochrome design system", href: "https://github.com/Erioluwa-dev" },
];

const letterItems = [
  { label: "Building CourtVision: A 26-Week Solo Journey", description: "Reflections on building a basketball analytics platform from scratch", href: "/letters/building-courtvision" },
  { label: "Why I Chose Astro for My Portfolio", description: "Why Astro became the foundation for my personal site over Next.js and Vite", href: "/letters/why-astro" },
  { label: "The Art of Shipping Solo Projects", description: "Perfectionism is the enemy of shipping. How to ship early and iterate", href: "/letters/shipping-solo-projects" },
];

const connectItems = [
  { label: "github", description: "@Erioluwa-dev", href: "https://github.com/Erioluwa-dev" },
  { label: "instagram", description: "@stay.with.eri", href: "https://instagram.com/stay.with.eri" },
  { label: "email", description: "erioluwafawehinmi@gmail.com", href: "mailto:erioluwafawehinmi@gmail.com" },
];
---

<!-- Trigger badge -->
<button id="cmdk-trigger" class="cmdk-trigger" title="Open command palette (Ctrl+K)">
  <span class="cmdk-trigger-key">Ctrl+K</span>
</button>

<!-- Overlay -->
<div id="cmdk-overlay" class="cmdk-overlay"></div>

<!-- Panel -->
<div id="cmdk-panel" class="cmdk-panel" role="dialog" aria-label="Command palette">
  <!-- Header with search -->
  <div class="cmdk-header">
    <input
      id="cmdk-input"
      type="text"
      placeholder="Type a command or search pages, projects..."
      class="cmdk-input"
      autocomplete="off"
      spellcheck="false"
    />
    <button id="cmdk-esc" class="cmdk-esc" title="Close (ESC)">ESC</button>
  </div>

  <!-- Scrollable body -->
  <div class="cmdk-body">
    <!-- Pages section -->
    <div class="cmdk-section" data-section="pages">
      <div class="cmdk-section-label">// pages</div>
      <div class="cmdk-items">
        {pageItems.map((item, i) => (
          <a
            href={item.href}
            class="cmdk-item"
            data-index={i}
            data-section="pages"
          >
            <div class="cmdk-item-content">
              <span class="cmdk-item-label">{item.label}</span>
              <span class="cmdk-item-description">{item.description}</span>
            </div>
          </a>
        ))}
      </div>
    </div>

    <!-- Projects section -->
    <div class="cmdk-section" data-section="projects">
      <div class="cmdk-section-label">// projects</div>
      <div class="cmdk-items">
        {projectItems.map((item, i) => (
          <a
            href={item.href}
            target="_blank"
            rel="noopener noreferrer"
            class="cmdk-item"
            data-index={i}
            data-section="projects"
          >
            <div class="cmdk-item-content">
              <span class="cmdk-item-label">{item.label}</span>
              <span class="cmdk-item-description">{item.description}</span>
            </div>
          </a>
        ))}
      </div>
    </div>

    <!-- Letters section -->
    <div class="cmdk-section" data-section="letters">
      <div class="cmdk-section-label">// letters</div>
      <div class="cmdk-items">
        {letterItems.map((item, i) => (
          <a
            href={item.href}
            class="cmdk-item"
            data-index={i}
            data-section="letters"
          >
            <div class="cmdk-item-content">
              <span class="cmdk-item-label">{item.label}</span>
              <span class="cmdk-item-description">{item.description}</span>
            </div>
          </a>
        ))}
      </div>
    </div>

    <!-- Connect section -->
    <div class="cmdk-section" data-section="connect">
      <div class="cmdk-section-label">// connect</div>
      <div class="cmdk-items">
        {connectItems.map((item, i) => (
          <a
            href={item.href}
            target={item.href.startsWith('http') ? '_blank' : undefined}
            rel={item.href.startsWith('http') ? 'noopener noreferrer' : undefined}
            class="cmdk-item"
            data-index={i}
            data-section="connect"
          >
            <div class="cmdk-item-content">
              <span class="cmdk-item-label">{item.label}</span>
              <span class="cmdk-item-description">{item.description}</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </div>

  <!-- Footer -->
  <div class="cmdk-footer">
    <span class="cmdk-footer-hint">
      <span class="cmdk-key">&#8593;&#8595;</span> navigate
    </span>
    <span class="cmdk-footer-hint">
      <span class="cmdk-key">&#9166;</span> select
    </span>
    <span class="cmdk-footer-hint">
      <span class="cmdk-key">&#8984;K</span>
    </span>
  </div>
</div>

<style>
  /* ── Command palette theme variables ── */
  :global(:root) {
    --cmdk-bg: #fdfdfd;
    --cmdk-bg-subtle: rgba(0, 0, 0, 0.04);
    --cmdk-border: rgba(0, 0, 0, 0.08);
    --cmdk-border-strong: rgba(0, 0, 0, 0.12);
    --cmdk-text: #2a2a2a;
    --cmdk-text-muted: #888;
    --cmdk-text-faint: #999;
    --cmdk-accent: #00DC82;
    --cmdk-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.15);
  }

  :global(html[data-theme="dark"]) {
    --cmdk-bg: #111;
    --cmdk-bg-subtle: #1a1a1a;
    --cmdk-border: #1a1a1a;
    --cmdk-border-strong: #262626;
    --cmdk-text: #e0e0e0;
    --cmdk-text-muted: #555;
    --cmdk-text-faint: #444;
    --cmdk-accent: #00DC82;
    --cmdk-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
  }

  /* Trigger badge */
  .cmdk-trigger {
    position: fixed;
    bottom: 24px;
    right: 24px;
    z-index: 90;
    background: var(--cmdk-bg);
    border: 1px solid var(--cmdk-border);
    border-radius: 6px;
    padding: 0.4rem 0.75rem;
    cursor: pointer;
    transition: all 0.18s ease;
    font-family: 'Lora', Georgia, serif;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
  }

  .cmdk-trigger:hover {
    border-color: var(--cmdk-accent);
  }

  .cmdk-trigger-key {
    font-size: 0.75rem;
    color: var(--cmdk-text-muted);
    letter-spacing: 1px;
  }

  .cmdk-trigger:hover .cmdk-trigger-key {
    color: var(--cmdk-accent);
  }

  /* Overlay */
  .cmdk-overlay {
    position: fixed;
    inset: 0;
    z-index: 99;
    background: rgba(0, 0, 0, 0.4);
    backdrop-filter: blur(4px);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.15s ease;
  }

  .cmdk-overlay.visible {
    opacity: 1;
    pointer-events: auto;
  }

  /* Panel - centered */
  .cmdk-panel {
    position: fixed;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%) scale(0.96);
    z-index: 100;
    width: min(540px, 90vw);
    max-height: 80vh;
    background: var(--cmdk-bg);
    border: 1px solid var(--cmdk-border);
    border-radius: 12px;
    display: flex;
    flex-direction: column;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.15s ease, transform 0.15s ease;
    overflow: hidden;
    font-family: 'Lora', Georgia, serif;
    box-shadow: var(--cmdk-shadow);
  }

  .cmdk-panel.visible {
    opacity: 1;
    transform: translate(-50%, -50%) scale(1);
    pointer-events: auto;
  }

  /* Header with search */
  .cmdk-header {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.875rem 1rem;
    border-bottom: 1px solid var(--cmdk-border);
  }

  .cmdk-input {
    flex: 1;
    background: transparent;
    border: none;
    outline: none;
    color: var(--cmdk-text);
    font-size: 0.95rem;
    font-family: 'Lora', Georgia, serif;
    caret-color: var(--cmdk-accent);
  }

  .cmdk-input::placeholder {
    color: var(--cmdk-text-muted);
  }

  .cmdk-esc {
    background: transparent;
    border: 1px solid var(--cmdk-border-strong);
    border-radius: 4px;
    padding: 0.2rem 0.5rem;
    cursor: pointer;
    font-size: 0.65rem;
    color: var(--cmdk-text-muted);
    letter-spacing: 1px;
    font-family: 'Lora', Georgia, serif;
    transition: all 0.12s ease;
  }

  .cmdk-esc:hover {
    border-color: var(--cmdk-text-muted);
    color: var(--cmdk-text);
  }

  /* Scrollable body */
  .cmdk-body {
    flex: 1;
    overflow-y: auto;
    padding: 0.5rem 0;
  }

  /* Sections */
  .cmdk-section {
    padding: 0.25rem 0;
  }

  .cmdk-section-label {
    font-size: 0.65rem;
    color: var(--cmdk-text-muted);
    letter-spacing: 2px;
    text-transform: uppercase;
    padding: 0.5rem 1rem 0.35rem;
    font-weight: 600;
  }

  .cmdk-items {
    display: flex;
    flex-direction: column;
  }

  /* Items */
  .cmdk-item {
    display: flex;
    align-items: center;
    padding: 0.6rem 1rem;
    text-decoration: none;
    color: var(--cmdk-text-muted);
    transition: all 0.1s ease;
    border-left: 2px solid transparent;
  }

  .cmdk-item:hover,
  .cmdk-item.focused {
    background: var(--cmdk-bg-subtle);
    color: var(--cmdk-text);
    border-left-color: var(--cmdk-accent);
  }

  .cmdk-item-content {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    min-width: 0;
  }

  .cmdk-item-label {
    font-size: 0.875rem;
    color: inherit;
    letter-spacing: 0.3px;
  }

  .cmdk-item-description {
    font-size: 0.75rem;
    color: var(--cmdk-text-faint);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .cmdk-item:hover .cmdk-item-description,
  .cmdk-item.focused .cmdk-item-description {
    color: var(--cmdk-text-muted);
  }

  /* Footer */
  .cmdk-footer {
    padding: 0.6rem 1rem;
    border-top: 1px solid var(--cmdk-border);
    display: flex;
    gap: 1rem;
    align-items: center;
  }

  .cmdk-footer-hint {
    font-size: 0.7rem;
    color: var(--cmdk-text-faint);
    letter-spacing: 0.5px;
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }

  .cmdk-key {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 1.25rem;
    height: 1.25rem;
    padding: 0 0.3rem;
    background: var(--cmdk-bg-subtle);
    border: 1px solid var(--cmdk-border-strong);
    border-radius: 3px;
    font-size: 0.65rem;
    color: var(--cmdk-text-muted);
  }

  /* Scrollbar */
  .cmdk-body::-webkit-scrollbar { width: 4px; }
  .cmdk-body::-webkit-scrollbar-track { background: transparent; }
  .cmdk-body::-webkit-scrollbar-thumb { background: var(--cmdk-border-strong); border-radius: 2px; }

  /* Body lock */
  :global(body.cmdk-open) {
    overflow: hidden;
  }
</style>

<script>
  const panel = document.getElementById('cmdk-panel');
  const overlay = document.getElementById('cmdk-overlay');
  const trigger = document.getElementById('cmdk-trigger');
  const escBtn = document.getElementById('cmdk-esc');
  const input = document.getElementById('cmdk-input') as HTMLInputElement;
  const sections = document.querySelectorAll('.cmdk-section');
  let isOpen = false;
  let focusIndex = -1;

  // Read theme from the html element (set by DynamicIslandHeader)
  function getTheme() {
    return document.documentElement.getAttribute('data-theme') || 'dark';
  }

  function applyTheme() {
    const theme = getTheme();
    panel?.setAttribute('data-theme', theme);
    trigger?.setAttribute('data-theme', theme);
  }

  // Observe theme changes on <html>
  const observer = new MutationObserver(() => applyTheme());
  observer.observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });

  // Apply on load
  applyTheme();

  function getAllItems(): HTMLElement[] {
    return Array.from(panel?.querySelectorAll('.cmdk-item') ?? []);
  }

  function getVisibleItems(): HTMLElement[] {
    return getAllItems().filter(item => (item as HTMLElement).style.display !== 'none');
  }

  function open() {
    if (isOpen) return;
    isOpen = true;
    applyTheme();
    panel?.classList.add('visible');
    overlay?.classList.add('visible');
    trigger?.style.setProperty('display', 'none');
    document.body.classList.add('cmdk-open');
    focusIndex = -1;
    updateFocus();
    setTimeout(() => input?.focus(), 50);
  }

  function close() {
    if (!isOpen) return;
    isOpen = false;
    panel?.classList.remove('visible');
    overlay?.classList.remove('visible');
    trigger?.style.removeProperty('display');
    document.body.classList.remove('cmdk-open');
    focusIndex = -1;
    updateFocus();
    if (input) input.value = '';
    resetVisibility();
  }

  function resetVisibility() {
    sections.forEach(section => {
      (section as HTMLElement).style.display = '';
    });
    getAllItems().forEach(item => {
      (item as HTMLElement).style.display = '';
    });
  }

  function updateFocus() {
    const visible = getVisibleItems();
    visible.forEach((item, i) => {
      item.classList.toggle('focused', i === focusIndex);
    });
  }

  function moveFocus(direction: number) {
    const visible = getVisibleItems();
    const total = visible.length;
    if (total === 0) return;
    focusIndex = (focusIndex + direction + total) % total;
    updateFocus();
    visible[focusIndex]?.scrollIntoView({ block: 'nearest' });
  }

  // Keyboard shortcut
  document.addEventListener('keydown', (e) => {
    if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
      e.preventDefault();
      isOpen ? close() : open();
    }

    if (e.key === 'Escape' && isOpen) {
      close();
    }

    if (isOpen) {
      if (e.key === 'ArrowDown') {
        e.preventDefault();
        moveFocus(1);
      } else if (e.key === 'ArrowUp') {
        e.preventDefault();
        moveFocus(-1);
      } else if (e.key === 'Enter' && focusIndex >= 0) {
        e.preventDefault();
        const visible = getVisibleItems();
        (visible[focusIndex] as HTMLAnchorElement)?.click();
        close();
      }
    }
  });

  // Click outside
  overlay?.addEventListener('click', close);

  // Trigger button
  trigger?.addEventListener('click', open);

  // ESC button
  escBtn?.addEventListener('click', close);

  // Nav clicks close panel
  getAllItems().forEach((item) => {
    item.addEventListener('click', () => {
      close();
    });
  });

  // Filter items on search
  input?.addEventListener('input', () => {
    const query = input.value.toLowerCase();

    sections.forEach(section => {
      const items = section.querySelectorAll('.cmdk-item');
      let hasVisible = false;

      items.forEach(item => {
        const label = item.querySelector('.cmdk-item-label')?.textContent?.toLowerCase() || '';
        const desc = item.querySelector('.cmdk-item-description')?.textContent?.toLowerCase() || '';
        const matches = label.includes(query) || desc.includes(query);
        (item as HTMLElement).style.display = matches ? 'flex' : 'none';
        if (matches) hasVisible = true;
      });

      (section as HTMLElement).style.display = hasVisible ? '' : 'none';
    });

    focusIndex = -1;
    updateFocus();
  });
</script>
