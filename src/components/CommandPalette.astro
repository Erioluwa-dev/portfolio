---
import { projects, letters, social } from '../data/site';

const groups = [
  {
    name: "Pages",
    items: [
      { label: "Home", note: "The short version", href: "/" },
      { label: "Projects", note: "Everything I have built", href: "/projects" },
      { label: "About", note: "How I got here", href: "/about" },
      { label: "Letters", note: "Notes from inside the build", href: "/letters" },
      { label: "Contact", note: "Start a conversation", href: "/contact" },
    ],
  },
  {
    name: "Projects",
    items: projects.map((p) => ({
      label: p.name,
      note: p.summary,
      href: p.repo ?? "/projects",
    })),
  },
  {
    name: "Letters",
    items: letters.map((l) => ({ label: l.title, note: l.excerpt, href: `/letters/${l.slug}` })),
  },
  {
    name: "Elsewhere",
    items: [
      { label: "Email", note: social.email, href: `mailto:${social.email}` },
      { label: "GitHub", note: "Erioluwa-dev", href: social.github },
      { label: "Instagram", note: "stay.with.eri", href: social.instagram },
    ],
  },
];
---

<button id="cmdk-trigger" class="trigger" aria-label="Open search (Control K)">
  <span class="tag">Search</span>
  <kbd class="key">Ctrl K</kbd>
</button>

<div id="cmdk-overlay" class="overlay" hidden></div>

<div id="cmdk-panel" class="panel" role="dialog" aria-modal="true" aria-label="Search the site" hidden>
  <div class="panel-head">
    <input
      id="cmdk-input"
      class="input"
      type="text"
      placeholder="Search pages, projects, letters..."
      autocomplete="off"
      spellcheck="false"
    />
    <kbd class="key">Esc</kbd>
  </div>

  <div class="panel-body" id="cmdk-body">
    {groups.map((g) => (
      <section class="group" data-group>
        <p class="tag group-name">{g.name}</p>
        {g.items.map((item) => (
          <a
            class="item"
            href={item.href}
            data-item
            data-search={`${item.label} ${item.note}`.toLowerCase()}
          >
            <span class="item-label">{item.label}</span>
            <span class="item-note">{item.note}</span>
          </a>
        ))}
      </section>
    ))}

    <p class="empty" id="cmdk-empty" hidden>Nothing matches that. Try a project name.</p>
  </div>
</div>

<style>
  .trigger {
    position: fixed;
    right: 20px;
    bottom: 20px;
    z-index: 900;
    display: inline-flex;
    align-items: center;
    gap: 9px;
    padding: 11px 15px;
    border: 1px solid var(--hairline);
    border-radius: var(--r-pill);
    background: var(--chalk);
    color: var(--ink-soft);
    cursor: pointer;
    transition: transform 0.18s ease, border-color 0.18s ease, color 0.18s ease;
  }

  .trigger:hover {
    transform: translateY(-2px);
    border-color: var(--ink);
    color: var(--ink);
  }

  .key {
    font-family: var(--mono);
    font-size: 0.65rem;
    letter-spacing: 0.08em;
    padding: 4px 7px;
    border-radius: 6px;
    background: var(--paper);
    border: 1px solid var(--hairline);
  }

  .overlay {
    position: fixed;
    inset: 0;
    z-index: 1500;
    background: rgba(23, 22, 15, 0.42);
    backdrop-filter: blur(2px);
  }

  /* These carry a display value, so the UA [hidden] rule needs restating. */
  .overlay[hidden],
  .panel[hidden],
  .group[hidden],
  .item[hidden],
  .empty[hidden] { display: none; }

  .panel {
    position: fixed;
    z-index: 1600;
    top: 12vh;
    left: 50%;
    transform: translateX(-50%);
    width: min(600px, calc(100vw - 32px));
    max-height: 66vh;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border-radius: var(--r-lg);
    background: var(--chalk);
    border: 1px solid var(--hairline);
    box-shadow: 0 26px 60px rgba(23, 22, 15, 0.3);
  }

  .panel-head {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 18px 22px;
    border-bottom: 1px solid var(--hairline);
  }

  .input {
    flex: 1;
    min-width: 0;
    border: 0;
    background: none;
    color: var(--ink);
    font-family: var(--body);
    font-size: 1.02rem;
    outline: none;
  }

  .input::placeholder { color: var(--ink-faint); }

  .panel-body {
    overflow-y: auto;
    padding: 10px 12px 16px;
  }

  .group { padding-top: 10px; }

  .group-name {
    margin: 0 0 4px;
    padding: 0 10px;
    color: var(--ink-faint);
  }

  .item {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 10px 12px;
    border-radius: var(--r-md);
    text-decoration: none;
    color: inherit;
  }

  .item:hover,
  .item.is-active {
    background: var(--amber);
    color: var(--on-amber);
  }

  .item-label { font-weight: 600; font-size: 0.95rem; }

  .item-note {
    font-size: 0.82rem;
    color: var(--ink-soft);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .item:hover .item-note,
  .item.is-active .item-note { color: inherit; opacity: 0.75; }

  .empty {
    margin: 0;
    padding: 22px 12px;
    color: var(--ink-faint);
    text-align: center;
  }

  @media (max-width: 620px) {
    .trigger { right: 14px; bottom: 14px; }
  }
</style>

<script>
  (function () {
    const trigger = document.getElementById("cmdk-trigger");
    const overlay = document.getElementById("cmdk-overlay");
    const panel = document.getElementById("cmdk-panel");
    const input = document.getElementById("cmdk-input") as HTMLInputElement | null;
    const empty = document.getElementById("cmdk-empty");
    if (!trigger || !overlay || !panel || !input || !empty) return;

    const items = Array.from(panel.querySelectorAll<HTMLAnchorElement>("[data-item]"));
    const groups = Array.from(panel.querySelectorAll<HTMLElement>("[data-group]"));
    let active = 0;

    const visible = () => items.filter((el) => !el.hidden);

    const paint = () => {
      const list = visible();
      if (active >= list.length) active = Math.max(0, list.length - 1);
      items.forEach((el) => el.classList.remove("is-active"));
      list[active]?.classList.add("is-active");
      list[active]?.scrollIntoView({ block: "nearest" });
    };

    const filter = (q: string) => {
      const term = q.trim().toLowerCase();
      items.forEach((el) => {
        el.hidden = term.length > 0 && !(el.dataset.search ?? "").includes(term);
      });
      groups.forEach((g) => {
        g.hidden = !Array.from(g.querySelectorAll<HTMLElement>("[data-item]")).some((el) => !el.hidden);
      });
      empty.hidden = visible().length > 0;
      active = 0;
      paint();
    };

    const open = () => {
      overlay.hidden = false;
      panel.hidden = false;
      input.value = "";
      filter("");
      input.focus();
    };

    const close = () => {
      overlay.hidden = true;
      panel.hidden = true;
    };

    trigger.addEventListener("click", open);
    overlay.addEventListener("click", close);
    input.addEventListener("input", () => filter(input.value));

    document.addEventListener("keydown", (e) => {
      if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === "k") {
        e.preventDefault();
        panel.hidden ? open() : close();
        return;
      }

      if (panel.hidden) return;

      if (e.key === "Escape") {
        close();
      } else if (e.key === "ArrowDown") {
        e.preventDefault();
        active = Math.min(active + 1, visible().length - 1);
        paint();
      } else if (e.key === "ArrowUp") {
        e.preventDefault();
        active = Math.max(active - 1, 0);
        paint();
      } else if (e.key === "Enter") {
        const target = visible()[active];
        if (target) {
          e.preventDefault();
          window.location.href = target.href;
        }
      }
    });
  })();
</script>
