---
import { projects, letters, social } from '../data/site';

const groups = [
  {
    name: "Pages",
    items: [
      { label: "Home", note: "The short version", href: "/" },
      { label: "Projects", note: "Everything I have built", href: "/projects" },
      { label: "About", note: "How I got here", href: "/about" },
      { label: "Letters", note: "Notes from inside the build", href: "/letters" },
      { label: "Contact", note: "Start a conversation", href: "/contact" },
    ],
  },
  {
    name: "Projects",
    items: projects.map((p) => ({
      label: p.name,
      note: p.summary,
      href: p.repo ?? "/projects",
    })),
  },
  {
    name: "Letters",
    items: letters.map((l) => ({ label: l.title, note: l.excerpt, href: `/letters/${l.slug}` })),
  },
  {
    name: "Elsewhere",
    items: [
      { label: "Email", note: social.email, href: `mailto:${social.email}` },
      { label: "GitHub", note: "Erioluwa-dev", href: social.github },
      { label: "Instagram", note: "stay.with.eri", href: social.instagram },
    ],
  },
];

// Options need stable ids so the input can point at the active one.
let n = 0;
const numbered = groups.map((g) => ({
  ...g,
  items: g.items.map((item) => ({ ...item, id: `cmdk-opt-${n++}` })),
}));
---

<div id="cmdk-overlay" class="overlay" hidden></div>

<div id="cmdk-panel" class="cmdk" role="dialog" aria-modal="true" aria-label="Search the site" hidden>
  <div class="cmdk-head">
    <input
      id="cmdk-input"
      class="input"
      type="text"
      role="combobox"
      aria-expanded="true"
      aria-controls="cmdk-body"
      aria-autocomplete="list"
      placeholder="Search pages, projects, letters..."
      autocomplete="off"
      spellcheck="false"
    />
    <kbd class="key">Esc</kbd>
  </div>

  <div class="cmdk-body" id="cmdk-body" role="listbox" aria-label="Results">
    {numbered.map((g) => (
      <section class="group" role="group" aria-label={g.name} data-group>
        <p class="group-name" aria-hidden="true">{g.name}</p>
        {g.items.map((item) => (
          <a
            class="item"
            id={item.id}
            role="option"
            aria-selected="false"
            href={item.href}
            data-item
            data-search={`${item.label} ${item.note}`.toLowerCase()}
          >
            <span class="item-label">{item.label}</span>
            <span class="item-note">{item.note}</span>
          </a>
        ))}
      </section>
    ))}

    <p class="empty" id="cmdk-empty" hidden>Nothing matches that. Try a project name.</p>
  </div>

  <p class="cmdk-foot" aria-hidden="true">Arrow keys to move, Enter to open, Esc to close</p>
</div>

<style>
  .key {
    font-family: inherit;
    font-size: 0.75rem;
    font-weight: 500;
    padding: 3px 7px;
    border-radius: 5px;
    border: 1px solid var(--line-strong);
    color: var(--ink-3);
  }

  .overlay {
    position: fixed;
    inset: 0;
    z-index: 1500;
    background: color-mix(in srgb, var(--bg) 55%, transparent);
    -webkit-backdrop-filter: blur(6px);
    backdrop-filter: blur(6px);
  }

  /* These carry a display value, so the UA [hidden] rule needs restating. */
  .overlay[hidden],
  .cmdk[hidden],
  .group[hidden],
  .item[hidden],
  .empty[hidden] { display: none; }

  .cmdk {
    position: fixed;
    z-index: 1600;
    top: 12vh;
    left: 50%;
    transform: translateX(-50%);
    width: min(600px, calc(100vw - 32px));
    max-height: 66vh;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border-radius: var(--r-lg);
    background: var(--surface);
    border: 1px solid var(--line-strong);
    box-shadow: 0 24px 64px rgba(0, 0, 0, 0.18);
  }

  .cmdk-head {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 16px 20px;
    border-bottom: 1px solid var(--line);
  }

  .input {
    flex: 1;
    min-width: 0;
    border: 0;
    background: none;
    color: var(--ink);
    font: inherit;
    font-size: 1.0625rem;
    outline: none;
  }

  .input::placeholder { color: var(--ink-3); }

  .cmdk-body {
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: 8px 10px 14px;
  }

  .cmdk-foot {
    margin: 0;
    padding: 10px 20px;
    border-top: 1px solid var(--line);
    color: var(--ink-3);
    font-size: 0.8125rem;
  }

  .group { padding-top: 10px; }

  .group-name {
    margin: 0 0 4px;
    padding: 0 10px;
    color: var(--ink-3);
    font-size: 0.8125rem;
    font-weight: 500;
  }

  .item {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 10px;
    border-radius: var(--r-sm);
    text-decoration: none;
    color: inherit;
  }

  .item:hover,
  .item.is-active {
    background: var(--yellow);
    color: var(--on-yellow);
  }

  .item-label { font-weight: 600; font-size: 0.975rem; }

  .item-note {
    font-size: 0.85rem;
    color: var(--ink-2);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .item:hover .item-note,
  .item.is-active .item-note { color: inherit; opacity: 0.8; }

  .empty {
    margin: 0;
    padding: 22px 12px;
    color: var(--ink-2);
    text-align: center;
  }

  @media (max-width: 620px) {
    .cmdk-foot { display: none; }
  }
</style>

<script>
  (function () {
    // Any element marked data-cmdk-open can ask for the palette.
    const triggers = Array.from(document.querySelectorAll<HTMLElement>("[data-cmdk-open]"));
    const overlay = document.getElementById("cmdk-overlay");
    const panel = document.getElementById("cmdk-panel");
    const input = document.getElementById("cmdk-input") as HTMLInputElement | null;
    const empty = document.getElementById("cmdk-empty");
    if (!overlay || !panel || !input || !empty) return;

    const items = Array.from(panel.querySelectorAll<HTMLAnchorElement>("[data-item]"));
    const groups = Array.from(panel.querySelectorAll<HTMLElement>("[data-group]"));
    // Everything the dialog covers is sealed off while it is open, so a
    // screen reader or a Tab press cannot wander behind it.
    const behind = ["#main", "#site-header", "footer"]
      .map((sel) => document.querySelector(sel))
      .filter((el): el is HTMLElement => el instanceof HTMLElement);

    let active = 0;
    let restoreFocusTo: HTMLElement | null = null;

    const visible = () => items.filter((el) => !el.hidden);

    const paint = () => {
      const list = visible();
      if (active >= list.length) active = Math.max(0, list.length - 1);
      items.forEach((el) => {
        el.classList.remove("is-active");
        el.setAttribute("aria-selected", "false");
      });
      const current = list[active];
      if (current) {
        current.classList.add("is-active");
        current.setAttribute("aria-selected", "true");
        current.scrollIntoView({ block: "nearest" });
        input.setAttribute("aria-activedescendant", current.id);
      } else {
        input.removeAttribute("aria-activedescendant");
      }
    };

    const filter = (q: string) => {
      const term = q.trim().toLowerCase();
      items.forEach((el) => {
        el.hidden = term.length > 0 && !(el.dataset.search ?? "").includes(term);
      });
      groups.forEach((g) => {
        g.hidden = !Array.from(g.querySelectorAll<HTMLElement>("[data-item]")).some((el) => !el.hidden);
      });
      empty.hidden = visible().length > 0;
      active = 0;
      paint();
    };

    const open = () => {
      const from = document.activeElement;
      restoreFocusTo = from instanceof HTMLElement && from !== document.body ? from : null;
      overlay.hidden = false;
      panel.hidden = false;
      behind.forEach((el) => el.setAttribute("inert", ""));
      input.value = "";
      filter("");
      input.focus();
    };

    const close = () => {
      if (panel.hidden) return;
      overlay.hidden = true;
      panel.hidden = true;
      behind.forEach((el) => el.removeAttribute("inert"));
      // Focus goes back where it came from, not to the top of the document.
      restoreFocusTo?.focus();
    };

    const move = (step: number) => {
      active = Math.min(Math.max(active + step, 0), Math.max(0, visible().length - 1));
      paint();
    };

    triggers.forEach((t) => t.addEventListener("click", open));
    overlay.addEventListener("click", close);
    input.addEventListener("input", () => filter(input.value));

    document.addEventListener("keydown", (e) => {
      if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === "k") {
        e.preventDefault();
        panel.hidden ? open() : close();
        return;
      }

      if (panel.hidden) return;

      if (e.key === "Escape") {
        e.preventDefault();
        close();
      } else if (e.key === "ArrowDown") {
        e.preventDefault();
        move(1);
      } else if (e.key === "ArrowUp") {
        e.preventDefault();
        move(-1);
      } else if (e.key === "Tab") {
        // Focus stays on the input; Tab walks the list like the arrows do,
        // so the dialog is never a place you can fall out the back of.
        e.preventDefault();
        move(e.shiftKey ? -1 : 1);
      } else if (e.key === "Enter") {
        const target = visible()[active];
        if (target) {
          e.preventDefault();
          window.location.href = target.href;
        }
      }
    });
  })();
</script>
