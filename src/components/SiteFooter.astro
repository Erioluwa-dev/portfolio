---
import { social } from '../data/site';

const elsewhere = [
  { label: "GitHub", href: social.github, external: true },
  { label: "Instagram", href: social.instagram, external: true },
  { label: "Email", href: `mailto:${social.email}`, external: false },
];

const year = new Date().getFullYear();
---

<footer class="bar">
  <p class="hand line">Made in Lagos, mostly at night.</p>

  <nav class="elsewhere" aria-label="Elsewhere">
    <span class="tag label">Elsewhere</span>
    <span class="links">
      {elsewhere.map((l) => (
        <a
          class="link"
          href={l.href}
          target={l.external ? "_blank" : undefined}
          rel={l.external ? "noopener noreferrer" : undefined}
        >
          {l.label}
        </a>
      ))}
    </span>
  </nav>

  <span class="tag place">Lagos, Nigeria &middot; &copy; {year}</span>
</footer>

<style>
  .bar {
    position: fixed;
    z-index: 1000;
    left: 0;
    right: 0;
    bottom: 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-4);
    height: var(--foot-h);
    padding: 0 var(--sp-5);
    background: var(--paper);
    border-top: 1px solid var(--hairline);
    transition: background 0.35s ease, border-color 0.35s ease;
  }

  .line {
    color: var(--ink-soft);
    white-space: nowrap;
  }

  .elsewhere {
    display: flex;
    align-items: baseline;
    gap: var(--sp-3);
  }

  .label { color: var(--ink-faint); }

  .links {
    display: flex;
    align-items: baseline;
    gap: var(--sp-3);
  }

  .link {
    font-size: var(--fs-small);
    font-weight: 600;
    color: var(--ink);
    text-decoration: none;
    padding: 4px 0;
    border-bottom: 1px solid transparent;
    transition: color 0.18s ease, border-color 0.18s ease;
  }

  .link:hover {
    color: var(--live-ink);
    border-bottom-color: currentColor;
  }

  .place { color: var(--ink-faint); }

  @media (max-width: 899px) {
    .bar {
      height: auto;
      min-height: var(--foot-h);
      padding: var(--sp-2) var(--sp-3);
      gap: var(--sp-2);
    }

    .line { display: none; }
    .elsewhere { flex-direction: column; align-items: flex-start; gap: 6px; }
  }

  @media (max-width: 480px) {
    .place { display: none; }
    .elsewhere { flex-direction: row; align-items: baseline; }
  }
</style>
