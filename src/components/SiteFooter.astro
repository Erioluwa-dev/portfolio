    path: "M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z",
  },
];
---

<footer class="bar">
  <span class="tag who">Fawehinmi Erioluwa &middot; Lagos</span>

  <!-- Where you are along the rail. Meaningful here: the panels are a sequence. -->
  <div class="progress" aria-hidden="true">
    <span class="tag counter" id="rail-counter">01</span>
    <span class="track"><span class="fill" id="rail-bar"></span></span>
  </div>

  <div class="reach">
    <a class="mail" href={`mailto:${social.email}`}>
      <span class="tag">Email me</span>
    </a>

    {links.map((l) => (
      <a class="icon" href={l.href} target="_blank" rel="noopener noreferrer" aria-label={l.label}>
        <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d={l.path} />
        </svg>
      </a>
    ))}
  </div>
</footer>

<style>
  .bar {
    position: fixed;
    z-index: 1000;
    left: var(--sp-3);
    right: var(--sp-3);
    bottom: var(--sp-3);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-3);
    height: var(--sp-5);
    padding: 0 var(--sp-3);
    border-radius: var(--r-pill);
    background: var(--chrome-bg);
    color: var(--chrome-fg);
    border: 1px solid var(--chrome-line);
    box-shadow: 0 8px 26px rgba(0, 0, 0, 0.24);
  }

  .who { color: var(--chrome-dim); }

  .progress {
    display: flex;
    align-items: center;
    gap: var(--sp-2);
    flex: 0 1 320px;
  }

  .counter { color: var(--amber); }

  .track {
    flex: 1;
    height: 3px;
    border-radius: var(--r-pill);
    background: var(--chrome-line);
    overflow: hidden;
  }

  .fill {
    display: block;
    height: 100%;
    border-radius: var(--r-pill);
    background: var(--amber);
    transform: scaleX(0.02);
    transform-origin: left center;
    transition: transform 0.18s ease-out;
  }

  .reach {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .mail {
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    padding: 0 var(--sp-2);
    border-radius: var(--r-pill);
    color: var(--chrome-fg);
    text-decoration: none;
    transition: background 0.18s ease;
  }

  .mail:hover { background: rgba(244, 241, 232, 0.14); }

  .icon {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    color: var(--chrome-dim);
    transition: background 0.18s ease, color 0.18s ease;
  }

  .icon:hover { background: rgba(244, 241, 232, 0.14); color: var(--chrome-fg); }

  /* No rail to track once the layout unwinds into a column. */
  @media (max-width: 899px) {
    .bar { height: 56px; gap: var(--sp-2); }
    .progress { display: none; }
  }

  @media (max-width: 480px) {
    .who { display: none; }
    .bar { justify-content: space-between; }
  }
</style>
