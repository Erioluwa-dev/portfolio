---
import { social } from '../data/site';

const elsewhere = [
  { label: "GitHub", href: social.github, external: true },
  { label: "Instagram", href: social.instagram, external: true },
  { label: "Email", href: `mailto:${social.email}`, external: false },
];

const year = new Date().getFullYear();
---

<footer class="footer">
  <p class="hand">Made in Lagos, mostly at night.</p>

  <nav class="links" aria-label="Elsewhere">
    {elsewhere.map((l) => (
      <a
        class="link"
        href={l.href}
        target={l.external ? "_blank" : undefined}
        rel={l.external ? "noopener noreferrer" : undefined}
      >
        {l.label}
      </a>
    ))}
  </nav>

  <p class="meta small faint">
    <span><span id="lagos-time">--:--</span> in Lagos</span>
    <span>© {year}</span>
  </p>
</footer>

<style>
  .footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem 2rem;
    flex-wrap: wrap;
    width: calc(100% - var(--gutter) * 2);
    max-width: var(--page-max);
    margin: 0 auto;
    padding: 2rem 0 2.5rem;
    border-top: 1px solid var(--line);
  }

  .links { display: flex; gap: 1.5rem; }

  .links .link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-size: var(--fs-sm);
  }

  .meta { display: flex; gap: 1.5rem; margin: 0; }

  @media (max-width: 719px) {
    .footer { flex-direction: column; align-items: flex-start; gap: 0.5rem; }
  }
</style>

<script>
  (function () {
    const el = document.getElementById("lagos-time");
    if (!el) return;

    const fmt = new Intl.DateTimeFormat("en-GB", {
      timeZone: "Africa/Lagos",
      hour: "2-digit",
      minute: "2-digit",
    });

    const tick = () => { el.textContent = fmt.format(new Date()); };
    tick();
    setInterval(tick, 20000);
  })();
</script>
