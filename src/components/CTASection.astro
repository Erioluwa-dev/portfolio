---
const buttons = [
  { label: "View Projects", href: "/#projects" },
  { label: "About Me", href: "/#about" },
  { label: "Letters", href: "/letters" },
];
---

<div class="cta-section">
  {buttons.map((b) => (
    <a href={b.href} class="cta-btn">{b.label}</a>
  ))}
  <a
    href="https://github.com/erioluwafawehinmi"
    target="_blank"
    rel="noopener noreferrer"
    class="icon-btn icon-github"
  >
      <img src="https://cdn.simpleicons.org/github/aaa" alt="GitHub" width="16" height="16" onerror="this.style.display='none'" />
  </a>
  <a href="mailto:erioluwafawehinmi@gmail.com" class="icon-btn icon-email">
      <img src="https://cdn.simpleicons.org/gmail/aaa" alt="Email" width="16" height="16" onerror="this.style.display='none'" />
  </a>
  <a
    href="https://instagram.com/stay.with.eri"
    target="_blank"
    rel="noopener noreferrer"
    class="icon-btn icon-instagram"
  >
      <img src="https://cdn.simpleicons.org/instagram/aaa" alt="Instagram" width="16" height="16" onerror="this.style.display='none'" />
  </a>
</div>

<style>
  .cta-section {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    flex-wrap: wrap;
    justify-content: center;
  }

  .cta-btn {
    font-size: 0.85rem;
    color: #aaa;
    background: transparent;
    border: 1px solid #2a2a2a;
    padding: 0.4rem 1rem;
    border-radius: 2px;
    cursor: pointer;
    text-decoration: none;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    font-family: inherit;
    transition: all 0.18s ease;
  }

  .icon-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    border: 1px solid #2a2a2a;
    border-radius: 2px;
    transition: all 0.18s ease;
  }
</style>
