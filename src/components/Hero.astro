---
// Hero: circular avatar + name, title, and short bio in muted dark gray.
---

<section id="top" class="hero">
  <div class="hero-avatar">
    <img src="/brand.jpg" alt="Fawehinmi Erioluwa" width="150" height="150" />
  </div>

  <div class="hero-info">
    <h1 class="hero-name">Fawehinmi Erioluwa</h1>
    <p class="hero-title">Frontend Engineer &middot; 17 &middot; Lagos, Nigeria</p>
    <p class="hero-bio">
      Self-taught developer building offline-first systems, AI-powered tools,
      and clean frontend interfaces. Currently deep in a 26-week solo build of
      CourtVision — a computer-vision basketball analyst.
    </p>
  </div>
</section>

<style>
  .hero {
    display: flex;
    align-items: center;
    gap: 2.5rem;
    padding: clamp(1rem, 3vw, 2rem) 0.5rem 2.5rem;
  }

  .hero-avatar {
    flex-shrink: 0;
    width: clamp(110px, 18vw, 150px);
    height: clamp(110px, 18vw, 150px);
    border-radius: 50%;
    overflow: hidden;
    background: var(--bg-subtle);
    box-shadow:
      0 8px 24px rgba(0, 0, 0, 0.18),
      inset 0 0 0 4px rgba(255, 255, 255, 0.55);
  }

  html[data-theme="dark"] .hero-avatar {
    box-shadow:
      0 8px 24px rgba(0, 0, 0, 0.4),
      inset 0 0 0 4px rgba(255, 255, 255, 0.1);
  }

  .hero-avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .hero-info {
    min-width: 0;
  }

  .hero-name {
    margin: 0 0 0.35rem;
    font-size: clamp(1.7rem, 4vw, 2.5rem);
    font-weight: 700;
    line-height: 1.1;
    color: var(--text);
    letter-spacing: -0.5px;
  }

  .hero-title {
    margin: 0 0 0.9rem;
    font-size: 0.9rem;
    font-weight: 600;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .hero-bio {
    margin: 0;
    max-width: 46ch;
    font-size: 1.02rem;
    line-height: 1.75;
    color: var(--text-muted);
  }

  @media (max-width: 620px) {
    .hero {
      flex-direction: column;
      text-align: center;
      gap: 1.5rem;
    }
    .hero-bio { margin-inline: auto; }
  }
</style>
