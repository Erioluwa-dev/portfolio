---
// The island is the only fixed chrome at the top.
// Desktop: a centered pill that expands on hover/click, with search beside it.
// Mobile (<=899px): a bar with search and a hamburger; the menu drops down
// out of the island itself rather than sliding in from the side.
interface Props {
  path: string;
}

const { path } = Astro.props;

const links = [
  { label: "Home", href: "/" },
  { label: "Projects", href: "/projects" },
  { label: "About", href: "/about" },
  { label: "Letters", href: "/letters" },
  { label: "Contact", href: "/contact" },
];

const isActive = (href: string) =>
  href === "/" ? path === "/" : path.startsWith(href);

const current = links.find((l) => isActive(l.href))?.label ?? "Home";
---

<!-- ══════ Desktop pill  ══════ -->
<header id="island" class="island" data-open="false">
  <div
    class="pill"
    id="pill"
    role="button"
    tabindex="0"
    aria-expanded="false"
    aria-label={`Navigation — currently on ${current}`}
  >
    <span class="compact" aria-hidden="true">
      <span class="dot dot-pulse compact-dot"></span>
      <span class="tag compact-label">{current}</span>
      <span class="compact-hint" aria-hidden="true">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
          <path d="M6 9l6 6 6-6" />
        </svg>
      </span>
    </span>

    <nav class="nav" aria-label="Pages">
      {links.map((link, i) => (
        <a
          href={link.href}
          class:list={["nav-link", { "is-active": isActive(link.href) }]}
          style={`--i:${i}`}
          aria-current={isActive(link.href) ? "page" : undefined}
        >
          {link.label}
        </a>
      ))}

      <button
        id="theme-toggle"
        class="theme-toggle"
        style={`--i:${links.length}`}
        aria-label="Switch between light and dark"
      >
        <svg class="icon-sun" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <circle cx="12" cy="12" r="4.5"></circle>
          <path d="M12 1.5v2M12 20.5v2M3.6 3.6l1.4 1.4M19 19l1.4 1.4M1.5 12h2M20.5 12h2M3.6 20.4L5 19M19 5l1.4-1.4"></path>
        </svg>
        <svg class="icon-moon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
        </svg>
      </button>
    </nav>
  </div>

  <button class="search-btn" type="button" data-cmdk-open aria-label="Search this site (Control K)">
    <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <circle cx="11" cy="11" r="7"></circle>
      <path d="M20 20l-3.5-3.5"></path>
    </svg>
    <kbd class="key-hint">Ctrl K</kbd>
  </button>
</header>

<!-- ══════ Mobile island ══════ -->
<header id="m-island" class="m-island" data-open="false">
  <div class="m-bar">
    <a class="m-brand" href="/">
      <span class="dot compact-dot"></span>
      <span class="m-name">Eri</span>
      <span class="tag m-current">{current}</span>
    </a>

    <div class="m-actions">
      <button class="m-btn" type="button" data-cmdk-open aria-label="Search this site">
        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="11" cy="11" r="7"></circle>
          <path d="M20 20l-3.5-3.5"></path>
        </svg>
      </button>
      <button
        id="m-toggle"
        class="m-btn"
        type="button"
        aria-label="Open navigation"
        aria-expanded="false"
        aria-controls="m-menu"
      >
        <svg class="icon-menu" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true">
          <path d="M4 7h16M4 12h16M4 17h16" />
        </svg>
        <svg class="icon-close" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true">
          <path d="M18 6L6 18M6 6l12 12" />
        </svg>
      </button>
    </div>
  </div>

  <div id="m-menu" class="m-menu">
    <div class="m-menu-inner">
    <nav class="m-nav" aria-label="Pages">
      {links.map((link) => (
        <a
          href={link.href}
          class:list={["m-link", { "is-active": isActive(link.href) }]}
          aria-current={isActive(link.href) ? "page" : undefined}
        >
          {link.label}
        </a>
      ))}
    </nav>
    <button id="m-theme" class="m-theme" type="button" aria-label="Switch between light and dark">
      <svg class="icon-sun" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4.5"></circle>
          <path d="M12 1.5v2M12 20.5v2M3.6 3.6l1.4 1.4M19 19l1.4 1.4M1.5 12h2M20.5 12h2M3.6 20.4L5 19M19 5l1.4-1.4"></path>
        </svg>
        <svg class="icon-moon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
        </svg>
      <span class="tag">Theme</span>
    </button>
    </div>
  </div>
</header>

<div id="m-overlay" class="m-overlay" aria-hidden="true"></div>

<style>
  /* ═══════════════════════════════════════════════════════
     DESKTOP PILL
     ═══════════════════════════════════════════════════════ */
  .island {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 1000;
    display: flex;
    justify-content: center;
    align-items: flex-start;
    gap: var(--sp-1);
    padding-top: var(--sp-3);
    pointer-events: none;
  }

  .pill {
    pointer-events: auto;
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    height: var(--sp-5);
    width: 208px;
    padding: 0 var(--sp-3);
    background: var(--chrome-bg);
    color: var(--chrome-fg);
    border: 1px solid var(--chrome-line);
    border-radius: var(--r-pill);
    cursor: pointer;
    overflow: hidden;
    box-shadow: 0 8px 26px rgba(0, 0, 0, 0.24);
    transition: width 0.42s cubic-bezier(0.34, 1.32, 0.5, 1), background 0.35s ease;
  }

  .compact {
    display: flex;
    align-items: center;
    gap: var(--sp-1);
    transition: opacity 0.15s ease;
  }

  .compact-dot { background: var(--amber); }

  .compact-label { color: var(--chrome-fg); }

  .compact-hint {
    display: flex;
    color: var(--chrome-dim);
  }

  .nav {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 3px;
    padding: 0 10px;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 0.18s ease, visibility 0s 0.2s;
  }

  .nav-link {
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    padding: 0 var(--sp-2);
    font-family: var(--body);
    font-size: var(--fs-small);
    font-weight: 400;
    color: var(--chrome-fg);
    text-decoration: none;
    border-radius: var(--r-pill);
    white-space: nowrap;
    opacity: 0;
    transform: translateY(5px);
    transition: color 0.18s ease, background 0.18s ease, opacity 0.22s ease, transform 0.22s ease;
  }

  .nav-link:hover { background: rgba(244, 241, 232, 0.14); }

  .nav-link.is-active {
    background: var(--amber);
    color: var(--on-amber);
  }

  .theme-toggle {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    margin-left: 5px;
    padding: 0;
    background: rgba(244, 241, 232, 0.1);
    border: 1px solid var(--chrome-line);
    border-radius: 50%;
    color: var(--chrome-fg);
    cursor: pointer;
    opacity: 0;
    transform: translateY(5px);
    transition: background 0.18s ease, opacity 0.22s ease, transform 0.22s ease;
  }

  .theme-toggle:hover { background: rgba(244, 241, 232, 0.2); }

  .theme-toggle .icon-moon { display: none; }
  :global(html[data-theme="dark"]) .theme-toggle .icon-sun { display: none; }
  :global(html[data-theme="dark"]) .theme-toggle .icon-moon { display: block; }

  /* ── Pill open ── */
  .island[data-open="true"] .pill,
  .pill:hover {
    width: min(600px, calc(100vw - var(--sp-4)));
  }

  .island[data-open="true"] .compact,
  .pill:hover .compact { opacity: 0; }

  .island[data-open="true"] .nav,
  .pill:hover .nav {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transition: opacity 0.2s ease 0.1s, visibility 0s 0.1s;
  }

  .island[data-open="true"] .nav-link,
  .island[data-open="true"] .theme-toggle,
  .pill:hover .nav-link,
  .pill:hover .theme-toggle {
    opacity: 1;
    transform: none;
    transition-delay: calc(0.14s + var(--i, 0) * 0.035s);
  }

  @media (hover: none) {
    .pill:hover { width: 208px; }
    .pill:hover .compact { opacity: 1; }
    .pill:hover .nav { opacity: 0; visibility: hidden; pointer-events: none; }
  }


  /* Search sits beside the pill as part of the island, instead of a
     floating button that covered content in the corner. */
  .search-btn {
    pointer-events: auto;
    display: inline-flex;
    align-items: center;
    gap: var(--sp-1);
    height: var(--sp-5);
    padding: 0 var(--sp-3);
    background: var(--chrome-bg);
    color: var(--chrome-fg);
    border: 1px solid var(--chrome-line);
    border-radius: var(--r-pill);
    box-shadow: 0 8px 26px rgba(0, 0, 0, 0.24);
    cursor: pointer;
    transition: transform 0.18s ease;
  }

  .search-btn:hover { transform: translateY(-2px); }

  .key-hint {
    font-family: var(--mono);
    font-size: var(--fs-micro);
    color: var(--chrome-dim);
    padding: 3px 7px;
    border: 1px solid var(--chrome-line);
    border-radius: 6px;
  }

  .m-island,
  .m-overlay { display: none; }

  /* ═══════════════════════════════════════════════════════
     MOBILE — ≤899px
     ═══════════════════════════════════════════════════════ */
  @media (max-width: 899px) {
    .island { display: none; }

    .m-island {
      display: block;
      position: fixed;
      z-index: 1100;
      top: var(--sp-2);
      left: var(--sp-2);
      right: var(--sp-2);
      background: var(--chrome-bg);
      color: var(--chrome-fg);
      border: 1px solid var(--chrome-line);
      border-radius: 26px;
      box-shadow: 0 8px 26px rgba(0, 0, 0, 0.24);
      overflow: hidden;
    }

    .m-bar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      height: 52px;
      padding: 0 6px 0 var(--sp-3);
    }

    .m-brand {
      display: inline-flex;
      align-items: center;
      gap: var(--sp-1);
      min-height: 44px;
      color: inherit;
      text-decoration: none;
    }

    .m-name { font-family: var(--display); font-weight: 700; font-size: 1.15rem; }
    .m-current { color: var(--chrome-dim); }

    .m-actions { display: flex; gap: 4px; }

    .m-btn {
      display: grid;
      place-items: center;
      width: 44px;
      height: 44px;
      padding: 0;
      background: transparent;
      color: inherit;
      border: 0;
      border-radius: 50%;
      cursor: pointer;
    }

    .m-btn:hover { background: rgba(244, 241, 232, 0.12); }

    .m-btn .icon-close { display: none; }
    .m-island[data-open="true"] .m-btn .icon-menu { display: none; }
    .m-island[data-open="true"] .m-btn .icon-close { display: block; }

    /* The island grows downward to hold the menu. Grid rows animate
       between 0fr and 1fr, so the height never has to be hard-coded. */
    .m-menu {
      display: grid;
      grid-template-rows: 0fr;
      transition: grid-template-rows 0.32s cubic-bezier(0.34, 1.2, 0.5, 1);
    }

    .m-menu-inner { min-height: 0; overflow: hidden; }

    .m-island[data-open="true"] .m-menu { grid-template-rows: 1fr; }

    .m-nav {
      display: flex;
      flex-direction: column;
      padding: 0 var(--sp-1);
      visibility: hidden;
      transition: visibility 0s 0.32s;
    }

    .m-island[data-open="true"] .m-nav,
    .m-island[data-open="true"] .m-theme { visibility: visible; transition-delay: 0s; }

    .m-link {
      display: flex;
      align-items: center;
      min-height: 48px;
      padding: 0 var(--sp-2);
      border-radius: var(--r-md);
      font-size: var(--fs-lead);
      color: var(--chrome-fg);
      text-decoration: none;
    }

    .m-link:first-child { margin-top: var(--sp-1); border-top: 1px solid var(--chrome-line); border-radius: 0 0 var(--r-md) var(--r-md); }
    .m-link:hover { background: rgba(244, 241, 232, 0.1); }
    .m-link.is-active { color: var(--amber); }

    .m-theme {
      display: flex;
      align-items: center;
      gap: var(--sp-1);
      min-height: 48px;
      margin: 0 var(--sp-1) var(--sp-1);
      padding: 0 var(--sp-2);
      background: transparent;
      color: var(--chrome-dim);
      border: 0;
      border-top: 1px solid var(--chrome-line);
      cursor: pointer;
      visibility: hidden;
      transition: visibility 0s 0.32s;
    }

    .m-theme .icon-moon { display: none; }
    :global(html[data-theme="dark"]) .m-theme .icon-sun { display: none; }
    :global(html[data-theme="dark"]) .m-theme .icon-moon { display: block; }

    .m-overlay {
      display: block;
      position: fixed;
      inset: 0;
      z-index: 1050;
      background: rgba(23, 22, 15, 0.32);
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.25s ease;
    }

    .m-overlay[data-visible="true"] { opacity: 1; pointer-events: auto; }
  }
</style>

<script>
  (function () {
    const applyTheme = () => {
      const next = document.documentElement.getAttribute("data-theme") === "dark" ? "light" : "dark";
      document.documentElement.setAttribute("data-theme", next);
      localStorage.setItem("theme", next);
    };

    // ── Desktop pill ──
    const island = document.getElementById("island");
    const pill = document.getElementById("pill");
    if (island && pill) {
      const setOpen = (open: boolean) => {
        island.dataset.open = String(open);
        pill.setAttribute("aria-expanded", String(open));
      };

      pill.addEventListener("click", (e) => {
        const target = e.target as HTMLElement;
        if (target.closest("#theme-toggle")) return;
        if (target.closest(".nav-link")) { setOpen(false); return; }
        setOpen(island.dataset.open !== "true");
      });

      pill.addEventListener("keydown", (e) => {
        if (e.key === "Enter" || e.key === " ") {
          e.preventDefault();
          setOpen(island.dataset.open !== "true");
        }
      });

      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape") setOpen(false);
      });

      document.addEventListener("click", (e) => {
        if (!(e.target as HTMLElement).closest("#pill")) setOpen(false);
      });

      document.getElementById("theme-toggle")?.addEventListener("click", (e) => {
        e.stopPropagation();
        applyTheme();
      });
    }

    // ── Mobile island ──
    const mIsland = document.getElementById("m-island");
    const mToggle = document.getElementById("m-toggle");
    const mOverlay = document.getElementById("m-overlay");
    if (!mIsland || !mToggle || !mOverlay) return;

    const setMenu = (open: boolean) => {
      mIsland.dataset.open = String(open);
      mOverlay.dataset.visible = String(open);
      mToggle.setAttribute("aria-expanded", String(open));
      mToggle.setAttribute("aria-label", open ? "Close navigation" : "Open navigation");
    };

    mToggle.addEventListener("click", () => setMenu(mIsland.dataset.open !== "true"));
    mOverlay.addEventListener("click", () => setMenu(false));
    mIsland.querySelectorAll("[data-cmdk-open], .m-link").forEach((el) => {
      el.addEventListener("click", () => setMenu(false));
    });
    document.getElementById("m-theme")?.addEventListener("click", applyTheme);

    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && mIsland.dataset.open === "true") {
        setMenu(false);
        mToggle.focus();
      }
    });
  })();
</script>
