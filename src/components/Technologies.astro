---
// Languages Used — a light card holding language/tech badges in a grid.
const technologies = [
  { name: "TypeScript", icon: "typescript" },
  { name: "Python", icon: "python" },
  { name: "React", icon: "react" },
  { name: "Next.js", icon: "nextdotjs" },
  { name: "Nuxt.js", icon: "nuxtdotjs" },
  { name: "Flutter", icon: "flutter" },
  { name: "PostgreSQL", icon: "postgresql" },
  { name: "MongoDB", icon: "mongodb" },
  { name: "Docker", icon: "docker" },
  { name: "Git", icon: "git" },
  { name: "Figma", icon: "figma" },
  { name: "Supabase", icon: "supabase" },
];
---

<section id="languages" class="surface-card languages">
  <h2 class="card-label">Languages Used</h2>

  <div class="lang-grid">
    {technologies.map((t) => (
      <span class="lang-badge">
        <img
          src={`https://cdn.simpleicons.org/${t.icon}/1a1a1a`}
          alt=""
          width="16"
          height="16"
          loading="lazy"
          onerror="this.style.display='none'"
        />
        {t.name}
      </span>
    ))}
  </div>
</section>

<style>
  .languages {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .lang-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  .lang-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 0.9rem;
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--text);
    background: var(--bg-subtle);
    border: 1px solid var(--border);
    border-radius: 10px;
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.04);
    transition: transform 0.15s ease, box-shadow 0.15s ease, background 0.3s ease, border-color 0.3s ease;
  }

  .lang-badge:hover {
    transform: translateY(-2px);
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
  }

  html[data-theme="dark"] .lang-badge:hover {
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.3);
  }

  .lang-badge img {
    display: block;
    filter: invert(0);
    transition: filter 0.3s ease;
  }

  html[data-theme="dark"] .lang-badge img {
    filter: invert(1);
  }
</style>
