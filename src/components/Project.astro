---
import type { Project } from '../data/site';
import { statusLabel } from '../data/site';

interface Props {
  project: Project;
  expanded?: boolean;
  /** Kept in step with the surrounding page so the outline never skips a level. */
  level?: 2 | 3;
}

const { project: p, expanded = false, level = 3 } = Astro.props;
const Heading = `h${level}` as 'h2' | 'h3';
---

<article class:list={["project", { "has-image": p.image }]}>
  <div class="text">
    <Heading class="h2 name">{p.name}</Heading>
    <p class="small faint meta">{p.kind}, {statusLabel[p.status].toLowerCase()}</p>

    <p class="summary">{p.summary}</p>
    {expanded && <p class="muted detail">{p.detail}</p>}

    {p.stack.length > 0 && (
      <p class="small muted stack">
        <span class="sr-only">Built with </span>{p.stack.join(", ")}
      </p>
    )}

    {p.collaborators && p.collaborators.length > 0 && (
      <p class="small muted collaborators">
        Built with{" "}
        {p.collaborators.map((c, i, arr) => (
          <>
            {i > 0 && (i === arr.length - 1 ? " and " : ", ")}
            {c.url ? (
              <a class="link" href={c.url} target="_blank" rel="noopener noreferrer">{c.name}</a>
            ) : (
              c.name
            )}
          </>
        ))}
      </p>
    )}

    {(p.repo || p.live) && (
      <p class="links">
        {p.live && (
          <a class="link" href={p.live} target="_blank" rel="noopener noreferrer">
            Open {p.name}
          </a>
        )}
        {p.repo && (
          <a class="link" href={p.repo} target="_blank" rel="noopener noreferrer">
            Read the code<span class="sr-only"> for {p.name}</span>
          </a>
        )}
      </p>
    )}
  </div>

  {p.image && (
    <figure class="media">
      <img src={p.image.src} alt={p.image.alt} loading="lazy" decoding="async" />
    </figure>
  )}
</article>

<style>
  .project {
    display: grid;
    gap: 1.5rem 3rem;
    padding: 2.5rem 0;
  }

  .project.has-image { grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); align-items: start; }

  .text { display: flex; flex-direction: column; gap: 0.75rem; }

  .meta { margin: 0; }

  .summary {
    margin: 0.5rem 0 0;
    font-size: var(--fs-lead);
    line-height: 1.45;
    max-width: 34em;
  }

  .detail { margin: 0; max-width: 38em; }

  .stack { margin: 0.5rem 0 0; }

  .collaborators { margin: 0; }

  .links { display: flex; gap: 1.5rem; margin: 0; font-weight: 500; }

  .media {
    margin: 0;
    border-radius: var(--r-lg);
    overflow: hidden;
    border: 1px solid var(--line);
    background: var(--surface);
  }

  .media img { width: 100%; height: auto; }

  @media (max-width: 859px) {
    .project.has-image { grid-template-columns: 1fr; }
    .media { order: -1; }
  }
</style>
