---
// The signature element: the mark framed the way CourtVision frames a player —
// corner brackets, an ID tag, and a live clock in his actual timezone.
//
// It is a signature, not an argument, so it is sized to the mark and no
// larger. Stretching it to fill a full-height column letterboxed a square
// image inside a tall box and took room away from the claim next to it.
interface Props {
  tag?: string;
}

const { tag = "eri · lagos" } = Astro.props;
---

<figure class="portrait card card-amber">
  <div class="frame">
    <img src="/brand.jpg" alt="Fawehinmi Erioluwa" width="538" height="570" />

    <span class="bracket br-tl"></span>
    <span class="bracket br-tr"></span>
    <span class="bracket br-bl"></span>
    <span class="bracket br-br"></span>
  </div>

  <figcaption class="meta">
    <span class="tag">{tag}</span>
    <span class="tag clock">
      <span class="dot dot-pulse"></span>
      <span id="lagos-time">--:--</span> WAT
    </span>
  </figcaption>
</figure>

<style>
  .portrait {
    /* Content-sized, and centred against whatever tall thing sits beside it. */
    align-self: center;
    margin: 0;
    padding: var(--sp-2);
    gap: var(--sp-2);
    max-width: 24rem;
  }

  .frame {
    position: relative;
    aspect-ratio: 538 / 570;
    border-radius: var(--r-md);
    overflow: hidden;
    /* The mark is drawn in black on white, so its mat stays white in both
       themes rather than following the surface token. */
    background: #fff;
  }

  .frame img {
    width: 100%;
    height: 100%;
    padding: var(--sp-3);
    object-fit: contain;
  }

  /* Detection brackets — they draw themselves in once, then hold. */
  .bracket {
    position: absolute;
    width: 26px;
    height: 26px;
    border: 3px solid var(--on-amber);
    opacity: 0;
    animation: lock 0.5s ease forwards;
  }

  .br-tl { top: 12px; left: 12px; border-right: 0; border-bottom: 0; border-radius: 8px 0 0 0; animation-delay: 0.15s; }
  .br-tr { top: 12px; right: 12px; border-left: 0; border-bottom: 0; border-radius: 0 8px 0 0; animation-delay: 0.24s; }
  .br-bl { bottom: 12px; left: 12px; border-right: 0; border-top: 0; border-radius: 0 0 0 8px; animation-delay: 0.33s; }
  .br-br { bottom: 12px; right: 12px; border-left: 0; border-top: 0; border-radius: 0 0 8px 0; animation-delay: 0.42s; }

  @keyframes lock {
    from { opacity: 0; transform: scale(1.35); }
    to { opacity: 1; transform: none; }
  }

  /* The readout sits under the frame rather than on top of it — floating it
     over a contained image meant it covered the mark at every useful size. */
  .meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-2);
    flex-wrap: wrap;
    padding: 0 var(--sp-1) 2px;
  }

  .clock { gap: 6px; white-space: nowrap; }
  .clock .dot { background: var(--live-ink); }

  @media (max-width: 899px) {
    .portrait { max-width: 17rem; align-self: flex-start; }
  }

  @media (prefers-reduced-motion: reduce) {
    .bracket { opacity: 1; }
  }
</style>

<script>
  (function () {
    const el = document.getElementById("lagos-time");
    if (!el) return;

    const fmt = new Intl.DateTimeFormat("en-GB", {
      timeZone: "Africa/Lagos",
      hour: "2-digit",
      minute: "2-digit",
    });

    const tick = () => { el.textContent = fmt.format(new Date()); };
    tick();
    setInterval(tick, 20000);
  })();
</script>
