---
/** An analog clock set to Lagos. Layout's script turns the hands. */
---

<div class="clock" data-clock="analog" role="img" aria-label="Clock showing the time in Lagos">
  {Array.from({ length: 12 }, (_, i) => <i class:list={["tick", { major: i % 3 === 0 }]} style={`--t:${i * 30}`} />)}
  <span class="hand hour" />
  <span class="hand minute" />
  <span class="hand second" />
  <span class="pin" />
</div>

<style>
  .clock {
    --h: 0;
    --m: 0;
    --s: 0;
    position: relative;
    width: 100%;
    max-width: 9rem;
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--paper);
    border: 1px solid var(--line);
    box-shadow: inset 0 2px 8px var(--shade);
  }

  .tick {
    position: absolute;
    left: calc(50% - 1px);
    top: 6%;
    width: 2px;
    height: 6%;
    border-radius: 2px;
    background: var(--line-strong);
    transform-origin: 50% 733%;
    transform: rotate(calc(var(--t) * 1deg));
  }

  .tick.major { background: var(--ink-2); height: 9%; transform-origin: 50% 489%; }

  .hand {
    position: absolute;
    left: 50%;
    bottom: 50%;
    border-radius: 4px;
    transform-origin: 50% 100%;
    background: var(--ink);
  }

  .hour { width: 5px; height: 26%; margin-left: -2.5px; transform: rotate(calc(var(--h) * 1deg)); }
  .minute { width: 3px; height: 36%; margin-left: -1.5px; transform: rotate(calc(var(--m) * 1deg)); }
  .second { width: 1.5px; height: 40%; margin-left: -0.75px; background: var(--yellow); transform: rotate(calc(var(--s) * 1deg)); }

  .pin {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 9px;
    height: 9px;
    margin: -4.5px 0 0 -4.5px;
    border-radius: 50%;
    background: var(--ink);
    border: 2px solid var(--yellow);
  }
</style>
